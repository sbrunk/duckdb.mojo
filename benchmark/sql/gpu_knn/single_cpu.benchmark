# name: benchmark/micro/gpu_knn/single_cpu.benchmark
# group: [gpu_knn]

name single_cpu
group micro
subgroup gpu_knn

load
SET lambda_syntax='ENABLE_SINGLE_ARROW';
CREATE TABLE emb AS SELECT i id, apply(range(0,128),x->random()::FLOAT)::FLOAT[128] v FROM range(200000) u(i);
CREATE TABLE queries AS SELECT i qid, apply(range(0,128),x->random()::FLOAT)::FLOAT[128] qv FROM range(1) u(i);

run
SELECT count(*) FROM mojo_knn('emb','v','queries','qv',10,metric:='cosine');
