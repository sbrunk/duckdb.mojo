# Runner-only convenience: let DuckDB's benchmark_runner LOAD a local extension at init.
#
# benchmark_runner has no --load-extension flag and allow_unsigned_extensions is a
# startup-only DBConfig option, so this hook to interpreted_benchmark.cpp allows
# unsigned extensions and LOADs $DUCKDB_BENCH_EXTENSION (if set) once per benchmark
# state, making the extension's catalog overrides apply to every benchmark.
# bench_runner.py sets that variable per engine (stock/cpu/gpu), so one staged
# .benchmark file runs unchanged under each engine.
#
# A patch-free route exists since 2.0.1: a `require <extension>` line in the
# .benchmark file plus $DUCKDB_BENCHMARK_EXTENSION_DIRECTORY pointing at the dir
# holding `<extension>.duckdb_extension` (the variable also allows unsigned
# extensions). The name has to be in the file and must match the built file (a CPP
# extension's entrypoint symbol comes from its file name), so every engine needs its
# own staged copy of the group and the stock baseline its own variant.
#
# Against the DuckDB checkout pinned in third_party/duckdb. Regenerate this diff
# when the pin moves.
diff --git a/benchmark/interpreted_benchmark.cpp b/benchmark/interpreted_benchmark.cpp
index 8ca2827aeef..9b1c1db60d6 100644
--- a/benchmark/interpreted_benchmark.cpp
+++ b/benchmark/interpreted_benchmark.cpp
@@ -78,6 +78,8 @@ struct InterpretedBenchmarkState : public BenchmarkState {
 		if (extension_directory && extension_directory[0]) {
 			result->SetOptionByName("allow_unsigned_extensions", true);
 		}
+		// Runner-only: the extension loaded below is unsigned.
+		result->SetOptionByName("allow_unsigned_extensions", true);
 		return result;
 	}
 };
@@ -573,6 +575,16 @@ unique_ptr<InterpretedBenchmarkState> InterpretedBenchmark::OpenState(const stri
 		state = make_uniq<InterpretedBenchmarkState>(full_db_path, storage_version);
 	}
 	LoadExtensions(*state, false);
+
+	// Runner-only: LOAD $DUCKDB_BENCH_EXTENSION once per benchmark, so its
+	// catalog overrides apply to every benchmark.
+	const char *bench_ext = std::getenv("DUCKDB_BENCH_EXTENSION");
+	if (bench_ext && bench_ext[0]) {
+		auto ext_result = state->con.Query("LOAD '" + string(bench_ext) + "'");
+		if (ext_result->HasError()) {
+			throw InvalidInputException("DUCKDB_BENCH_EXTENSION load failed: " + ext_result->GetError());
+		}
+	}
 	if (queries.find("init") != queries.end()) {
 		auto result = state->con.Query(queries["init"]);
 		while (result) {
