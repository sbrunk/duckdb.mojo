    def duckdb_v2_value_get_int[out__origin: MutOrigin, err_origin: MutOrigin](
        self,
        value: duckdb_v2_value_handle,
        out_: Pointer[Int32, out__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
