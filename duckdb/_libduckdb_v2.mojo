#! How `duckdb_v2_file_system_open` opens a file. These are not a bitmask -- apply
#! them one at a time with `duckdb_v2_file_open_options_set_flag`, calling it once
#! per behaviour you want, e.g. `FILE_FLAG_WRITE` then `FILE_FLAG_CREATE` to
#! write to a file and create it when it does not exist.
comptime DUCKDB_V2_FILE_FLAG = Int32
# Not a flag. The zero value, so that an uninitialized variable does not name a behaviour; applying it is an error.
comptime DUCKDB_V2_FILE_FLAG_INVALID: DUCKDB_V2_FILE_FLAG = 0
# Open the file with "read" capabilities.
comptime DUCKDB_V2_FILE_FLAG_READ: DUCKDB_V2_FILE_FLAG = 1
# Open the file with "write" capabilities.
comptime DUCKDB_V2_FILE_FLAG_WRITE: DUCKDB_V2_FILE_FLAG = 2
# Create the file if it does not exist, and open it as it is if it does.
comptime DUCKDB_V2_FILE_FLAG_CREATE: DUCKDB_V2_FILE_FLAG = 3
# Create the file if it does not exist, and truncate it to empty if it does. To fail instead of truncating, combine `FILE_FLAG_CREATE` with `FILE_FLAG_EXCLUSIVE_CREATE`.
comptime DUCKDB_V2_FILE_FLAG_CREATE_NEW: DUCKDB_V2_FILE_FLAG = 4
# Open the file in "append" mode.
comptime DUCKDB_V2_FILE_FLAG_APPEND: DUCKDB_V2_FILE_FLAG = 5
# Fail if the file already exists. A modifier on `FILE_FLAG_CREATE`, and meaningless without it.
comptime DUCKDB_V2_FILE_FLAG_EXCLUSIVE_CREATE: DUCKDB_V2_FILE_FLAG = 6
# The file will be read and written at explicit offsets from several threads at once. Pass it whenever
# `duckdb_v2_file_read_at` or `duckdb_v2_file_write_at` are used concurrently -- a file system that would otherwise
# assume sequential access, by caching, buffering, or keeping a single cursor, needs to know not to.
comptime DUCKDB_V2_FILE_FLAG_PARALLEL_ACCESS: DUCKDB_V2_FILE_FLAG = 7
# Read the file through DuckDB's external file cache, which keeps the bytes that were read in memory, so
# that later reads of the same file - also by later queries - do not have to read them again. Whether a
# local file is cached is decided by the `cache_local_files` setting. Only meaningful for reading.
comptime DUCKDB_V2_FILE_FLAG_EXTERNAL_FILE_CACHE: DUCKDB_V2_FILE_FLAG = 8

