            conn: The connection to register on.
            function_: The table function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_register_table_function(conn, function_, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_table_function[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        function_: duckdb_v2_table_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the table function, making it available for use in SQL queries.

        The function is registered on the loading extension's database and attributed to the extension. Use this from the
        extension's load callback. Registration requires a name, a bind callback and an exec callback, and rejects a
        signature that declares a return type, since a table function declares the columns it returns from its bind
        callback. The table function must have been created through a factory of the same database. The caller still owns
        the handle after registration and must destroy it with `duckdb_v2_table_function_destroy`, which does not affect the
        registered function.

        Args:
            extension: The loading extension.
            function_: The table function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_table_function(extension, function_, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_destroy[function__origin: MutOrigin](
        self,
        function_: Pointer[duckdb_v2_table_function_handle, function__origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the table function, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to
        prevent double-destruction. Destroying the handle after registration does not affect the registered
        function.

        Args:
            function_: The function to destroy.
        """
        return self._duckdb_v2_table_function_destroy(function_.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_claim_batch_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_claim_batch_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional claim batch callback of the table function.

        With a claim batch callback, a scanning thread works through the scan one batch at a time: the callback
        claims the next batch of work (e.g. the next block of a file) for the thread's local state, typically from
        the shared global state, and the exec callback then produces the rows of that batch only, leaving the output
        chunk empty once the batch is exhausted. A batch is claimed before the exec callback first runs on a thread,
        and again whenever the exec callback leaves the output chunk empty; the scan ends for a thread once the claim
        batch callback does not claim a batch.

        Telling the batches apart lets a caller that scans several batches in parallel put their rows back in the order of
        the batches, e.g. a multi-file function registered with `duckdb_v2_connection_register_multi_file_function` or
        `duckdb_v2_extension_register_multi_file_function` claims the batches of the function itself, so that the rows of a file
        keep their order also when several threads scan it.

        The callback runs while the work of the scan is handed out to the threads, possibly while every other
        scanning thread waits for it. It should therefore only claim the work - e.g. reserve the number of the next
        block - and leave reading it to the exec callback.

        Args:
            function_: The function to set the claim batch callback of.
            callback: The claim batch callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_claim_batch_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_claim_batch_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_claim_batch_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set on the table function via `duckdb_v2_table_function_set_user_data`.

        Args:
            info: The claim batch info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_claim_batch_get_user_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_claim_batch_get_bind_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_claim_batch_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the bind data set by the function's bind callback.

        Args:
            info: The claim batch info handle.
            data: Receives the bind data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_claim_batch_get_bind_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_claim_batch_get_global_state[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_claim_batch_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the global state set by the function's global init callback.

        Shared with every other thread scanning the function; access to it must be synchronized by the function.

        Args:
            info: The claim batch info handle.
            data: Receives the global state pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_claim_batch_get_global_state(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_claim_batch_get_local_state[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_claim_batch_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the local state set by the function's local init callback, for the thread claiming a batch.

        Args:
            info: The claim batch info handle.
            data: Receives the local state pointer for the claiming thread, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_claim_batch_get_local_state(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_claim_batch_set_claimed[err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_claim_batch_info_handle,
        claimed: Bool,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports whether the callback claimed a batch for the thread.

        A callback that returns without calling this claimed nothing, which ends the scan for the thread.

        Args:
            info: The claim batch info handle.
            claimed: Whether a batch was claimed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_claim_batch_set_claimed(info, claimed, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_get_bind_info_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_get_bind_info_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional "get bind info" callback of the table function.

        The engine invokes the callback with the bind data of a bound call when it needs to know more about the call than
        its columns. E.g. a multi-file function registered with `duckdb_v2_connection_register_multi_file_function` or
        `duckdb_v2_extension_register_multi_file_function` asks the function it wraps for every file it binds: it maps the
        columns of the files onto the columns of its scan by the identifiers the callback reports, and exposes the options
        it reports as the metadata of the reader of the file. The callback may be invoked more than once for the same bind
        data, so it should only report what the bind already determined.

        Args:
            function_: The function to set the callback of.
            callback: The "get bind info" callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_get_bind_info_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_get_bind_info_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_get_bind_info_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set via `duckdb_v2_table_function_set_user_data`.

        Args:
            info: The get bind info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_get_bind_info_get_user_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_get_bind_info_get_bind_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_get_bind_info_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the bind data the function's bind callback set for the bound call being described.

        Args:
            info: The get bind info handle.
            data: Receives the bind data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_get_bind_info_get_bind_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_get_bind_info_set_column_identifier[child_path_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_get_bind_info_info_handle,
        column_index: idx_t,
        child_path: Pointer[idx_t, child_path_origin],
        child_path_length: idx_t,
        identifier: duckdb_v2_value_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Attaches an identifier to a result column of the bound call, or to a field nested inside one.

        A multi-file reader can then map the columns of every file onto the columns of its scan by identifier rather
        than by name - e.g. by the field ids of a file format that carries them, so that renamed columns and fields are
        still found. An identifier is an INTEGER field id or a VARCHAR name.

        The nested field is addressed by a path of child indexes, starting at the result column at `column_index`: a
        STRUCT field by its index, the elements of a LIST or ARRAY by `0`, the keys of a MAP by `0` and its values by
        `1`, and a UNION member by its index. An empty path addresses the result column itself. Setting an identifier
        again for the same column or field replaces it. Fails with `ERROR_INPUT_INVALID` when the column index is out
        of range, or the path does not address a nested field of the column's type.

        Args:
            info: The get bind info handle.
            column_index: The index of the result column, in the order the bind callback declared the columns.
            child_path: The path of child indexes addressing the nested field, or null for the column itself.
            child_path_length: The number of entries in the path, 0 for the column itself.
            identifier: The identifier, an INTEGER or VARCHAR value. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_get_bind_info_set_column_identifier(info, column_index, child_path.as_unsafe_any_origin(), child_path_length, identifier, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_get_bind_info_set_option[key_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_table_function_get_bind_info_info_handle,
        key: Pointer[duckdb_v2_str, key_origin],
        value: duckdb_v2_value_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets an option describing the bound call: a key-value fact about what the call reads, e.g. a property of the
        file it reads. Setting a key again replaces its value.

        A multi-file function registered with `duckdb_v2_connection_register_multi_file_function` or
        `duckdb_v2_extension_register_multi_file_function` exposes the options of the function it wraps as the metadata of the
        reader of each file, e.g. to a custom multi-file reader of another extension.

        Args:
            info: The get bind info handle.
            key: The key of the option. Borrowed and copied.
            value: The value of the option. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_get_bind_info_set_option(info, key.as_unsafe_any_origin(), value, err.as_unsafe_any_origin())

    def duckdb_v2_multi_file_function_create[function__origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        function_: Pointer[duckdb_v2_multi_file_function_handle, function__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new multi-file function through a factory.

        The function starts out empty: give it a name with `duckdb_v2_multi_file_function_set_name` and the single-file function
        it wraps with `duckdb_v2_multi_file_function_set_single_file_function`, then make it available with
        `duckdb_v2_connection_register_multi_file_function` or `duckdb_v2_extension_register_multi_file_function`. The caller owns the
        returned handle and must destroy it with `duckdb_v2_multi_file_function_destroy`, also after registration.

        The multi-file function can only be registered on the database the factory belongs to.

        Args:
            factory: The factory to create the multi-file function through.
            function_: On success, receives the newly created multi-file function. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_multi_file_function_create(factory, function_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_multi_file_function_set_name[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_multi_file_function_handle,
        name: Pointer[duckdb_v2_str, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the multi-file function, as SQL will call it.

        The name is borrowed and copied. Calling this again replaces the previous name. A name must be set before
        registration.

        Args:
            function_: The function to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_multi_file_function_set_name(function_, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_multi_file_function_set_single_file_function[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_multi_file_function_handle,
        name: Pointer[duckdb_v2_str, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the table function that reads a single file, which the multi-file function wraps.

        The single-file function must be registered before the multi-file function is, and must take the file to read as
        its only positional parameter, of type ANY. It is bound once for every file that is read, and receives the file
        the way a multi-file function takes one: as the VARCHAR path of the file when there is nothing more to know about
        it, and otherwise as a STRUCT holding the path in its `filename` field and the options to open the file with in
        its other fields - e.g. the size of the file, as a file system reported it while globbing, or the options a caller
        passed along with the file (`read_x([{'filename': 'f.x', 'file_size': 42}])`). Opening the file with those
        options, set with `duckdb_v2_file_open_options_set_value`, lets the file system skip work it would otherwise repeat,
        such as asking a remote store for the size of the file. A single-file function that takes a VARCHAR parameter
        instead is still accepted, and only receives the path. Every named parameter the single-file function declares is
        also a named parameter of the multi-file function, forwarded to it as given. Everything that involves several
        files - globbing, lists of files, hive partitioning, the `filename` column, `union_by_name` and the like - is
        provided by the multi-file function on top of it. The name is borrowed and copied. A single-file function must be
        set before registration.

        Args:
            function_: The function to set the single-file function of.
            name: The name of the registered single-file table function. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_multi_file_function_set_single_file_function(function_, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_multi_file_function_set_reader_type[reader_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_multi_file_function_handle,
        reader_type: Pointer[duckdb_v2_str, reader_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets how the files the function reads are referred to in messages, e.g. "Avro" or "JSON".

        Optional: without it, the files are referred to by the name of the multi-file function. The name is borrowed
        and copied.

        Args:
            function_: The function to set the reader type of.
            reader_type: The reader type. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_multi_file_function_set_reader_type(function_, reader_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_multi_file_function_set_file_extension[extension_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_multi_file_function_handle,
        extension: Pointer[duckdb_v2_str, extension_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the file extension of the files the function reads, e.g. "avro".

        Optional. With a file extension, a path that names a directory rather than a file reads the files with that
        extension inside it. Without one, the paths passed to the function must match at least one file. The
        extension is given without a leading dot, and is borrowed and copied.

        Args:
            function_: The function to set the file extension of.
            extension: The file extension, without a leading dot. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
