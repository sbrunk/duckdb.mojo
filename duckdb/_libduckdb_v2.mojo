    def duckdb_v2_value_create_decimal[in_value_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        in_value: Pointer[duckdb_v2_hugeint_t, in_value_origin],
        width: UInt8,
        scale: UInt8,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a DECIMAL value from its backing integer.

        The value is scaled by 10^scale, so (18500, 18, 3) is 18.500. width is
        the total digit count and must be 1..38; scale is the number of digits
        after the point and must not exceed width. Violating either returns
        ERROR_INPUT_INVALID, as does a value too wide for the storage tier the
        width selects. The value itself is not range-checked against the width;
        value_cast is the validating path.

        Args:
            factory: The factory to create with.
            in_value: The backing integer, scaled by 10^scale.
            width: Total digit count, 1..38.
            scale: Digits after the decimal point; must not exceed width.
            out_value: Receives the new DECIMAL value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_decimal(factory, in_value.as_unsafe_any_origin(), width, scale, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_create_uuid[in_value_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        in_value: Pointer[duckdb_v2_hugeint_t, in_value_origin],
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a UUID value from its internal 128-bit form.

        The payload is the storage form a vector element holds, not the canonical
        byte order: the high bit is flipped so the integer sorts. To build one
        from canonical text, cast a VARCHAR with value_cast instead, which is
        also how a UUID renders back.

        Args:
            factory: The factory to create with.
            in_value: The internal 128-bit storage form.
            out_value: Receives the new UUID value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_uuid(factory, in_value.as_unsafe_any_origin(), out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_create_bit[in_value_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        in_value: Pointer[duckdb_v2_str, in_value_origin],
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a BIT value from its wire bytes.

        The wire form is a mandatory padding-header byte — the count of leading
        bits in the first data byte that are not part of the bit string —
        followed by the data bytes, so the input must be at least 1 byte. These
        are the same bytes value_get_blob reports back.

        Args:
            factory: The factory to create with.
            in_value: The wire bytes, a padding header byte followed by data. Must be at least 1 byte.
            out_value: Receives the new BIT value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_bit(factory, in_value.as_unsafe_any_origin(), out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_create_bignum[in_value_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        in_value: Pointer[duckdb_v2_str, in_value_origin],
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a BIGNUM value from its storage bytes.

        The bytes are opaque storage, as produced by bignum_encode from a
        magnitude and a sign flag; a negative is stored bit-inverted behind a
        header, so these are not the magnitude bytes. The header plus at least
        one magnitude byte means the input must exceed 3 bytes. These are the
        same bytes value_get_blob reports back, for bignum_decode to translate.

        Args:
            factory: The factory to create with.
            in_value: The opaque storage bytes from bignum_encode. Must exceed 3 bytes.
            out_value: Receives the new BIGNUM value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_bignum(factory, in_value.as_unsafe_any_origin(), out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_create_list[children_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        child_type: duckdb_v2_logical_type_handle,
        children: Pointer[duckdb_v2_value_handle, children_origin],
        child_count: idx_t,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a LIST value from its elements.

        The child type is the common type of the elements, resolved by the same
        rule a SQL list literal follows, and every element is cast to it; a set
        with no common type surfaces the cast error. Pass child_type to name the
        type instead, which is also how an empty list is built: with child_type
        NULL, an empty element array has no type to resolve and returns
        ERROR_INPUT_INVALID.

        The elements are borrowed and copied in, and a NULL element becomes a
        typed NULL. The type is rebuilt from its child, so an alias on the outer
        LIST type is not preserved; value_cast is the alias-preserving path.

        Args:
            factory: The factory to create with.
            child_type: Optional. The element type. Pass NULL to resolve it from the elements.
            children: An array of child_count elements. Borrowed (copied in). Pass NULL when child_count is 0.
            child_count: The number of elements.
            out_value: Receives the new composite value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_list(factory, child_type, children.as_unsafe_any_origin(), child_count, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_create_array[children_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        child_type: duckdb_v2_logical_type_handle,
        children: Pointer[duckdb_v2_value_handle, children_origin],
        child_count: idx_t,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates an ARRAY value from its elements, sized by their count.

        The child type is resolved exactly as for value_create_list, and
        child_type names it explicitly the same way. The minimum array size is 1,
        so an empty element array returns ERROR_INPUT_INVALID whether or not
        child_type is given.

        The elements are borrowed and copied in, and a NULL element becomes a
        typed NULL.

        Args:
            factory: The factory to create with.
            child_type: Optional. The element type. Pass NULL to resolve it from the elements.
            children: An array of child_count elements. Borrowed (copied in). Pass NULL when child_count is 0.
            child_count: The number of elements.
            out_value: Receives the new composite value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_array(factory, child_type, children.as_unsafe_any_origin(), child_count, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_create_struct[names_origin: ImmOrigin, children_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        names: Pointer[duckdb_v2_identifier_t, names_origin],
        children: Pointer[duckdb_v2_value_handle, children_origin],
        field_count: idx_t,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a STRUCT value from named fields, in order.

        Each field keeps its own child's type, so there is nothing to resolve
        across them; names and children are parallel arrays of field_count
        entries. An empty field list builds the empty struct, which is a real
        type.

        The names and children are borrowed and copied in, and a NULL child
        becomes a typed NULL. Duplicate field names are rejected.

        Args:
            factory: The factory to create with.
            names: An array of field_count field names. Pass NULL when field_count is 0.
            children: An array of field_count field values. Borrowed (copied in). Pass NULL when field_count is 0.
            field_count: The number of fields.
            out_value: Receives the new composite value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_struct(factory, names.as_unsafe_any_origin(), children.as_unsafe_any_origin(), field_count, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_create_tuple[children_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        children: Pointer[duckdb_v2_value_handle, children_origin],
        field_count: idx_t,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a TUPLE value from positional fields.

        TUPLE is the unnamed struct: the same positional children as
        value_create_struct, under a distinct type id and with no names. Each
        field keeps its own child's type. An empty field list builds the empty
        tuple, which is a real type.

        The children are borrowed and copied in, and a NULL child becomes a typed
        NULL.

        Args:
            factory: The factory to create with.
            children: An array of field_count field values. Borrowed (copied in). Pass NULL when field_count is 0.
            field_count: The number of fields.
            out_value: Receives the new composite value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_tuple(factory, children.as_unsafe_any_origin(), field_count, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_create_map[keys_origin: ImmOrigin, values_origin: ImmOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        key_type: duckdb_v2_logical_type_handle,
        value_type: duckdb_v2_logical_type_handle,
        keys: Pointer[duckdb_v2_value_handle, keys_origin],
        values: Pointer[duckdb_v2_value_handle, values_origin],
        entry_count: idx_t,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a MAP value from parallel key and value arrays.

        The key and value types are the common types of the keys and of the
        values, resolved as for value_create_list, and every entry is cast to
        them. Pass key_type and value_type to name them instead, which is also
        how an empty map is built: with both NULL, empty key and value arrays
        have no types to resolve and return ERROR_INPUT_INVALID.

        Keys and values are borrowed and copied in, and the two arrays must be
        the same length. Keys must be non-NULL and unique; both are enforced.

        Args:
            factory: The factory to create with.
            key_type: Optional. The key type. Pass NULL to resolve it from the keys.
            value_type: Optional. The value type. Pass NULL to resolve it from the values.
            keys: An array of entry_count keys. Borrowed (copied in). Pass NULL when entry_count is 0.
            values: An array of entry_count values, parallel to keys. Borrowed (copied in). Pass NULL when entry_count is 0.
            entry_count: The number of entries.
            out_value: Receives the new composite value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_create_map(factory, key_type, value_type, keys.as_unsafe_any_origin(), values.as_unsafe_any_origin(), entry_count, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_get_child_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        value: duckdb_v2_value_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of child values of a value.

        Per type kind: the element count for LIST and ARRAY; the field count for
        STRUCT and TUPLE; twice the entry count for MAP, whose children alternate
        key, value; and 2 for UNION, the tag plus the active member. Everything
        else reports 0, NULL values of any nested type included.

        Args:
            value: The value to read.
            out_count: Receives the number of children.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_get_child_count(value, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_get_child[out_child_origin: MutOrigin, err_origin: MutOrigin](
        self,
        value: duckdb_v2_value_handle,
        index: idx_t,
        out_child: Pointer[duckdb_v2_value_handle, out_child_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns one child of a composite value as an owned copy.

        LIST and ARRAY children are the elements. STRUCT and TUPLE children are
        the fields in declared order, and a STRUCT's field names come from its
        type, via logical_type_get_param. MAP children alternate key, value,
        symmetric with value_create_map. UNION children are [0] the tag, as a
        UTINYINT value, and [1] the active member, because a union value holds
        only that one member.

        Note the divergence from vector_get_child, which descends structurally
        and so exposes [0] = tag and [1..N] = ALL members. Code written to
        descend generically over both must account for that difference.

        An out-of-range index returns ERROR_INPUT_INVALID, as does any index on a
        non-composite or NULL value. The returned value is caller-owned; destroy
        it via value_destroy.

        Args:
            value: The value to read.
            index: The child index, in [0, child_count).
            out_child: Receives the owned child value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_get_child(value, index, out_child.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_cast[out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        value: duckdb_v2_value_handle,
        target_type: duckdb_v2_logical_type_handle,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Casts a value to a target type, using a factory.

        The conversion is the SQL-faithful, non-strict one, registered custom
        casts included, and a cast failure surfaces from the call. Together with
        a VARCHAR built through value_create_varchar, this constructs any value from text, extension values
        included; casting a member value to a union type, or a VARCHAR to an enum
        type, is the sanctioned way to build UNION and ENUM values.

        A connection's or callback's factory casts with that client's cast
        functions and settings (e.g. TimeZone). An instance's factory supports
        only the built-in casts, with default settings.

        The input value and target type are borrowed. The returned value is
        caller-owned; destroy it via value_destroy.

        Args:
            factory: The factory supplying the cast functions.
            value: The borrowed value to cast.
            target_type: The borrowed target logical type.
            out_value: Receives the owned cast result.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_cast(factory, value, target_type, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_is_null[out_is_null_origin: MutOrigin, err_origin: MutOrigin](
        self,
        value: duckdb_v2_value_handle,
        out_is_null: Pointer[Bool, out_is_null_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns whether the value is NULL.

        Args:
            value: The value to read.
            out_is_null: Receives true if the value is NULL, false otherwise.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_is_null(value, out_is_null.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_get_logical_type[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        value: duckdb_v2_value_handle,
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the logical type of the value.

        The returned logical type is caller-owned; destroy it via
        logical_type_destroy.

        Args:
            value: The value to read.
            out_type: Receives the owned logical type.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_get_logical_type(value, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_value_to_string[out_string_origin: MutOrigin, out_length_origin: MutOrigin, err_origin: MutOrigin](
        self,
        value: duckdb_v2_value_handle,
        out_string: Pointer[c_char, out_string_origin],
        out_capacity: idx_t,
        out_length: Pointer[idx_t, out_length_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Renders the value as a human-readable string. Diagnostic only.

        Writes into a caller-supplied buffer, so nothing is allocated on the
        caller's behalf and nothing has to be freed.

        Pass out_string = NULL to size the buffer without rendering into it:
        out_length then receives the length, and out_capacity is ignored. With
        out_string != NULL, out_capacity must be at least out_length + 1, or the
        call returns ERROR_INPUT_OBJECT_SIZE with out_length set to the required
        length and out_string left untouched.

        out_length never counts the terminator, but a successful write always
        appends one, so the buffer is usable as a C string.

        Args:
            value: The value to read.
            out_string: Caller-owned buffer receiving the text plus a null terminator, or NULL to only report the required length in out_length.
            out_capacity: Bytes available in out_string, terminator included. Ignored when out_string is NULL.
            out_length: Receives the text length excluding the null terminator — written on success and on ERROR_INPUT_OBJECT_SIZE.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_to_string(value, out_string.as_unsafe_any_origin(), out_capacity, out_length.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Vector
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_vector_get_vector_type[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        out_type: Pointer[DUCKDB_V2_VECTOR_TYPE, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the internal representation kind: flat, constant, or dictionary.

        Reports VECTOR_TYPE_OTHER for FSST / SEQUENCE / SHREDDED vectors, which
        must be passed through vector_flatten before vector_get_view will read
        them.

        Args:
            vector: The vector.
            out_type: Receives the representation kind.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_vector_type(vector, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_get_logical_type[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the vector's logical type.

        The returned logical type is the same type that was passed to vector_reference, or the type that was set on creation.
        It is caller-owned; destroy it via logical_type_destroy.

        Args:
            vector: The vector.
            out_type: Receives the caller-owned logical type handle. Destroy via logical_type_destroy.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_logical_type(vector, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_get_view[out_view_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        out_view: Pointer[duckdb_v2_vector_view, out_view_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reads a vector as a unified view of data, validity, selection, and count.

        Populates out_view with borrowed pointers, valid until the owning chunk
        is destroyed. view.data addresses the vector's elements, to be cast to
        the layout its logical type implies: a typed leaf array for the
        primitives, hugeint_t / uhugeint_t / interval_t for those kinds, bytes
        for VARCHAR / BLOB / BIT / BIGNUM, list_entry for LIST and MAP, and
        nothing at all for ARRAY / STRUCT / UNION, whose data lives in their
        children.

        DECIMAL and ENUM are typed leaf arrays too, over a storage tier that
        follows from the type; both mappings are contract. A DECIMAL of width <=
        4 stores int16, <= 9 int32, <= 18 int64, and <= 38 int128, boundaries
        inclusive, with the width and scale available from
        logical_type_get_param. An ENUM stores its dictionary indices as uint8
        for a dictionary of at most 255 entries, uint16 for at most 65535, and
        uint32 beyond that, boundaries inclusive and an empty dictionary uint8;
        logical_type_get_param resolves an index to its entry.

        Rejects VECTOR_TYPE_OTHER; call vector_flatten first.

        Reading a DICTIONARY vector has one side effect: the dictionary's
        underlying child is flattened in place if it is not already FLAT. The
        parent vector stays DICTIONARY, and only the child's storage shape
        changes, but any pointer previously borrowed into that child — from an
        earlier vector_get_view on a vector aliasing the same buffer, say — is
        invalidated. This is the only mutation vector_get_view performs; compare
        vector_flatten, which materializes the whole vector to FLAT.

        Args:
            vector: The vector to read.
            out_view: Receives the view. Its pointers are borrowed and valid until the owning chunk is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_view(vector, out_view.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_get_size[out_size_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        out_size: Pointer[idx_t, out_size_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of elements in the vector.

        The size is the number of logical elements the vector represents, which
        for a nested kind can differ from the size of its children. An ARRAY
        vector of size 10 whose array size is 3, for instance, has 10 logical
        elements while its single child vector has 30.

        Args:
            vector: The vector.
            out_size: Receives the number of elements.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_size(vector, out_size.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_set_size[err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        size: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the number of elements in the vector.

        The counterpart of vector_get_size: it declares how many logical elements
        the vector now holds. It reserves enough space for size logical elements.

        Args:
            vector: The vector.
            size: The new number of logical elements.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_set_size(vector, size, err.as_unsafe_any_origin())

    def duckdb_v2_vector_get_value[out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        row: idx_t,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reads one cell of a vector as an owned value.

        The total fallback reader. It reads any logical row of any vector
        representation without flattening — FLAT, CONSTANT, DICTIONARY, and the
        compressed kinds the view getter rejects — and covers every type kind,
        including those with no committed view layout (today VARIANT and
        GEOMETRY), where it is the only way to reach a cell.

        Each call allocates one owned value, which makes this a single-cell
        bridge rather than a per-row loop primitive; use vector_get_view on hot
        paths. The row index is logical and bounds-checked against
        vector_get_size. The returned value is caller-owned; destroy it via
        value_destroy.

        Args:
            vector: The vector to read from.
            row: The logical row index, in [0, vector_get_size).
            out_value: Receives the owned cell value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_value(vector, row, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_set_value[err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        row: idx_t,
        value: duckdb_v2_value_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Writes one cell of a FLAT vector from a value.

        The total fallback writer. It covers every type kind, including those
        with no committed view layout (today VARIANT and GEOMETRY), where it is
        the only way to write a cell. The value is borrowed and copied in, then
        cast to the vector's type through the non-strict default cast; a cast
        failure surfaces from the call. A NULL value clears the row's validity.

        Requires a FLAT vector: constant, dictionary, and compressed
        representations are not row-addressable, so call vector_flatten first.
        Each call performs one value write, which makes this a single-cell bridge
        rather than a per-row loop primitive; use the typed mutable-data paths on
        hot paths. The row index is logical and bounds-checked against
        vector_get_size.

        Args:
            vector: The vector to write to.
            row: The logical row index, in [0, vector_get_size).
            value: The borrowed value to write. Copied in; cast to the vector's type.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_set_value(vector, row, value, err.as_unsafe_any_origin())

    def duckdb_v2_vector_get_data_mutable[out_data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        out_data: Pointer[Pointer[NoneType, MutUntrackedOrigin], out_data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns a mutable pointer to the data of a FLAT or CONSTANT vector.

        Any other representation returns ERROR_INPUT_INVALID. The pointer is
        valid until the owning chunk is destroyed, and the vector's storage shape
        must not change — through a flatten, say — while it is in use.

        When writing VARCHAR values, the caller must ensure that the bytes
        contain valid UTF-8.

        Args:
            vector: The vector.
            out_data: Receives a mutable pointer to the data.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_data_mutable(vector, out_data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_flatten[err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Forces a vector into FLAT representation, in place.

        A no-op for a vector that is already FLAT. For a CONSTANT, DICTIONARY,
        FSST, SEQUENCE, or SHREDDED vector it materializes the per-row data and
        switches the representation to FLAT. Call it before vector_get_view if
        you would rather not handle CONSTANT and DICTIONARY semantics in the
        view; it is required for any vector reporting VECTOR_TYPE_OTHER.

        Args:
            vector: The vector to flatten.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_flatten(vector, err.as_unsafe_any_origin())

    def duckdb_v2_vector_cast[out_converted_origin: MutOrigin, cast_err_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        source: duckdb_v2_vector_handle,
        target: duckdb_v2_vector_handle,
        mode: DUCKDB_V2_CAST_MODE,
        out_converted: Pointer[Bool, out_converted_origin],
        cast_err: Pointer[duckdb_v2_error_info_handle, cast_err_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Casts every row of a vector into another vector, using a factory.

        The conversion is the one SQL `CAST` / `TRY_CAST` performs, registered
        custom casts included, from the type of `source` to the type of
        `target`. It covers as many rows as `source` holds
        (`duckdb_v2_vector_get_size`), of any representation. `target` is replaced
        by the result, as `duckdb_v2_vector_reference` would, taking its size: data
        and views taken from it beforehand do not survive the call, and nothing
        it held before carries over. In CAST_MODE_NORMAL a row that does not convert fails the call
        with the engine's conversion error, and the contents of `target` are
        unspecified. In CAST_MODE_TRY such rows are NULL in `target` instead and
        the call succeeds; compare the validity of `source` and `target` to find
        them. `cast_err` then receives the conversion error of one of them, e.g.
        to report why the cast did not convert every row.

        A connection's or callback's factory casts with that client's cast
        functions and settings (e.g. TimeZone). An instance's factory supports
        only the built-in casts, with default settings. `source` and `target`
        must be different vectors; `target` is typically a vector of a data
        chunk created by the caller, or the result vector of a callback.

        Args:
            factory: The factory supplying the cast functions.
            source: The vector to cast. Borrowed for the call only.
            target: The vector to write the cast rows into. Its logical type is the target type.
            mode: Whether a row that does not convert fails the call, or becomes NULL.
            out_converted: Optional. Receives whether every row converted. Always true when a
                CAST_MODE_NORMAL cast succeeds.
            cast_err: Optional. When a CAST_MODE_TRY cast succeeds without converting every
                row, receives an opaque info handle with the conversion error of one
                row that did not convert, which the caller must destroy via
                error_info_destroy. Otherwise receives NULL.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_cast(factory, source, target, mode, out_converted.as_unsafe_any_origin(), cast_err.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_reference[err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        source: duckdb_v2_vector_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Repoints a vector at another vector's data, without copying.

        `vector` takes on the storage of `source`: no data moves, and the two alias
        the same buffers until one of them is reset or re-referenced. Works for any
        type, including nested types. The source's logical type must equal the
        vector's; a mismatch returns ERROR_INPUT_INVALID. The source's data must
        outlive every read of `vector`. Use it to hand an already-materialized
        vector straight to an output vector without a per-row copy.

        Args:
            vector: The vector to repoint at the source's data.
            source: The vector whose data to reference. Its logical type must equal the vector's.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_reference(vector, source, err.as_unsafe_any_origin())

    def duckdb_v2_vector_make_constant[err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        value: duckdb_v2_value_handle,
        count: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Turns the vector into a CONSTANT vector holding the given value.

        Afterwards the vector holds a single element that applies to every
        logical row; write it through vector_get_data_mutable, which returns a
        pointer to that one element. For a STRUCT vector the change propagates to
        every child. The value's logical type must equal the vector's; a mismatch
        returns ERROR_INPUT_INVALID.

        Args:
            vector: The vector to make constant.
            value: The value every row takes. Its logical type must equal the vector's.
            count: The number of elements in the vector.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_make_constant(vector, value, count, err.as_unsafe_any_origin())

    def duckdb_v2_vector_make_sequence[err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        start: Int64,
        increment: Int64,
        count: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets a vector to a SEQUENCE representation.

        Afterwards the vector represents the arithmetic sequence start,
        start+increment, start+2*increment, ... over count elements. No data
        pointer is involved; the three parameters describe the sequence
        completely.

        Args:
            vector: The vector to turn into a sequence.
            start: The first value of the sequence.
            increment: The step between consecutive values.
            count: The number of elements in the sequence.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_make_sequence(vector, start, increment, count, err.as_unsafe_any_origin())

    def duckdb_v2_vector_set_null[err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        row: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets one row of a FLAT vector to NULL, nested children included.

        Clears the row's validity and broadcasts the NULL recursively to every
        descendant element under that row — STRUCT fields, and ARRAY elements
        strided by the array size — maintaining DuckDB's nested NULL invariant:
        when a STRUCT or ARRAY row is NULL, every descendant element under it
        must be NULL too. LIST children are left untouched, since their consumers
        gate on the list's own validity. Which kinds propagate is normative
        DuckDB behavior that evolves with the type system, which makes this the
        total NULL write path: equivalent to vector_set_value with a NULL value,
        without the per-call value allocation.

        Requires a FLAT vector: constant, dictionary, and compressed
        representations are not row-addressable, so call vector_flatten first.
        The row index is logical and bounds-checked against vector_get_size.

        Args:
            vector: The vector to write to.
            row: The logical row index, in [0, vector_get_size).
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_set_null(vector, row, err.as_unsafe_any_origin())

    def duckdb_v2_vector_flat_get_validity_mutable[out_validity_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        out_validity: Pointer[Pointer[UInt64, MutUntrackedOrigin], out_validity_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns a mutable pointer to the validity mask of a FLAT vector.

        Allocates the mask on first use, so the returned pointer is always
        non-null. Each uint64_t word covers 64 rows: bit N of word W is row
        W*64+N. A set bit means valid; a cleared bit means NULL.

        A raw mask write marks only this vector's rows. Clearing a STRUCT or
        ARRAY parent bit leaves the descendant elements untouched, which violates
        DuckDB's nested NULL invariant — a NULL STRUCT or ARRAY row requires NULL
        descendants — so set nested rows NULL through vector_set_null instead.
        When writing nested masks raw anyway, invalidate the child masks up front
        and mark elements valid as the values are written.

        Args:
            vector: The vector.
            out_validity: Receives a mutable pointer to the validity mask.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_flat_get_validity_mutable(vector, out_validity.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_constant_set_valid[err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        validity: Bool,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the validity of a CONSTANT vector.

        A constant vector holds a single element, so one flag decides whether
        every row reads as the value or as NULL.

        Args:
            vector: The constant vector.
            validity: True to mark the vector's single element valid, false to mark it NULL.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_constant_set_valid(vector, validity, err.as_unsafe_any_origin())

    def duckdb_v2_vector_get_arena[out_arena_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        out_arena: Pointer[duckdb_v2_arena_handle, out_arena_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows a string-backed vector's arena for writing.

        Allocates the arena on first use. Valid for VARCHAR, BLOB, BIT, and
        BIGNUM vectors, and returns ERROR_INPUT_INVALID for anything else. This
        call is the single string-ness check, which is why arena_allocate itself
        performs none. The arena is borrowed — never destroy it — and stays valid
        until the vector is flattened, reallocated, or destroyed.

        Args:
            vector: The string-backed vector whose arena to borrow.
            out_arena: Receives the borrowed arena handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_arena(vector, out_arena.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_get_child_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of child vectors a nested vector exposes.

        1 for LIST, MAP and ARRAY; the field count for STRUCT; member_count + 1
        for UNION, the tag plus the members; and 0 for any non-nested kind.
        vector_get_child documents what each index addresses.

        Args:
            vector: The vector.
            out_count: Receives the number of child vectors.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_child_count(vector, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_vector_get_child[out_child_origin: MutOrigin, err_origin: MutOrigin](
        self,
        vector: duckdb_v2_vector_handle,
        index: idx_t,
        out_child: Pointer[duckdb_v2_vector_handle, out_child_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows a child vector by index.

        What each index addresses, by kind: LIST and ARRAY expose [0] = the
        elements; MAP [0] = the entries, a STRUCT(key, value) whose children are
        the keys and the values; STRUCT and TUPLE [i] = field i; and UNION [0] =
        the tag with [1..N] = the members. Note that value_get_child diverges on
        UNION, exposing only the active member.

        The returned child is borrowed and lives as long as the owning chunk.
        Returns ERROR_INPUT_INVALID if the vector has no children, or if the
        index is out of range.

        Args:
            vector: The nested vector to descend into.
            index: The child index, in [0, vector_get_child_count).
            out_child: Receives the borrowed child vector.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_vector_get_child(vector, index, out_child.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_bignum_decode[in_data_origin: ImmOrigin, out_data_origin: MutOrigin, out_length_origin: MutOrigin, out_is_negative_origin: MutOrigin, err_origin: MutOrigin](
        self,
        in_data: Pointer[UInt8, in_data_origin],
        in_length: idx_t,
        out_data: Pointer[UInt8, out_data_origin],
        out_capacity: idx_t,
        out_length: Pointer[idx_t, out_length_origin],
        out_is_negative: Pointer[Bool, out_is_negative_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Decodes BIGNUM storage bytes into a caller-supplied magnitude buffer + sign flag.

        in_data and in_length are the value's raw storage bytes, exactly as they
        sit in a vector's bignum payload or as value_get_blob reports them for a
        BIGNUM value. Those bytes are opaque: the storage encoding is not a
        committed part of this API, and this function is the only thing that
        interprets them.

        Writes the big-endian magnitude bytes into out_data and the sign flag
        into out_is_negative; reconstruct the integer as (-1)**out_is_negative *
        unsigned_big_endian(out_data[0..out_length]). Materializing the bytes is
        unavoidable, since a negative bignum stores its magnitude bit-inverted,
        but the buffer belongs to the caller: this function never allocates and
        hands back nothing to free.

        Pass out_data = NULL to size the buffer without decoding. out_length then
        receives the exact number of magnitude bytes and out_is_negative the
        sign, and out_capacity is ignored. The size comes straight out of the
        storage header, so the query is O(1) and exact — a size call followed by
        a decode call never needs a retry loop.

        With out_data != NULL, out_capacity must be at least out_length bytes, or
        the call returns ERROR_INPUT_OBJECT_SIZE with out_length set to the
        required size and out_data left untouched. On success exactly out_length
        bytes are written, and the rest of the buffer is not modified.

        Returns ERROR_INPUT_INVALID if in_data is NULL, or if in_length is too
        short to hold a bignum header.

        Args:
            in_data: The value's raw BIGNUM storage bytes.
            in_length: Size of in_data in bytes.
            out_data: Caller-owned buffer receiving the magnitude bytes, or NULL to only report the required size in out_length.
            out_capacity: Bytes available in out_data. Ignored when out_data is NULL.
            out_length: Receives the magnitude size in bytes, written on success and on ERROR_INPUT_OBJECT_SIZE.
            out_is_negative: Receives true if the value is negative, false otherwise.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_bignum_decode(in_data.as_unsafe_any_origin(), in_length, out_data.as_unsafe_any_origin(), out_capacity, out_length.as_unsafe_any_origin(), out_is_negative.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_bignum_encode[in_data_origin: ImmOrigin, out_data_origin: MutOrigin, out_length_origin: MutOrigin, err_origin: MutOrigin](
        self,
        in_data: Pointer[UInt8, in_data_origin],
        in_length: idx_t,
        is_negative: Bool,
        out_data: Pointer[UInt8, out_data_origin],
        out_capacity: idx_t,
        out_length: Pointer[idx_t, out_length_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Encodes a magnitude + sign flag into BIGNUM storage bytes.

        The inverse of bignum_decode. in_data and in_length are the big-endian
        magnitude bytes and is_negative the sign; out_data receives the raw
        storage bytes for that integer, in the form a BIGNUM vector payload
        expects. Those bytes are opaque: the storage encoding is not a committed
        part of this API.

        Pass out_data = NULL to size the buffer without encoding. out_length then
        receives the exact number of storage bytes, and out_capacity is ignored.
        The size is a fixed function of in_length, so the query is O(1) and
        exact.

        With out_data != NULL, out_capacity must be at least out_length bytes, or
        the call returns ERROR_INPUT_OBJECT_SIZE with out_length set to the
        required size and out_data left untouched. On success exactly out_length
        bytes are written, and the rest of the buffer is not modified.

        The magnitude must be canonical, matching what bignum_decode produces:
        in_length >= 1 with no leading zero bytes, so the value zero is the
        single byte 0x00 with is_negative = false. A NULL in_data, an in_length
        of 0, a leading zero byte, or a negative zero returns
        ERROR_INPUT_INVALID; a magnitude beyond the maximum bignum width returns
        ERROR_INPUT_OUT_OF_RANGE.

        Args:
            in_data: Big-endian magnitude bytes, with no leading zero bytes.
            in_length: Size of in_data in bytes. Must be >= 1.
            is_negative: True to encode a negative value.
            out_data: Caller-owned buffer receiving the storage bytes, or NULL to only report the required size in out_length.
            out_capacity: Bytes available in out_data. Ignored when out_data is NULL.
            out_length: Receives the storage size in bytes — written on success and on ERROR_INPUT_OBJECT_SIZE.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_bignum_encode(in_data.as_unsafe_any_origin(), in_length, is_negative, out_data.as_unsafe_any_origin(), out_capacity, out_length.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_validate_utf8[text_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        text: Pointer[duckdb_v2_str, text_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Validates all text->len bytes as UTF-8, including bytes after embedded NUL characters.

        Returns ERROR_INPUT_INVALID if any of:
        - text is NULL.
        - text->ptr is NULL and text->len is nonzero.
        - The input contains malformed UTF-8.

        A view with a NULL ptr and zero length is valid.

        Args:
            text: The bytes to validate.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_validate_utf8(text.as_unsafe_any_origin(), err.as_unsafe_any_origin())


