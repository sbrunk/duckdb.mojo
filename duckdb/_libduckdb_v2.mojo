        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the bind data set by the function's `COPY ... FROM` bind callback.

        Args:
            info: The progress info handle.
            data: Receives the bind data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_from_progress_get_bind_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_copy_from_progress_get_global_state[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_copy_from_progress_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the global state set by the function's global init callback.

        The progress callback runs concurrently with the exec callbacks reading the file, so it must read the global
        state in a thread-safe way.

        Args:
            info: The progress info handle.
            data: Receives the global state pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_from_progress_get_global_state(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_copy_from_progress_set_progress[err_origin: MutOrigin](
        self,
        info: duckdb_v2_copy_from_progress_info_handle,
        progress: Float64,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports how far the read has advanced.

        A fraction between 0.0 (nothing read yet) and 1.0 (done); values outside that range are clamped. A progress
        callback that returns without calling this reports no progress.

        Args:
            info: The progress info handle.
            progress: The fraction of the read that is complete, in [0.0, 1.0].
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_from_progress_set_progress(info, progress, err.as_unsafe_any_origin())

    def duckdb_v2_connection_register_copy_function[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        function_: duckdb_v2_copy_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the copy function, making it available as a `COPY` format.

        The function is registered on the connection's database, visible to every connection, in the connection's
        transaction: inside an explicit transaction, it is invisible to other connections until the transaction commits,
        and a rollback undoes it. Registration requires a name and at least one configured side: a `COPY ... TO` side
        needs its batch and flush callbacks, a `COPY ... FROM` side needs its bind and exec callbacks. A statement in a
        direction the function does not implement fails with an error. The copy function must have been created through a
        factory of the same database. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_copy_function_destroy`, which does not affect the registered function.

        Args:
            conn: The connection to register on.
            function_: The copy function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_register_copy_function(conn, function_, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_copy_function[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        function_: duckdb_v2_copy_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the copy function, making it available as a `COPY` format.

        The function is registered on the loading extension's database and attributed to the extension. Use this from the
        extension's load callback. Registration requires a name and at least one configured side: a `COPY ... TO` side
        needs its batch and flush callbacks, a `COPY ... FROM` side needs its bind and exec callbacks. A statement in a
        direction the function does not implement fails with an error. The copy function must have been created through a
        factory of the same database. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_copy_function_destroy`, which does not affect the registered function.

        Args:
            extension: The loading extension.
            function_: The copy function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_copy_function(extension, function_, err.as_unsafe_any_origin())

    def duckdb_v2_copy_function_destroy[function__origin: MutOrigin](
        self,
        function_: Pointer[duckdb_v2_copy_function_handle, function__origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the copy function, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to
        prevent double-destruction. Destroying the handle after registration does not affect the registered
        function.

        Args:
            function_: The function to destroy.
        """
        return self._duckdb_v2_copy_function_destroy(function_.as_unsafe_any_origin())

    def duckdb_v2_copy_to_set_statistics_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_copy_function_handle,
        callback: duckdb_v2_copy_to_statistics_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional statistics callback of the `COPY ... TO` side.

        The statistics callback reports statistics about a written file, such as the number of rows and bytes it
        holds, which `COPY ... TO` returns when the statement asks for them with `RETURN_STATS`. It is invoked once
        per output file, after the finalize callback of that file, and only when the statement asks for the
        statistics. Without a statistics callback, `RETURN_STATS` is rejected for the function.

        Args:
            function_: The function to set the callback of.
            callback: The callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_to_set_statistics_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_copy_to_statistics_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_copy_to_statistics_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set on the copy function via `duckdb_v2_copy_function_set_user_data`.

        Args:
            info: The statistics info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_to_statistics_get_user_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_copy_to_statistics_get_bind_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_copy_to_statistics_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the bind data set by the function's `COPY ... TO` bind callback.

        Args:
            info: The statistics info handle.
            data: Receives the bind data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_to_statistics_get_bind_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_copy_to_statistics_get_init_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_copy_to_statistics_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the init data set by the function's `COPY ... TO` init callback for the file being reported.

        Args:
            info: The statistics info handle.
            data: Receives the init data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_to_statistics_get_init_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_copy_to_statistics_set_row_count[err_origin: MutOrigin](
        self,
        info: duckdb_v2_copy_to_statistics_info_handle,
        row_count: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports how many rows were written to the file. Reported as 0 when the callback does not set it.

        Args:
            info: The statistics info handle.
            row_count: The number of rows written to the file.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_to_statistics_set_row_count(info, row_count, err.as_unsafe_any_origin())

    def duckdb_v2_copy_to_statistics_set_file_size[err_origin: MutOrigin](
        self,
        info: duckdb_v2_copy_to_statistics_info_handle,
        file_size_bytes: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports the size of the written file in bytes. Reported as 0 when the callback does not set it.

        Args:
            info: The statistics info handle.
            file_size_bytes: The size of the file in bytes.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_to_statistics_set_file_size(info, file_size_bytes, err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Function docs
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_function_docs_set_description[description_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        docs: duckdb_v2_function_docs_handle,
        description: Pointer[duckdb_v2_str, description_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the description of the function overload.

        The description is borrowed and copied. Calling this again replaces the previous description.

        Args:
            docs: The documentation to set the description of.
            description: The description to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_docs_set_description(docs, description.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_function_docs_add_example[title_origin: ImmOrigin, example_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        docs: duckdb_v2_function_docs_handle,
        title: Pointer[duckdb_v2_str, title_origin],
        example: Pointer[duckdb_v2_str, example_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Adds an example of calling the function overload.

        The title and the example are borrowed and copied, and examples are reported in the order they were added.

        Args:
            docs: The documentation to add the example to.
            title: Optional. The title of the example; NULL or an empty view for none. Borrowed and copied.
            example: The example, e.g. a SQL expression calling the function. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_docs_add_example(docs, title.as_unsafe_any_origin(), example.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_function_docs_add_category[category_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        docs: duckdb_v2_function_docs_handle,
        category: Pointer[duckdb_v2_str, category_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Adds a category the function overload belongs to, e.g. "string" or "aggregate".

        The category is borrowed and copied, and categories are reported in the order they were added.

        Args:
            docs: The documentation to add the category to.
            category: The category. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_docs_add_category(docs, category.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Function
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_function_bind_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_function_bind_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set on the function being bound, e.g. via `duckdb_v2_scalar_function_set_user_data`.

        Args:
            info: The bind info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_bind_get_user_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_function_bind_set_bind_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_function_bind_info_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the function's "bind data" from the bind callback.

        The bind data is stored with the bound call site and retrievable from every later callback. The opaque
        handle bundles the pointer with an optional destructor, invoked when the bind data is no longer needed,
        and an optional equality callback used when comparing two bound call sites; without one, pointer equality
        is used. Scalar functions set their bind data through `duckdb_v2_scalar_function_bind_set_bind_data` instead.

        Args:
            info: The bind info handle.
            data: Opaque handle bundling the bind data pointer plus optional destructor and equality callbacks.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_bind_set_bind_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_function_bind_get_arg_count[positional_fixed_origin: MutOrigin, positional_variadic_origin: MutOrigin, named_fixed_origin: MutOrigin, named_variadic_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_function_bind_info_handle,
        positional_fixed: Pointer[idx_t, positional_fixed_origin],
        positional_variadic: Pointer[idx_t, positional_variadic_origin],
        named_fixed: Pointer[idx_t, named_fixed_origin],
        named_variadic: Pointer[idx_t, named_variadic_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of arguments of the call site being bound, split into the four parts of the argument list.

        The parts follow each other in this order: the positional-only and standard parameters, the arguments `*args`
        received, the named-only parameters, and the arguments `**kwargs` received. The argument at index `i` of the
        named-only part is therefore at index `positional_fixed + positional_variadic + i`. Valid indices for the
        other argument functions are [0, the sum of the four counts). Every out-parameter may be NULL, in which case
        nothing is written to it.

        Args:
            info: The bind info handle.
            positional_fixed: Optional. Receives the number of positional-only and standard parameters.
            positional_variadic: Optional. Receives the number of arguments `*args` received, 0 when the signature has none.
            named_fixed: Optional. Receives the number of named-only parameters.
            named_variadic: Optional. Receives the number of arguments `**kwargs` received, 0 when the signature has none.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_bind_get_arg_count(info, positional_fixed.as_unsafe_any_origin(), positional_variadic.as_unsafe_any_origin(), named_fixed.as_unsafe_any_origin(), named_variadic.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_function_bind_get_arg_type[type__origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_function_bind_info_handle,
        index: idx_t,
        type_: Pointer[duckdb_v2_logical_type_handle, type__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the type of the argument at the given index.

        Fails if the index is out of bounds. The returned type is owned by the caller and must be destroyed via
        `duckdb_v2_logical_type_destroy`.

        Args:
            info: The bind info handle.
            index: The index of the argument.
            type_: Receives the argument type. Owned by the caller; destroy via `duckdb_v2_logical_type_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_bind_get_arg_type(info, index, type_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_function_bind_get_arg_value[value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_function_bind_info_handle,
        index: idx_t,
        value: Pointer[duckdb_v2_value_handle, value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Folds the argument at the given index to a constant value.

        Fails if the argument is not constant, e.g. a column reference, or if the index is out of bounds. The
        arguments of a table or pragma function are always constant. The resulting value may be NULL. The returned value is
        owned by the caller and must be destroyed via `duckdb_v2_value_destroy`.

        Args:
            info: The bind info handle.
            index: The index of the argument.
            value: Receives the constant value. Owned by the caller; destroy via `duckdb_v2_value_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_bind_get_arg_value(info, index, value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_function_bind_get_arg_name[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_function_bind_info_handle,
        index: idx_t,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the name of the argument at the given index.

        For an argument of a declared parameter, this is the parameter name. For an argument `**kwargs` received, it
        is the name the caller passed, which may be the name of a positional-only parameter. An argument `*args`
        received has no name, and yields an empty name. Fails if the index is out of bounds. The name is borrowed
        and valid only for the duration of the callback.

        Args:
            info: The bind info handle.
            index: The index of the argument.
            name: Receives a borrowed view of the argument name. Valid only for the duration of the callback.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_bind_get_arg_name(info, index, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_function_bind_get_arg_index[name_origin: ImmOrigin, index_origin: MutOrigin, found_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_function_bind_info_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        index: Pointer[idx_t, index_origin],
        found: Pointer[Bool, found_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Looks up the index of an argument by name.

        Names are matched case-insensitively, against the names a caller can pass an argument by: those of the
        standard and named-only parameters, and those `**kwargs` received. Positional-only parameters are skipped,
        so `f(1, x := 2)` with a positional-only `x` finds the argument `**kwargs` received. A name the call did not
        pass is not an error: `found` receives false and `index` is left untouched. A standard or named-only
        parameter is always found, as the call either passed it or it carries its default value.

        Args:
            info: The bind info handle.
            name: The name to look up. Borrowed for the call only.
            index: Receives the index of the argument, if found.
            found: Receives whether the call has an argument of that name.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_bind_get_arg_index(info, name.as_unsafe_any_origin(), index.as_unsafe_any_origin(), found.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Macro
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_macro_function_create[function__origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        type_: DUCKDB_V2_MACRO_FUNCTION_TYPE,
        function_: Pointer[duckdb_v2_macro_function_handle, function__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new macro function through a factory.

        The macro function starts out empty: configure it with the setter functions and the signature obtained via
        `duckdb_v2_macro_function_get_signature`, then make it available with `duckdb_v2_extension_register_macro_function`. The
        caller owns the returned handle and must destroy it with `duckdb_v2_macro_function_destroy`, also after registration.

        The macro function can only be registered on the database the factory belongs to.

        Args:
            factory: The factory to create the macro function through.
            type_: Whether the macro is a scalar or a table macro.
            function_: On success, receives the newly created macro function. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_macro_function_create(factory, type_, function_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_macro_function_set_name[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_macro_function_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the macro function, as SQL calls it.

        The name is borrowed and copied. Calling this again replaces the previous name. A name must be set before
        registration.

        Args:
            function_: The macro function to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_macro_function_set_name(function_, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_macro_function_set_body[body_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_macro_function_handle,
        body: Pointer[duckdb_v2_str, body_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the body of the macro function, as SQL text.

        For a scalar macro the body is a single expression, for a table macro a single SELECT query. It refers to the
        parameters by name. The body is parsed at registration, which fails on a syntax error; names in it are resolved
        only when the macro is called, as with SQL `CREATE MACRO`. The body is borrowed and copied. Calling this again
        replaces the previous body. A body must be set before registration.

        Args:
            function_: The macro function to set the body of.
            body: The SQL text of the body. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_macro_function_set_body(function_, body.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_macro_function_get_signature[sig_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_macro_function_handle,
        sig: Pointer[duckdb_v2_function_signature_handle, sig_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the macro function's signature so its parameters can be declared.

        Add parameters with `duckdb_v2_function_signature_add_parameter`. A macro's parameters can always be passed by
        position or by name, so only `FUNCTION_PARAMETER_KIND_STANDARD` parameters are accepted; a macro has no variadic
        parameters. A parameter of type ANY is untyped, and a parameter with a default value can be omitted by a caller.
        A macro's result is decided by its body, so the signature cannot set a return type. Registration fails on a
        signature that does not follow these rules. The signature is modified in place.

        Args:
            function_: The macro function to get the signature of.
            sig: The returned signature. Borrowed and valid for the lifetime of the macro function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_macro_function_get_signature(function_, sig.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_macro_function_get_docs[docs_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_macro_function_handle,
        docs: Pointer[duckdb_v2_function_docs_handle, docs_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the documentation of the macro function so it can be filled in.

        Set a description with `duckdb_v2_function_docs_set_description`, and add examples and categories with
        `duckdb_v2_function_docs_add_example` and `duckdb_v2_function_docs_add_category`. The documentation is modified in place and
        registered with the macro function. Optional.

        Args:
            function_: The macro function to get the documentation of.
            docs: The returned documentation. Borrowed and valid for the lifetime of the macro function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_macro_function_get_docs(function_, docs.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_macro_function[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        function_: duckdb_v2_macro_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the macro function, making it available for use in SQL queries.

        The macro function is registered on the loading extension's database and attributed to the extension. Use this
        from the extension's load callback. Registration requires a name and a body that parses, and a signature that
        follows the rules of `duckdb_v2_macro_function_get_signature`. It fails when a function of the same name already
        exists: a macro function has a single overload. The macro function must have been created through a factory of
        the same database. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_macro_function_destroy`, which does not affect the registered macro function.

        Args:
            extension: The loading extension.
            function_: The macro function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_macro_function(extension, function_, err.as_unsafe_any_origin())

    def duckdb_v2_macro_function_destroy[function__origin: MutOrigin](
        self,
        function_: Pointer[duckdb_v2_macro_function_handle, function__origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the macro function, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to
        prevent double-destruction. Destroying the handle after registration does not affect the registered
        macro function.

        Args:
            function_: The macro function to destroy.
        """
        return self._duckdb_v2_macro_function_destroy(function_.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Pragma
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_pragma_function_create[function__origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        function_: Pointer[duckdb_v2_pragma_function_handle, function__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new pragma function through a factory.

        The function starts out empty: configure it with the setter functions (e.g. `duckdb_v2_pragma_function_set_name`,
        `duckdb_v2_pragma_function_set_query_callback`, etc.) and the signature obtained via `duckdb_v2_pragma_function_get_signature`,
        then make it available with `duckdb_v2_connection_register_pragma_function` or
        `duckdb_v2_extension_register_pragma_function`. The caller owns the returned handle and must destroy it with
        `duckdb_v2_pragma_function_destroy`, also after registration.

        The pragma function can only be registered on the database the factory belongs to.

        Args:
            factory: The factory to create the pragma function through.
            function_: On success, receives the newly created pragma function. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_pragma_function_create(factory, function_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_pragma_function_set_name[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_pragma_function_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the pragma function, as the `PRAGMA` statement calls it.

        The name is borrowed and copied. Calling this again replaces the previous name.
        A name must be set before registration.

        Args:
            function_: The function to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_pragma_function_set_name(function_, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_pragma_function_get_docs[docs_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_pragma_function_handle,
        docs: Pointer[duckdb_v2_function_docs_handle, docs_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the documentation of the function so it can be filled in.

        Set a description with `duckdb_v2_function_docs_set_description`, and add examples and categories with
        `duckdb_v2_function_docs_add_example` and `duckdb_v2_function_docs_add_category`. The documentation is modified in place and
        registered with the function. Optional.

        Args:
            function_: The function to get the documentation of.
            docs: The returned documentation. Borrowed and valid for the lifetime of the function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_pragma_function_get_docs(function_, docs.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_pragma_function_get_signature[sig_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_pragma_function_handle,
        sig: Pointer[duckdb_v2_function_signature_handle, sig_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the function's signature so it can be configured.

        Add parameters with `duckdb_v2_function_signature_add_parameter`. A pragma produces no value, so its signature cannot
        set a return type. A signature without parameters makes a pragma called as `PRAGMA name`. The signature is
        modified in place.

        Args:
            function_: The function to get the signature of.
            sig: The returned signature. Borrowed and valid for the lifetime of the function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_pragma_function_get_signature(function_, sig.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_pragma_function_set_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_pragma_function_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets arbitrary user data on the pragma function.

        Associates an opaque pointer with the function, retrievable from the callbacks via
        `duckdb_v2_function_bind_get_user_data`. The opaque handle bundles the pointer with an optional destructor, invoked
        when the data is no longer needed.

        Args:
            function_: The function to set the user data of.
            data: Opaque handle bundling the user data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_pragma_function_set_user_data(function_, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_pragma_function_set_query_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_pragma_function_handle,
        callback: duckdb_v2_pragma_function_query_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the query callback of the pragma function, making it a query pragma.

        The query callback is invoked before the `PRAGMA` statement is bound, and must set a SQL string through
        `duckdb_v2_pragma_function_query_set_query`. The string is parsed and its statements run in place of the `PRAGMA`
        statement. A pragma function has either a query callback or an exec callback; registration fails when both or
        neither are set.

        Args:
            function_: The function to set the query callback of.
            callback: The query callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_pragma_function_set_query_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_pragma_function_set_exec_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_pragma_function_handle,
        callback: duckdb_v2_pragma_function_exec_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the exec callback of the pragma function, making it an exec pragma.

        The exec callback is invoked when the `PRAGMA` statement executes, and runs for its side effects: the statement
        produces no rows. A pragma function has either a query callback or an exec callback; registration fails when
        both or neither are set.

        Args:
            function_: The function to set the exec callback of.
            callback: The exec callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_pragma_function_set_exec_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_pragma_function_query_set_query[query_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_pragma_function_query_info_handle,
        query: Pointer[duckdb_v2_str, query_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the SQL to run in place of the `PRAGMA` statement.

        The query may hold several statements, separated by semicolons. It is borrowed and copied. Calling this again
        replaces the previous query. The query callback must set a query.

        Args:
            info: The query info handle.
            query: The SQL to run. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_pragma_function_query_set_query(info, query.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_register_pragma_function[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        function_: duckdb_v2_pragma_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the pragma function, making it available to the `PRAGMA` statement.

        The function is registered on the connection's database, visible to every connection, in the connection's
        transaction: inside an explicit transaction, it is invisible to other connections until the transaction commits,
        and a rollback undoes it. Registration requires a name and exactly one of a query callback or an exec callback,
        and fails when a pragma of the same name already exists. The pragma function must have been created through a
        factory of the same database. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_pragma_function_destroy`, which does not affect the registered function.

        Args:
            conn: The connection to register on.
            function_: The pragma function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_register_pragma_function(conn, function_, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_pragma_function[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        function_: duckdb_v2_pragma_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the pragma function, making it available to the `PRAGMA` statement.

        The function is registered on the loading extension's database and attributed to the extension. Use this from the
        extension's load callback. Registration requires a name and exactly one of a query callback or an exec callback,
        and fails when a pragma of the same name already exists. The pragma function must have been created through a
        factory of the same database. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_pragma_function_destroy`, which does not affect the registered function.

        Args:
            extension: The loading extension.
            function_: The pragma function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_pragma_function(extension, function_, err.as_unsafe_any_origin())

    def duckdb_v2_pragma_function_destroy[function__origin: MutOrigin](
        self,
        function_: Pointer[duckdb_v2_pragma_function_handle, function__origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the pragma function, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to
        prevent double-destruction. Destroying the handle after registration does not affect the registered
        function.

        Args:
            function_: The function to destroy.
        """
        return self._duckdb_v2_pragma_function_destroy(function_.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Replacement scan
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_replacement_scan_create[scan_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        scan: Pointer[duckdb_v2_replacement_scan_handle, scan_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new replacement scan through a factory.

        The scan starts out empty: configure it with `duckdb_v2_replacement_scan_set_callback` and optionally
        `duckdb_v2_replacement_scan_set_user_data`, then make it available with `duckdb_v2_connection_register_replacement_scan`, `duckdb_v2_instance_register_replacement_scan` or `duckdb_v2_extension_register_replacement_scan`. The caller owns the
        returned handle and must destroy it with `duckdb_v2_replacement_scan_destroy`, also after registration.

        The scan can only be registered on the database the factory belongs to.

        Args:
            factory: The factory to create the scan through.
            scan: On success, receives the newly created replacement scan. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_create(factory, scan.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_set_callback[err_origin: MutOrigin](
        self,
        scan: duckdb_v2_replacement_scan_handle,
        callback: duckdb_v2_replacement_scan_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the callback of the replacement scan.

        The callback is invoked during query planning for each table reference the catalog could not resolve. It can
        inspect the unresolved name via `duckdb_v2_replacement_scan_get_name`, and claim the
        reference via `duckdb_v2_replacement_scan_set_function_name`, `duckdb_v2_replacement_scan_set_collection` or
        `duckdb_v2_replacement_scan_set_subquery`; returning without claiming declines it. The context passed to the callback
        may be used to read settings, but not to run queries. A callback must be set before registration.

        Args:
            scan: The scan to set the callback of.
            callback: The callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_set_callback(scan, callback, err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_set_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        scan: duckdb_v2_replacement_scan_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets arbitrary user data on the replacement scan.

        Associates an opaque pointer with the scan, retrievable from the callback via
        `duckdb_v2_replacement_scan_get_user_data`. The opaque handle bundles the pointer with an optional destructor,
        invoked when the data is no longer needed, at the latest when the scan's scope ends. The callback may be
        invoked from several connections at once, so the data must be safe to read concurrently.

        Args:
            scan: The scan to set the user data of.
            data: Opaque handle bundling the user data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_set_user_data(scan, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_replacement_scan_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set via `duckdb_v2_replacement_scan_set_user_data`.

        Args:
            info: The info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_get_user_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_get_name[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_replacement_scan_info_handle,
        name: Pointer[duckdb_v2_qname_handle, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the name the catalog could not resolve.

        The name as written in the query, as a path: an unqualified reference has a single part, and a qualified one
        carries its catalog and schema before it -- see `duckdb_v2_qname_get_part`. For a file-backed reference the single
        part is the path with the quotes stripped. The returned name is owned by the caller and must be destroyed via
        `duckdb_v2_qname_destroy`; being owned, it may outlive the callback.

        Args:
            info: The info handle.
            name: Receives the unresolved name. Owned by the caller; destroy via `duckdb_v2_qname_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_get_name(info, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_set_function_name[err_origin: MutOrigin](
        self,
        info: duckdb_v2_replacement_scan_info_handle,
        name: duckdb_v2_qname_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Claims the reference by naming a table function to read instead.

        Arguments to the function are added with `duckdb_v2_replacement_scan_add_argument` and
        `duckdb_v2_replacement_scan_add_named_argument`. The name is borrowed and copied, and its parts are matched
        case-insensitively. A qualified name targets a function in a particular schema or catalog, exactly as writing
        it out in SQL would. The name is not resolved here: an unknown function fails later, when the replacement is
        bound. Calling this again replaces the previous name and keeps the arguments added so far.

        The three claim forms, `duckdb_v2_replacement_scan_set_function_name`, `duckdb_v2_replacement_scan_set_collection` and
        `duckdb_v2_replacement_scan_set_subquery`, are mutually exclusive: claiming the reference through a second, different
        form results in an error.

        Args:
            info: The info handle.
            name: The table function to read instead. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_set_function_name(info, name, err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_add_argument[err_origin: MutOrigin](
        self,
        info: duckdb_v2_replacement_scan_info_handle,
        value: duckdb_v2_value_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Appends a positional argument to the claimed table function.

        Positional arguments are passed in the order they are added, before any named ones. The value is borrowed and
        copied, so the caller may destroy it after the call. Requires `duckdb_v2_replacement_scan_set_function_name` to have
        been called first; otherwise the call results in an error.

        Args:
            info: The info handle.
            value: The argument value. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_add_argument(info, value, err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_add_named_argument[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_replacement_scan_info_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        value: duckdb_v2_value_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Appends a named argument to the claimed table function.

        Equivalent to writing `name := value` at the call site. The name and the value are borrowed and copied, so the
        caller may destroy the value after the call. Requires `duckdb_v2_replacement_scan_set_function_name` to have been
        called first; otherwise the call results in an error.

        Args:
            info: The info handle.
            name: The name of the parameter to bind the value to. Borrowed and copied.
            value: The argument value. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_add_named_argument(info, name.as_unsafe_any_origin(), value, err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_set_collection[column_names_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_replacement_scan_info_handle,
        collection: duckdb_v2_column_data_collection_handle,
        column_names: Pointer[duckdb_v2_identifier_t, column_names_origin],
        column_count: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Claims the reference by naming a column data collection to read instead.

        The collection is borrowed, not copied: the caller keeps ownership and must keep it alive, and must not clear,
        reset or destroy it, for as long as any result reading it is live, since the result scans its buffers directly.

        A prepared statement extends that lifetime well beyond its own results. Preparing a statement over a claimed
        name captures the borrow in the plan, and since a collection claim reads no database there is nothing to
        invalidate that plan: `duckdb_v2_prepared_statement_reuses_plan` reports true, and every later execution reuses the
        captured borrow without consulting the callback again. So dropping the name from whatever the callback resolves
        against does not release the collection, and releasing it while such a statement is live leaves the next
        execution reading freed memory. Destroy every prepared statement over a claimed name before clearing,
        resetting or destroying the collection behind it.

        By default the collection's columns are named col1..colN. Pass `column_names` to name them instead. When
        supplied, `column_count` must equal the collection's column count and no name may be empty; pass NULL and 0
        for the default names.

        The three claim forms, `duckdb_v2_replacement_scan_set_function_name`, `duckdb_v2_replacement_scan_set_collection` and
        `duckdb_v2_replacement_scan_set_subquery`, are mutually exclusive: claiming the reference through a second, different
        form results in an error.

        Args:
            info: The info handle.
            collection: The collection to read instead. Borrowed; the caller keeps ownership and must keep it alive.
            column_names: Optional. An array of `column_count` column names, in order. Pass NULL for the default names col1..colN.
            column_count: The number of names in `column_names`. Must equal the collection's column count, or 0 for the default names.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_set_collection(info, collection, column_names.as_unsafe_any_origin(), column_count, err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_set_subquery[sql_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_replacement_scan_info_handle,
        sql: Pointer[duckdb_v2_str, sql_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Claims the reference by naming a query to read instead.

        The text is parsed at the call and must contain exactly one SELECT statement: a syntax error, several
        statements or a statement of another kind results in an error. The text is borrowed for the call only. Prefer
        `duckdb_v2_replacement_scan_set_function_name` when a single table function call suffices, as it avoids the parse
        and keeps the plan flatter.

        The three claim forms, `duckdb_v2_replacement_scan_set_function_name`, `duckdb_v2_replacement_scan_set_collection` and
        `duckdb_v2_replacement_scan_set_subquery`, are mutually exclusive: claiming the reference through a second, different
        form results in an error.

        Args:
            info: The info handle.
            sql: The SELECT statement to read instead. Borrowed for the call only.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_set_subquery(info, sql.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_set_alias[alias__origin: ImmOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_replacement_scan_info_handle,
        alias_: Pointer[duckdb_v2_identifier_t, alias__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the alias the claimed replacement is bound under.

        Optional, and independent of the claim form. An alias written in the query takes precedence over this one;
        without either, the table name of the reference is used, which for a file-backed reference is the path. The
        alias is borrowed and copied.

        Args:
            info: The info handle.
            alias_: The alias to bind the replacement under. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_replacement_scan_set_alias(info, alias_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_register_replacement_scan[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        scan: duckdb_v2_replacement_scan_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the replacement scan, making it consulted for names the catalog cannot resolve.

        The scan is visible only to queries on this connection and is released when the connection is destroyed. It is
        consulted before every instance-wide scan, so it can claim a name that a built-in scan would otherwise take.
        Registration requires a callback. Scans are consulted in registration order within their scope, connection-scoped
        ones before instance-wide ones, and the first to claim a name wins. A scan cannot be registered twice, and a
        registered scan cannot be unregistered: it lives until its scope ends. The scan must have been created through a
        factory of the same database. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_replacement_scan_destroy`, which does not affect the registered scan.

        Args:
            conn: The connection to register on.
            scan: The replacement scan to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_register_replacement_scan(conn, scan, err.as_unsafe_any_origin())

    def duckdb_v2_instance_register_replacement_scan[err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        scan: duckdb_v2_replacement_scan_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the replacement scan, making it consulted for names the catalog cannot resolve.

        The scan is visible to every connection to the instance and lives until the instance is destroyed. Registering it
        while queries are binding on other connections is not thread-safe: register before issuing queries. Registration
        requires a callback. Scans are consulted in registration order within their scope, connection-scoped ones before
        instance-wide ones, and the first to claim a name wins. A scan cannot be registered twice, and a registered scan
        cannot be unregistered: it lives until its scope ends. The scan must have been created through a factory of the
        same database. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_replacement_scan_destroy`, which does not affect the registered scan.

        Args:
            instance: The instance to register on.
            scan: The replacement scan to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_register_replacement_scan(instance, scan, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_replacement_scan[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        scan: duckdb_v2_replacement_scan_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the replacement scan, making it consulted for names the catalog cannot resolve.

        The scan is visible to every connection to the loading extension's instance and lives until the instance is
        destroyed. Use this from the extension's load callback. Registration requires a callback. Scans are consulted in
        registration order within their scope, connection-scoped ones before instance-wide ones, and the first to claim a
        name wins. A scan cannot be registered twice, and a registered scan cannot be unregistered: it lives until its
        scope ends. The scan must have been created through a factory of the same database. The caller still owns the
        handle after registration and must destroy it with `duckdb_v2_replacement_scan_destroy`, which does not affect the
        registered scan.

        Args:
            extension: The loading extension.
            scan: The replacement scan to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_replacement_scan(extension, scan, err.as_unsafe_any_origin())

    def duckdb_v2_replacement_scan_destroy[scan_origin: MutOrigin](
        self,
        scan: Pointer[duckdb_v2_replacement_scan_handle, scan_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the replacement scan, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction. Destroying the handle after registration does not affect the registered scan.

        Args:
            scan: The scan to destroy.
        """
        return self._duckdb_v2_replacement_scan_destroy(scan.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Scalar
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_scalar_function_create[function__origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        function_: Pointer[duckdb_v2_scalar_function_handle, function__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new scalar function through a factory.

        The function starts out empty: configure it with the setter functions (e.g. `duckdb_v2_scalar_function_set_name`,
        `duckdb_v2_scalar_function_set_exec_callback`, etc.) and the signature obtained via `duckdb_v2_scalar_function_get_signature`,
        then make it available with `duckdb_v2_connection_register_scalar_function` or `duckdb_v2_extension_register_scalar_function`.
        The caller owns the returned handle and must destroy it with `duckdb_v2_scalar_function_destroy`, also after
        registration.

        The scalar function can only be registered on the database the factory belongs to.

        Args:
            factory: The factory to create the scalar function through.
            function_: On success, receives the newly created scalar function. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_create(factory, function_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_set_name[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the scalar function.

        The name is borrowed and copied. Calling this again replaces the previous name.
        A name must be set before registration.

        Args:
            function_: The function to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_set_name(function_, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_get_docs[docs_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        docs: Pointer[duckdb_v2_function_docs_handle, docs_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the documentation of the function so it can be filled in.

        Set a description with `duckdb_v2_function_docs_set_description`, and add examples and categories with
        `duckdb_v2_function_docs_add_example` and `duckdb_v2_function_docs_add_category`. The documentation is modified in place, describes this overload only, and is
        registered with the function. Optional.

        Args:
            function_: The function to get the documentation of.
            docs: The returned documentation. Borrowed and valid for the lifetime of the function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_get_docs(function_, docs.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_get_signature[sig_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        sig: Pointer[duckdb_v2_function_signature_handle, sig_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the function's signature so it can be configured.

        Add parameters with `duckdb_v2_function_signature_add_parameter` and set the return type with
        `duckdb_v2_function_signature_set_return_type`.
        The signature is modified in place; the function must be given a signature with a return type before
        registration.

        Args:
            function_: The function to get the signature of.
            sig: The returned signature. Borrowed and valid for the lifetime of the function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_get_signature(function_, sig.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_set_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets arbitrary user data on the scalar function.

        Associates an opaque pointer with the function, retrievable from the callbacks via
        `duckdb_v2_function_bind_get_user_data`, `duckdb_v2_scalar_function_init_get_user_data` and
        `duckdb_v2_scalar_function_exec_get_user_data`. The opaque handle bundles the pointer with an optional
        destructor, invoked when the data is no longer needed.

        Args:
            function_: The function to set the user data of.
            data: Opaque handle bundling the user data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_set_user_data(function_, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_set_property[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        key: DUCKDB_V2_FUNCTION_PROPERTY_KEY,
        value: DUCKDB_V2_FUNCTION_PROPERTY_VALUE,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets a property on the scalar function.

        Configures a function property that influences planning and execution, such as stability, NULL handling,
        fallibility or collation handling. The value must be one of the `duckdb_v2_FUNCTION_PROPERTY_VALUE` entries
        belonging to `key`; passing a value that does not belong to the key, or a key that is not valid for
        scalar functions, results in an error.

        Args:
            function_: The function to set the property of.
            key: The property to set.
            value: The value to set for the property. Must belong to `key`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_set_property(function_, key, value, err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_set_resolve_types_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        callback: duckdb_v2_scalar_function_resolve_types_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional resolve types callback of the scalar function.

        The resolve types callback is invoked during query planning for each call site of the function, before the
        arguments are cast to the parameter types of the signature. Through its `duckdb_v2_function_bind_info` it can
        inspect the argument types as they were passed and constant argument values. Through its
        `duckdb_v2_scalar_function_resolve_types_info` it can set a concrete return type. It cannot set "bind data", use the
        bind callback for that.

        Args:
            function_: The function to set the resolve types callback of.
            callback: The resolve types callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_set_resolve_types_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_set_bind_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        callback: duckdb_v2_scalar_function_bind_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional bind callback of the scalar function.

        The bind callback is invoked during query planning for each call site of the function, after the resolve
        types callback and after the arguments have been cast to the parameter types of the signature. Through its
        `duckdb_v2_function_bind_info` it can inspect the argument types and constant argument values. Through its
        `duckdb_v2_scalar_function_bind_info` it can set "bind data" that is shared with the init and exec callbacks. It
        cannot change the types of the call site, use the resolve types callback for that.

        Args:
            function_: The function to set the bind callback of.
            callback: The bind callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_set_bind_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_set_init_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        callback: duckdb_v2_scalar_function_init_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional init callback of the scalar function.

        The init callback is invoked at the start of execution for each thread that will execute the function.
        It can set worker-local "init data", retrievable from the exec callback, to keep mutable state across
        invocations of the function.

        Args:
            function_: The function to set the init callback of.
            callback: The init callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_set_init_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_set_exec_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_scalar_function_handle,
        callback: duckdb_v2_scalar_function_exec_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the exec callback of the scalar function.

        The exec callback implements the function's logic: it is invoked during query execution with a batch of
        input rows and must fill the result vector. An exec callback must be set before registration.

        Args:
            function_: The function to set the exec callback of.
            callback: The exec callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_set_exec_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_resolve_types_set_return_type[err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_resolve_types_info_handle,
        return_type: duckdb_v2_logical_type_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the concrete return type of the call site being bound.

        Overrides the return type declared in the signature. Register the function with an ANY return type and set
        the concrete type here, derived from the argument types, to build a function whose result type depends on
        its input. The type is borrowed and copied.

        Args:
            info: The resolve types info handle.
            return_type: The return type to set. Borrowed for the call only.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_resolve_types_set_return_type(info, return_type, err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_bind_set_bind_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_bind_info_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the function's "bind data" from the bind callback.

        The bind data is stored with the bound call site and retrievable from the init and exec callbacks. The opaque
        handle bundles the pointer with an optional destructor, invoked when the bind data is no longer needed,
        and an optional equality callback used when comparing two bound call sites; without one, pointer equality
        is used. Scalar functions set their bind data through this function, `duckdb_v2_function_bind_set_bind_data` is not
        available to them.

        Args:
            info: The bind info handle.
            data: Opaque handle bundling the bind data pointer plus optional destructor and equality callbacks.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_bind_set_bind_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_init_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_init_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set via `duckdb_v2_scalar_function_set_user_data`.

        Args:
            info: The init info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_init_get_user_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_init_get_bind_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_init_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the bind data set by the function's bind callback.

        Args:
            info: The init info handle.
            data: Receives the bind data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_init_get_bind_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_init_set_init_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_init_info_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the function's worker-local "init data" from the init callback.

        The init data is associated with the executing thread for the duration of the query and retrievable from
        the exec callback via `duckdb_v2_scalar_function_exec_get_init_data`. The opaque handle bundles the pointer with an
        optional destructor, invoked when the init data is no longer needed.

        Args:
            info: The init info handle.
            data: Opaque handle bundling the init data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_init_set_init_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_exec_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_exec_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set via `duckdb_v2_scalar_function_set_user_data`.

        Args:
            info: The exec info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_exec_get_user_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_exec_get_bind_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_exec_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the bind data set by the function's bind callback.

        Args:
            info: The exec info handle.
            data: Receives the bind data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_exec_get_bind_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_exec_get_init_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_exec_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the worker-local init data set by the function's init callback.

        Args:
            info: The exec info handle.
            data: Receives the init data pointer for the executing thread, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_exec_get_init_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_exec_get_row_count[count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_exec_info_handle,
        count: Pointer[idx_t, count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns how many rows this execution must produce. The exec callback
        must write exactly this many rows to the result vector. Note that this
        may be less than a full vector: with all-constant arguments the function
        is invoked for a single row and the result is expanded by the engine.

        Args:
            info: The exec info handle.
            count: Receives the number of rows.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_exec_get_row_count(info, count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_exec_get_arg_count[positional_fixed_origin: MutOrigin, positional_variadic_origin: MutOrigin, named_fixed_origin: MutOrigin, named_variadic_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_exec_info_handle,
        positional_fixed: Pointer[idx_t, positional_fixed_origin],
        positional_variadic: Pointer[idx_t, positional_variadic_origin],
        named_fixed: Pointer[idx_t, named_fixed_origin],
        named_variadic: Pointer[idx_t, named_variadic_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns how many argument vectors this invocation carries, split into the four parts of the argument list.

        The parts and their order are those the bind callback saw through `duckdb_v2_function_bind_get_arg_count`, and the
        vectors are at the same indices. Valid indices for `duckdb_v2_scalar_function_exec_get_arg` are [0, the sum of the four
        counts). Every out-parameter may be NULL, in which case nothing is written to it.

        Args:
            info: The exec info handle.
            positional_fixed: Optional. Receives the number of positional-only and standard parameters.
            positional_variadic: Optional. Receives the number of arguments `*args` received, 0 when the signature has none.
            named_fixed: Optional. Receives the number of named-only parameters.
            named_variadic: Optional. Receives the number of arguments `**kwargs` received, 0 when the signature has none.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_exec_get_arg_count(info, positional_fixed.as_unsafe_any_origin(), positional_variadic.as_unsafe_any_origin(), named_fixed.as_unsafe_any_origin(), named_variadic.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_exec_get_arg[vector_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_exec_info_handle,
        index: idx_t,
        vector: Pointer[duckdb_v2_vector_handle, vector_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the argument vector at the given index.

        The index is the one the bind callback used for the argument, e.g. the index `duckdb_v2_function_bind_get_arg_index`
        found for a name. The vector holds the argument's values for the current batch; use `duckdb_v2_scalar_function_exec_get_row_count` for the
        number of rows. Fails if the index is out of bounds. Borrowed; valid only for the duration of the callback.

        Args:
            info: The exec info handle.
            index: The index of the argument.
            vector: Receives the borrowed argument vector.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_exec_get_arg(info, index, vector.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_exec_get_result[vector_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_scalar_function_exec_info_handle,
        vector: Pointer[duckdb_v2_vector_handle, vector_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the result vector the exec callback must write into.

        The callback must write one entry per input row; use `duckdb_v2_scalar_function_exec_get_row_count` for the number of
        rows. Borrowed; valid only for the duration of the callback.

        Args:
            info: The exec info handle.
            vector: Receives the borrowed result vector to write into.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_scalar_function_exec_get_result(info, vector.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_register_scalar_function[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        function_: duckdb_v2_scalar_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the scalar function, making it available for use in SQL queries.

        The function is registered on the connection's database, visible to every connection, in the connection's
        transaction: inside an explicit transaction, it is invisible to other connections until the transaction commits,
        and a rollback undoes it. Registration requires a name, an exec callback, and a signature with a complete return
        type; an ANY return type is accepted only together with a resolve types callback that sets the concrete type per
        call site. The scalar function must have been created through a factory of the same database. The caller still
        owns the handle after registration and must destroy it with `duckdb_v2_scalar_function_destroy`, which does not affect
        the registered function.

        Args:
            conn: The connection to register on.
            function_: The scalar function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_register_scalar_function(conn, function_, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_scalar_function[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        function_: duckdb_v2_scalar_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the scalar function, making it available for use in SQL queries.

        The function is registered on the loading extension's database and attributed to the extension. Use this from the
        extension's load callback. Registration requires a name, an exec callback, and a signature with a complete return
        type; an ANY return type is accepted only together with a resolve types callback that sets the concrete type per
        call site. The scalar function must have been created through a factory of the same database. The caller still
        owns the handle after registration and must destroy it with `duckdb_v2_scalar_function_destroy`, which does not affect
        the registered function.

        Args:
            extension: The loading extension.
            function_: The scalar function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_scalar_function(extension, function_, err.as_unsafe_any_origin())

    def duckdb_v2_scalar_function_destroy[function__origin: MutOrigin](
        self,
        function_: Pointer[duckdb_v2_scalar_function_handle, function__origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the scalar function, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to
        prevent double-destruction. Destroying the handle after registration does not affect the registered
        function.

        Args:
            function_: The function to destroy.
        """
        return self._duckdb_v2_scalar_function_destroy(function_.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Function signature
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_function_signature_add_parameter[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        sig: duckdb_v2_function_signature_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        type_: duckdb_v2_logical_type_handle,
        value: duckdb_v2_value_handle,
        kind: DUCKDB_V2_FUNCTION_PARAMETER_KIND,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Adds a parameter to a signature.

        The kind decides how a caller passes the argument; see `duckdb_v2_FUNCTION_PARAMETER_KIND`. The signature keeps its
        parameters ordered by kind, and parameters of the same kind in the order they were added, so parameters of
        different kinds can be added in any order. A default value makes the parameter optional; `*args` and
        `**kwargs` cannot have one.

        Registration fails when two parameters share a name, when the signature has more than one `*args` or
        `**kwargs` parameter, or when a standard parameter without a default value follows one with a default value.

        Args:
            sig: The signature to configure.
            name: The parameter name. Borrowed and copied.
            type_: The parameter type. ANY accepts an argument of any type without casting it. Borrowed and copied.
            value: Optional default value, borrowed and copied. Will be cast to the parameter type.
            kind: How a caller passes the argument for the parameter.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_function_signature_add_parameter(sig, name.as_unsafe_any_origin(), type_, value, kind, err.as_unsafe_any_origin())

    def duckdb_v2_function_signature_set_return_type[err_origin: MutOrigin](
        self,
        sig: duckdb_v2_function_signature_handle,
        type_: duckdb_v2_logical_type_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the return type of a signature.

        Sets the signature's return type. The type is borrowed and copied.
        Calling this again overwrites the previous return type. An INVALID
        type is rejected with ERROR_INPUT_INVALID. Whether a concrete return
        type is required, and whether ANY is accepted, depends on the function
        family and is enforced when the signature is registered with a builder.

        Args:
            sig: The signature to configure.
            type_: The return type. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_function_signature_set_return_type(sig, type_, err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Table
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_table_function_create[function__origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        function_: Pointer[duckdb_v2_table_function_handle, function__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new table function through a factory.

        The function starts out empty: configure it with the setter functions (e.g. `duckdb_v2_table_function_set_name`,
        `duckdb_v2_table_function_set_exec_callback`, etc.) and the signature obtained via `duckdb_v2_table_function_get_signature`,
        then make it available with `duckdb_v2_connection_register_table_function` or `duckdb_v2_extension_register_table_function`.
        The caller owns the returned handle and must destroy it with `duckdb_v2_table_function_destroy`, also after
        registration.

        The table function can only be registered on the database the factory belongs to.

        Args:
            factory: The factory to create the table function through.
            function_: On success, receives the newly created table function. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_create(factory, function_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_name[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the table function.

        The name is borrowed and copied. Calling this again replaces the previous name.
        A name must be set before registration.

        Args:
            function_: The function to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_name(function_, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_get_docs[docs_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        docs: Pointer[duckdb_v2_function_docs_handle, docs_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the documentation of the function so it can be filled in.

        Set a description with `duckdb_v2_function_docs_set_description`, and add examples and categories with
        `duckdb_v2_function_docs_add_example` and `duckdb_v2_function_docs_add_category`. The documentation is modified in place,
        describes this overload only, and is registered with the function. Optional.

        Args:
            function_: The function to get the documentation of.
            docs: The returned documentation. Borrowed and valid for the lifetime of the function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_get_docs(function_, docs.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_get_signature[sig_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        sig: Pointer[duckdb_v2_function_signature_handle, sig_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the function's signature so it can be configured.

        Add parameters with `duckdb_v2_function_signature_add_parameter`. The signature is modified in place. A table
        function declares the columns it returns from its bind callback instead of through a return type, so
        registration rejects a signature whose return type was set with `duckdb_v2_function_signature_set_return_type`.

        Args:
            function_: The function to get the signature of.
            sig: The returned signature. Borrowed and valid for the lifetime of the function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_get_signature(function_, sig.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets arbitrary user data on the table function.

        Associates an opaque pointer with the function, retrievable from the callbacks via
        `duckdb_v2_function_bind_get_user_data`, `duckdb_v2_table_function_init_global_get_user_data`,
        `duckdb_v2_table_function_exec_get_user_data` and their counterparts on the other phases. The opaque handle
        bundles the pointer with an optional destructor, invoked when the data is no longer needed.

        Args:
            function_: The function to set the user data of.
            data: Opaque handle bundling the user data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_user_data(function_, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_bind_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_bind_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the bind callback of the table function.

        The bind callback is invoked during query planning for each call site of the function. It must declare the
        columns the function returns via `duckdb_v2_table_function_bind_add_result_column`. Through its
        `duckdb_v2_function_bind_info` it can also inspect the constant argument values and set "bind data" that is shared
        with all later callbacks. A bind callback must be set before registration.

        Args:
            function_: The function to set the bind callback of.
            callback: The bind callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_bind_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_init_global_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_init_global_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional global init callback of the table function.

        The global init callback is invoked once per scan, at the start of execution. It can set "global state"
        shared by every thread scanning the function, and declare how many threads may scan it in parallel via
        `duckdb_v2_table_function_init_global_set_max_threads`.

        Args:
            function_: The function to set the global init callback of.
            callback: The global init callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_init_global_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_init_local_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_init_local_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional local init callback of the table function.

        The local init callback is invoked once per thread that will scan the function. It can set worker-local
        "local state", retrievable from the exec callback, typically derived from the shared global state.

        Args:
            function_: The function to set the local init callback of.
            callback: The local init callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_init_local_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_exec_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_exec_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the exec callback of the table function.

        The exec callback implements the function's logic: it is invoked repeatedly during query execution and
        writes the next batch of rows to the output chunk, until it produces an empty batch to signal the end of
        the scan. An exec callback must be set before registration.

        Args:
            function_: The function to set the exec callback of.
            callback: The exec callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_exec_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_progress_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_progress_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional progress callback of the table function.

        The progress callback is invoked on demand during execution to report how far the scan has advanced, which
        the engine surfaces as the query's progress. It is invoked concurrently with the exec callback, so it must
        read the global state in a thread-safe way.

        Args:
            function_: The function to set the progress callback of.
            callback: The progress callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_progress_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_projection_pushdown[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        enable: Bool,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets whether the table function supports projection pushdown. Defaults to false.

        With projection pushdown, the engine asks the function for only the columns a query actually uses: the exec
        callback's output chunk holds one vector per requested column rather than one per column declared in bind,
        and the global init, local init and exec callbacks can look up which declared column each vector stands for
        via e.g. `duckdb_v2_table_function_exec_get_column_index`. Without it the output chunk always holds every declared
        column, and the engine drops the unused ones itself.

        Args:
            function_: The function to configure.
            enable: Whether the function supports projection pushdown.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_projection_pushdown(function_, enable, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_filter_pushdown_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_filter_pushdown_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional filter pushdown callback of the table function.

        The filter pushdown callback is invoked while the query is optimized, after the bind callback and before any
        init callback, with the filter predicates the query applies to the function's rows. Each predicate is a
        bound expression the callback can inspect with the `expression` functions; the callback accepts the
        predicates it will apply itself via `duckdb_v2_table_function_filter_pushdown_accept`, typically after
        recording what they select in the bind data. The engine then stops applying the accepted predicates and
        keeps applying the rest above the scan, so accepting a predicate is a promise to filter the rows exactly as
        it would have. The optimizer may invoke the callback more than once for the same query, each time with the
        predicates not yet accepted; it is not invoked when there are none.

        Args:
            function_: The function to set the filter pushdown callback of.
            callback: The filter pushdown callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_function_set_filter_pushdown_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_table_function_set_partition_data_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_table_function_handle,
        callback: duckdb_v2_table_function_partition_data_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional "partition data" callback of the table function.

        The callback reports, for the batch the exec callback just produced, an ordering batch index, the values of
