    def duckdb_v2_cast_function_set_implicit_cast_cost[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_cast_function_handle,
        cost: Int64,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets what it costs to apply this cast implicitly.

        The binder uses the cost to choose between candidate implicit casts: a lower non-negative cost makes the
        cast more likely to be picked, a higher one less likely. Built-in widening casts sit in the [0, 20] range,
        so a cost above 100 effectively puts this cast last. A negative cost -- the default -- means the cast is
        never applied implicitly and is reached only through an explicit CAST or TRY_CAST.

        Args:
            function_: The function to set the implicit cast cost of.
            cost: The cost. Negative disables implicit casting.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_cast_function_set_implicit_cast_cost(function_, cost, err.as_unsafe_any_origin())

    def duckdb_v2_cast_function_set_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_cast_function_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets arbitrary user data on the cast function.

        Associates an opaque pointer with the function, retrievable from the exec callback via
        `duckdb_v2_cast_function_exec_get_user_data`. The opaque handle bundles the pointer with an optional destructor,
        invoked when the data is no longer needed. The data is read-only during execution: the same pointer is
        shared by every thread running the cast.

        Args:
            function_: The function to set the user data of.
            data: Opaque handle bundling the user data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_cast_function_set_user_data(function_, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_cast_function_set_exec_callback[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_cast_function_handle,
        callback: duckdb_v2_cast_function_exec_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the exec callback of the cast function.

        The exec callback implements the conversion: it is invoked during query execution with a batch of input
        values and must fill the output vector. An exec callback must be set before registration.

        Args:
            function_: The function to set the exec callback of.
            callback: The exec callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_cast_function_set_exec_callback(function_, callback, err.as_unsafe_any_origin())

    def duckdb_v2_cast_function_exec_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_cast_function_exec_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set via `duckdb_v2_cast_function_set_user_data`.

        Args:
            info: The exec info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
