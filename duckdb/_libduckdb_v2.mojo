comptime DUCKDB_V2_LOGICAL_TYPE_ID_UUID: DUCKDB_V2_LOGICAL_TYPE_ID = 54
# Geometry (spatial extension).
comptime DUCKDB_V2_LOGICAL_TYPE_ID_GEOMETRY: DUCKDB_V2_LOGICAL_TYPE_ID = 60
