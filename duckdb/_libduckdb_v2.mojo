            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_copy_to_bind_get_file_path(info, path.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_copy_to_bind_get_column_count[count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_copy_to_bind_info_handle,
        count: Pointer[idx_t, count_origin],
