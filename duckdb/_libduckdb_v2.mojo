# ===--------------------------------------------------------------------===#
# Types: Column Data Collection
# ===--------------------------------------------------------------------===#


#! A column data collection represents a set of (buffer-managed) data chunks.
#!
#! You can append chunks to the collection iteratively, and then scan the collection back to retrieve the chunks in order.
#! DuckDB will manage the memory for the chunks, and transparently offload chunks to disk if necessary.
#! A collection shall not be scanned while it is being appended to, and vice versa.
#! A collection shall not be appended to concurrently, but it can be scanned concurrently by multiple threads using a shared scan state and per-thread worker scan states. For concurrent appends, consider creating multiple collections and "combining" them into one collection at the end.
struct _duckdb_v2_column_data_collection:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_column_data_collection_handle = Pointer[_duckdb_v2_column_data_collection, MutUntrackedOrigin]

#! Opaque state handle for shared state across multiple threads scanning a column data collection. This is used to coordinate work distribution, track global progress, or store any other state that needs to be shared across threads during the scan of the collection.
struct _duckdb_v2_column_data_collection_shared_scan_state:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_column_data_collection_shared_scan_state_handle = Pointer[_duckdb_v2_column_data_collection_shared_scan_state, MutUntrackedOrigin]

#! Opaque state handle for local state while scanning a column data collection. This is used to track progress and any other state that needs to be maintained on a per-thread basis across calls while scanning the collection. It also keeps the buffers backing the most recently scanned chunk alive: chunks are scanned zero-copy, so a scanned chunk's data is only valid until the worker state's next scan call or its destruction.
struct _duckdb_v2_column_data_collection_worker_scan_state:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_column_data_collection_worker_scan_state_handle = Pointer[_duckdb_v2_column_data_collection_worker_scan_state, MutUntrackedOrigin]

#! Opaque state handle for appending to a column data collection. This is used to track progress and any other state that needs to be maintained across calls while appending to the collection.
struct _duckdb_v2_column_data_collection_append_state:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_column_data_collection_append_state_handle = Pointer[_duckdb_v2_column_data_collection_append_state, MutUntrackedOrigin]


# ===--------------------------------------------------------------------===#
# Types: Expression
# ===--------------------------------------------------------------------===#


#! The type of a bound expression node. The values mirror the engine's own expression types, restricted to the
#! node types a filter predicate can contain; every other node type is reported as `EXPRESSION_TYPE_INVALID`.
#!
#! Comparisons, `BETWEEN` and casts are regular scalar function calls once bound: they have the function's
#! children and name, and only their type tells them apart from any other function. A `CAST` therefore has one
#! child, the value being cast, and its target type is the node's return type.
comptime DUCKDB_V2_EXPRESSION_TYPE = Int32
# A node type this API does not model. Its children can still be walked.
comptime DUCKDB_V2_EXPRESSION_TYPE_INVALID: DUCKDB_V2_EXPRESSION_TYPE = 0
# A cast. One child; the target type is the node's return type and `duckdb_v2_expression_cast_get_mode` tells a `TRY_CAST` apart.
comptime DUCKDB_V2_EXPRESSION_TYPE_OPERATOR_CAST: DUCKDB_V2_EXPRESSION_TYPE = 12
# Logical `NOT`. One child.
comptime DUCKDB_V2_EXPRESSION_TYPE_OPERATOR_NOT: DUCKDB_V2_EXPRESSION_TYPE = 13
# `IS NULL`. One child.
comptime DUCKDB_V2_EXPRESSION_TYPE_OPERATOR_IS_NULL: DUCKDB_V2_EXPRESSION_TYPE = 14
# `IS NOT NULL`. One child.
comptime DUCKDB_V2_EXPRESSION_TYPE_OPERATOR_IS_NOT_NULL: DUCKDB_V2_EXPRESSION_TYPE = 15
# `=`. Two children.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_EQUAL: DUCKDB_V2_EXPRESSION_TYPE = 25
# `<>`. Two children.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_NOTEQUAL: DUCKDB_V2_EXPRESSION_TYPE = 26
# `<`. Two children.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_LESSTHAN: DUCKDB_V2_EXPRESSION_TYPE = 27
# `>`. Two children.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_GREATERTHAN: DUCKDB_V2_EXPRESSION_TYPE = 28
# `<=`. Two children.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_LESSTHANOREQUALTO: DUCKDB_V2_EXPRESSION_TYPE = 29
# `>=`. Two children.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_GREATERTHANOREQUALTO: DUCKDB_V2_EXPRESSION_TYPE = 30
# `IN`. The first child is the value tested, the remaining children are the candidates.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_IN: DUCKDB_V2_EXPRESSION_TYPE = 35
# `NOT IN`. The first child is the value tested, the remaining children are the candidates.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_NOT_IN: DUCKDB_V2_EXPRESSION_TYPE = 36
# `IS DISTINCT FROM`. Two children.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_DISTINCT_FROM: DUCKDB_V2_EXPRESSION_TYPE = 37
# `BETWEEN`. Three children: the value tested, the lower bound and the upper bound.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_BETWEEN: DUCKDB_V2_EXPRESSION_TYPE = 38
# `IS NOT DISTINCT FROM`. Two children.
comptime DUCKDB_V2_EXPRESSION_TYPE_COMPARE_NOT_DISTINCT_FROM: DUCKDB_V2_EXPRESSION_TYPE = 40
# Logical `AND`. Two or more children.
comptime DUCKDB_V2_EXPRESSION_TYPE_CONJUNCTION_AND: DUCKDB_V2_EXPRESSION_TYPE = 50
# Logical `OR`. Two or more children.
comptime DUCKDB_V2_EXPRESSION_TYPE_CONJUNCTION_OR: DUCKDB_V2_EXPRESSION_TYPE = 51
# A constant. No children; read it with `duckdb_v2_expression_constant_get_value`.
comptime DUCKDB_V2_EXPRESSION_TYPE_VALUE_CONSTANT: DUCKDB_V2_EXPRESSION_TYPE = 75
# A prepared statement parameter whose value is not known yet. No children.
comptime DUCKDB_V2_EXPRESSION_TYPE_VALUE_PARAMETER: DUCKDB_V2_EXPRESSION_TYPE = 76
# A call to a scalar function other than the ones listed above. The children are its arguments; read the name with `duckdb_v2_expression_function_get_name`.
comptime DUCKDB_V2_EXPRESSION_TYPE_BOUND_FUNCTION: DUCKDB_V2_EXPRESSION_TYPE = 141
# A `CASE` expression. The children are each `WHEN` condition followed by its `THEN` result, then the `ELSE` result.
comptime DUCKDB_V2_EXPRESSION_TYPE_CASE_EXPR: DUCKDB_V2_EXPRESSION_TYPE = 150
# `COALESCE`. One or more children.
comptime DUCKDB_V2_EXPRESSION_TYPE_OPERATOR_COALESCE: DUCKDB_V2_EXPRESSION_TYPE = 152
# A reference to a column. No children; read it with `duckdb_v2_expression_column_ref_get_index`.
comptime DUCKDB_V2_EXPRESSION_TYPE_BOUND_COLUMN_REF: DUCKDB_V2_EXPRESSION_TYPE = 228

#! A borrowed opaque handle to a node of a bound expression tree. Read-only and owned by the engine: valid only
