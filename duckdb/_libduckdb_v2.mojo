    def duckdb_v2_connection_register_multi_file_function[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        function_: duckdb_v2_multi_file_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the multi-file function, making it available for use in SQL queries.

        The function is registered on the connection's database, visible to every connection, in the connection's
        transaction: inside an explicit transaction, it is invisible to other connections until the transaction commits,
        and a rollback undoes it. It can then be called with the path of a single file, a glob pattern, or a list of
        either, and accepts the options every multi-file function accepts (e.g. `filename`, `hive_partitioning`,
        `union_by_name`) next to the named parameters of the single-file function. Registration requires a name and a
        single-file function, and fails when no table function by that name is registered or it does not take the path of
        the file to read as its only positional parameter (see `duckdb_v2_multi_file_function_set_single_file_function`). The
        multi-file function must have been created through a factory of the same database. The caller still owns the
        handle after registration and must destroy it with `duckdb_v2_multi_file_function_destroy`, which does not affect the
        registered function.

        Args:
            conn: The connection to register on.
            function_: The multi-file function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_register_multi_file_function(conn, function_, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_multi_file_function[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        function_: duckdb_v2_multi_file_function_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the multi-file function, making it available for use in SQL queries.

        The function is registered on the loading extension's database and attributed to the extension. Use this from the
        extension's load callback. It can then be called with the path of a single file, a glob pattern, or a list of
        either, and accepts the options every multi-file function accepts (e.g. `filename`, `hive_partitioning`,
        `union_by_name`) next to the named parameters of the single-file function. Registration requires a name and a
        single-file function, and fails when no table function by that name is registered or it does not take the path of
        the file to read as its only positional parameter (see `duckdb_v2_multi_file_function_set_single_file_function`). The
        multi-file function must have been created through a factory of the same database. The caller still owns the
        handle after registration and must destroy it with `duckdb_v2_multi_file_function_destroy`, which does not affect the
        registered function.

        Args:
            extension: The loading extension.
            function_: The multi-file function to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_multi_file_function(extension, function_, err.as_unsafe_any_origin())

    def duckdb_v2_multi_file_function_destroy[function__origin: MutOrigin](
        self,
        function_: Pointer[duckdb_v2_multi_file_function_handle, function__origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the multi-file function, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction. Destroying the handle after registration does not affect the registered function.

        Args:
            function_: The function to destroy.
        """
        return self._duckdb_v2_multi_file_function_destroy(function_.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Identifier
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_identifier_render_quoted[name_origin: ImmOrigin, out_text_origin: MutOrigin, out_length_origin: MutOrigin, err_origin: MutOrigin](
        self,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        out_text: Pointer[c_char, out_text_origin],
        out_capacity: idx_t,
        out_length: Pointer[idx_t, out_length_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Renders a name as a SQL identifier, quoting and escaping only when required.

        Produces the SQL text for the name: the name itself when it is already a legal bare identifier, or the name
        double-quoted with interior double quotes doubled when it is a keyword or contains characters that require
        quoting. This is the engine's own identifier rendering, so the result parses back to a name equal to the
        input.

        Writes into a caller-supplied buffer, so nothing is allocated on the caller's behalf and nothing has to be
        freed. Pass out_text = NULL to size the buffer without rendering into it: out_length then receives the length,
        and out_capacity is ignored. With out_text != NULL, out_capacity must be at least out_length + 1, or the call
        returns ERROR_INPUT_OBJECT_SIZE with out_length set to the required length and out_text left untouched.

        out_length never counts the terminator, but a successful write always appends one, so the buffer is usable as
        a C string.

        Args:
            name: The name to render. Borrowed for the call only.
            out_text: Caller-owned buffer receiving the text plus a null terminator, or NULL to only report the required length in out_length.
            out_capacity: Bytes available in out_text, terminator included. Ignored when out_text is NULL.
            out_length: Receives the text length excluding the null terminator — written on success and on ERROR_INPUT_OBJECT_SIZE.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_identifier_render_quoted(name.as_unsafe_any_origin(), out_text.as_unsafe_any_origin(), out_capacity, out_length.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Instance
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_instance_create[out_instance_origin: MutOrigin, err_origin: MutOrigin](
        self,
        env: duckdb_v2_environment_handle,
        out_instance: Pointer[duckdb_v2_instance_handle, out_instance_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates an instance under the environment with no startup options.

        The instance is ready on return, with no database attached: attach one
        with `duckdb_v2_instance_attach` and pick the default with
        `duckdb_v2_instance_set_default`, or connect with `duckdb_v2_connection_create`.
        To choose an option that cannot change once the instance exists, such
        as access_mode, use `duckdb_v2_instance_create_with_options` instead. The
        caller destroys the instance via `duckdb_v2_instance_destroy`.

        Args:
            env: The environment.
            out_instance: Receives the new instance handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_create(env, out_instance.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_instance_create_with_options[option_names_origin: ImmOrigin, option_values_origin: ImmOrigin, out_instance_origin: MutOrigin, err_origin: MutOrigin](
        self,
        env: duckdb_v2_environment_handle,
        option_names: Pointer[duckdb_v2_str, option_names_origin],
        option_values: Pointer[duckdb_v2_str, option_values_origin],
        option_count: idx_t,
        out_instance: Pointer[duckdb_v2_instance_handle, out_instance_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates an instance under the environment, configured with startup
        options.

        Behaves as `duckdb_v2_instance_create`, applying the startup options first.

        Startup options are (name, value) pairs in two parallel arrays, the
        values in the textual form SQL `SET` accepts. They are the only way to
        choose an option that cannot change once the instance exists, such as
        access_mode or allow_unsigned_extensions; every other option can be
        written now or later through `duckdb_v2_instance_get_config`. An option that
        needs a running instance (the logging options, allowed_directories,
        allowed_paths, disabled_filesystems) returns ERROR_INPUT_INVALID here:
        write it through the instance's config after creation. A name no core
        option or loaded extension defines is kept for an extension to consume
        while the instance starts up, and creation fails with the names none
        claimed. The caller destroys the instance via `duckdb_v2_instance_destroy`.

        Args:
            env: The environment.
            option_names: Optional. An array of option_count option names (canonical or alias). Pass NULL when option_count is 0.
            option_values: Optional. An array of option_count values, parallel to option_names, in the textual form SQL `SET` accepts. Pass NULL when option_count is 0.
            option_count: The number of startup options.
            out_instance: Receives the new instance handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_create_with_options(env, option_names.as_unsafe_any_origin(), option_values.as_unsafe_any_origin(), option_count, out_instance.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_instance_destroy[instance_origin: MutOrigin](
        self,
        instance: Pointer[duckdb_v2_instance_handle, instance_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the instance handle.

        Always succeeds. Every attached database is closed with the instance.
        The instance itself stays alive for as long as any connection still
        references it; when the last reference drops, it is destroyed and its
        database files become available to open again. On success the handle
        is set to null. Safe to call on an already-null slot.

        Args:
            instance: The instance handle to destroy.
        """
        return self._duckdb_v2_instance_destroy(instance.as_unsafe_any_origin())

    def duckdb_v2_instance_attach[name_origin: ImmOrigin, path_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        path: Pointer[duckdb_v2_str, path_origin],
        options: duckdb_v2_attach_options_handle,
        make_default: Bool,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Attaches a database to the instance.

        Attaches the database at `path` exactly like `ATTACH 'path'`:
          - `:memory:` or an empty view attaches a fresh in-memory database.
          - any other path attaches that file, creating it if it does not
            exist.
        `name` is the name to attach under, like `ATTACH ... AS name`; it is
        how `duckdb_v2_instance_detach` and `duckdb_v2_instance_set_default` refer to the
        database. Null, or an empty view, derives the name from the path the
        way SQL `ATTACH` without `AS` does:
          - `memory` for `:memory:` or an empty view;
          - otherwise the file name up to its first `.`, without any `?query`
            parameters (`/data/sales.2024.db` attaches as `sales`), with
            `_db` appended when that is a reserved name such as `system` or
            `temp`.
        Naming is how two files with the same base name, or `:memory:` twice,
        attach side by side. `options`
        may be null; it carries the `(KEY value)` options of SQL `ATTACH`, for
        per-database options such as READ_ONLY, BLOCK_SIZE or ENCRYPTION_KEY,
        and must have been created from this instance handle. `make_default`
        makes the attached
        database the default for connections created afterwards, exactly as a
        `duckdb_v2_instance_set_default` call right after the attach would; otherwise the
        default is left alone. A path that is already attached on this or any
        other instance of the environment returns ERROR_RESOURCE_IN_USE, and a
        name that is already attached fails. Options that only apply at startup
        are passed to `duckdb_v2_instance_create_with_options`.

        Args:
            instance: The instance handle.
            name: Optional. The name to attach under; null or an empty view for the name derived from the path. Borrowed and copied.
            path: Path to the database file, or `:memory:` / an empty view for an in-memory database.
            options: Optional attach options created from `instance`, or null to attach with defaults under the derived name.
            make_default: Whether to make the attached database the default for connections created afterwards.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_attach(instance, name.as_unsafe_any_origin(), path.as_unsafe_any_origin(), options, make_default, err.as_unsafe_any_origin())

    def duckdb_v2_instance_detach[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Detaches the database attached under `name`.

        Detaches it like `DETACH`, checkpointing a file database first. Unlike
        SQL, the default database may be detached too; new connections then
        start without a default until `duckdb_v2_instance_set_default` names another, and
        existing connections bound to it keep it alive until their transaction
        on it ends and fail unqualified DDL afterwards. Returns
        ERROR_INPUT_INVALID when no database is attached under that name.
        Connections that still reference the database keep it alive until they
        release it.

        Args:
            instance: The instance handle.
            name: The name the database is attached under. Borrowed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_detach(instance, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_instance_set_default[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Makes the database attached under `name` the default database for
        connections created from now on.

        A connection binds to the default database when it is created, so this
        does not retarget existing connections: their default stays what it was
        when they connected, or what they chose with `USE`. The default is where
        unqualified DDL and unqualified table lookups that miss the temporary
        catalog go. It stays the default for new connections until another
        `duckdb_v2_instance_set_default` call or until it is detached; a connection whose
        default has been detached fails unqualified DDL with a message saying
        so until it selects another with `USE`. Returns ERROR_INPUT_INVALID when
        no database is attached under that name.

        Args:
            instance: The instance handle.
            name: The name the database is attached under. Borrowed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_set_default(instance, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_attach_options_create[out_options_origin: MutOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        out_options: Pointer[duckdb_v2_attach_options_handle, out_options_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates an empty set of attach options for use with `duckdb_v2_instance_attach` on
        `instance`.

        Starts empty. The caller destroys it via `duckdb_v2_attach_options_destroy`; the
        options may be destroyed as soon as the attach call returns, and reused
        for further attaches before that.

        Args:
            instance: The instance handle the options will be used with.
            out_options: Receives the new options handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_attach_options_create(instance, out_options.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_attach_options_set[key_origin: ImmOrigin, setting_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        options: duckdb_v2_attach_options_handle,
        key: Pointer[duckdb_v2_identifier_t, key_origin],
        setting: Pointer[duckdb_v2_str, setting_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets one attach option, like a `(KEY value)` entry of SQL `ATTACH`.

        The key is matched case-insensitively, as an unquoted SQL identifier
        is. The setting is passed on as the text a quoted SQL literal would
        produce: the engine casts the options it knows (READ_ONLY,
        RECOVERY_MODE, TYPE, DEFAULT_TABLE, VACUUM_REBUILD_INDEXES, BLOCK_SIZE,
        ENCRYPTION_KEY, ...) and hands the rest to the storage extension that
        ends up owning the database, which decides what they mean. Keys must be
        valid UTF-8; an unknown or ill-typed option fails the attach. Both views
        are borrowed and copied. Setting the same key again replaces it.

        Args:
            options: The attach options.
            key: The option name, e.g. READ_ONLY.
            setting: The option value, in the textual form a quoted SQL literal would carry.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_attach_options_set(options, key.as_unsafe_any_origin(), setting.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_attach_options_destroy[options_origin: MutOrigin](
        self,
        options: Pointer[duckdb_v2_attach_options_handle, options_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys an attach options handle.

        On success the slot is set to null. Safe to call on an already-null
        slot.

        Args:
            options: The attach options to destroy.
        """
        return self._duckdb_v2_attach_options_destroy(options.as_unsafe_any_origin())

    def duckdb_v2_library_version[out_version_origin: MutOrigin, err_origin: MutOrigin](
        self,
        out_version: Pointer[duckdb_v2_str, out_version_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the version of the linked DuckDB library.

        Args:
            out_version: The version string.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_library_version(out_version.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Log sink
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_log_sink_create[sink_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        sink: Pointer[duckdb_v2_log_sink_handle, sink_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new log sink through a factory.

        The log sink starts out empty: configure it with the setter functions, then make it available with
        `duckdb_v2_instance_register_log_sink` or `duckdb_v2_extension_register_log_sink`. The caller owns the returned handle and
        must destroy it with `duckdb_v2_log_sink_destroy`, also after registration.

        The log sink can only be registered on the instance the factory belongs to.

        Args:
            factory: The factory to create the log sink through.
            sink: On success, receives the newly created log sink. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_create(factory, sink.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_set_name[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        sink: duckdb_v2_log_sink_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name the logging configuration refers to the log sink by.

        Names are matched case-insensitively. The name is borrowed and copied. Calling this again replaces the previous
        name. A name must be set before registration.

        Args:
            sink: The log sink to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_set_name(sink, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_set_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        sink: duckdb_v2_log_sink_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets arbitrary user data on the log sink.

        Associates an opaque pointer with the sink, handed to its write and flush callbacks. The opaque handle bundles
        the pointer with an optional destructor, invoked when the data is no longer needed: when the instance is
        destroyed if the sink was registered, else when the log sink handle is.

        Args:
            sink: The log sink to set the user data of.
            data: Opaque handle bundling the user data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_set_user_data(sink, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_set_write_callback[err_origin: MutOrigin](
        self,
        sink: duckdb_v2_log_sink_handle,
        callback: duckdb_v2_log_sink_write_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the write callback of the log sink, invoked for every entry the logging configuration directs to the sink.

        The callback must return quickly, must be safe to run concurrently and on any thread, and must not log or change
        the logging configuration. A write callback must be set before registration.

        Args:
            sink: The log sink to set the write callback of.
            callback: The write callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_set_write_callback(sink, callback, err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_set_flush_callback[err_origin: MutOrigin](
        self,
        sink: duckdb_v2_log_sink_handle,
        callback: duckdb_v2_log_sink_flush_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional flush callback of the log sink, invoked when DuckDB flushes its log, so entries the sink holds
        on to can be written out. When DuckDB flushes is up to DuckDB; entries still held when the instance is destroyed
        are for the user data's destructor to write out.

        Like the write callback, it must be safe to run on any thread, and must not log or change the logging
        configuration.

        Args:
            sink: The log sink to set the flush callback of.
            callback: The flush callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_set_flush_callback(sink, callback, err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_write_info_get_connection_id[id_origin: MutOrigin, present_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_log_sink_write_info_handle,
        id: Pointer[idx_t, id_origin],
        present: Pointer[Bool, present_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the id of the connection that wrote the entry, as `duckdb_logs` reports it. An entry written for the
        database as a whole has none: `present` then receives false and `id` is left untouched.

        Args:
            info: The write info handle of the entry.
            id: Receives the connection id, if present.
            present: Receives whether the entry has a connection id.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_write_info_get_connection_id(info, id.as_unsafe_any_origin(), present.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_write_info_get_transaction_id[id_origin: MutOrigin, present_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_log_sink_write_info_handle,
        id: Pointer[idx_t, id_origin],
        present: Pointer[Bool, present_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the id of the transaction the entry was written in, as `duckdb_logs` reports it. An entry written
        outside a transaction has none: `present` then receives false and `id` is left untouched.

        Args:
            info: The write info handle of the entry.
            id: Receives the transaction id, if present.
            present: Receives whether the entry has a transaction id.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_write_info_get_transaction_id(info, id.as_unsafe_any_origin(), present.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_write_info_get_query_id[id_origin: MutOrigin, present_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_log_sink_write_info_handle,
        id: Pointer[idx_t, id_origin],
        present: Pointer[Bool, present_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the id of the query the entry was written for, as `duckdb_logs` reports it. An entry written outside
        a query has none: `present` then receives false and `id` is left untouched.

        Args:
            info: The write info handle of the entry.
            id: Receives the query id, if present.
            present: Receives whether the entry has a query id.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_write_info_get_query_id(info, id.as_unsafe_any_origin(), present.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_write_info_get_thread_id[id_origin: MutOrigin, present_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_log_sink_write_info_handle,
        id: Pointer[idx_t, id_origin],
        present: Pointer[Bool, present_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the id of the thread that wrote the entry, as `duckdb_logs` reports it. Only an entry written in the
        thread scope has one: otherwise `present` receives false and `id` is left untouched. The id identifies the
        thread that logged, which need not be the thread the write callback runs on.

        Args:
            info: The write info handle of the entry.
            id: Receives the thread id, if present.
            present: Receives whether the entry has a thread id.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_log_sink_write_info_get_thread_id(info, id.as_unsafe_any_origin(), present.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_instance_register_log_sink[err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        sink: duckdb_v2_log_sink_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the log sink on the instance, making it available to the logging configuration under its name.

        Registering does not direct any entries to the sink by itself; the logging configuration does. Registration is
        not transactional, requires a name and a write callback, and fails when the name is taken: by a sink DuckDB
        provides itself, such as `memory`, `stdout` or `file`, or by a sink registered before. The log sink must have
        been created through a factory of the same instance. Its user data passes to the registered sink. The caller
        still owns the handle after registration and must destroy it with `duckdb_v2_log_sink_destroy`, which does not
        affect the registered sink.

        Args:
            instance: The instance to register on.
            sink: The log sink to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_register_log_sink(instance, sink, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_log_sink[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        sink: duckdb_v2_log_sink_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the log sink on the loading extension's instance, making it available to the logging configuration
        under its name.

        Use this from the extension's load callback. Registration follows the rules of `duckdb_v2_instance_register_log_sink`.

        Args:
            extension: The loading extension.
            sink: The log sink to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_log_sink(extension, sink, err.as_unsafe_any_origin())

    def duckdb_v2_log_sink_destroy[sink_origin: MutOrigin](
        self,
        sink: Pointer[duckdb_v2_log_sink_handle, sink_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the log sink, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to
        prevent double-destruction. Destroying the handle after registration does not affect the registered sink.

        Args:
            sink: The log sink to destroy.
        """
        return self._duckdb_v2_log_sink_destroy(sink.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Logging
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_context_log[log_type_origin: ImmOrigin, message_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        ctx: duckdb_v2_context_handle,
        level: DUCKDB_V2_LOG_LEVEL,
        log_type: Pointer[duckdb_v2_str, log_type_origin],
        message: Pointer[duckdb_v2_str, message_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Writes a message to DuckDB's log.

        The entry is attributed to the context's connection scope, so it carries
        that connection's ids. Whether it is recorded at all is up to the
        database's log configuration: if logging is off, or level is below the
        configured threshold, or log_type is not among the enabled types, the
        call succeeds and writes nothing. An empty log_type selects the default
        type. Read entries back with `SELECT * FROM duckdb_logs`.

        Args:
            ctx: The context to log through.
            level: Severity of the message.
            log_type: The log type to record under, matched case-sensitively. Empty selects the default type.
            message: The message body. Borrowed for the call only.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_context_log(ctx, level, log_type.as_unsafe_any_origin(), message.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_instance_log[log_type_origin: ImmOrigin, message_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        level: DUCKDB_V2_LOG_LEVEL,
        log_type: Pointer[duckdb_v2_str, log_type_origin],
        message: Pointer[duckdb_v2_str, message_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Writes a message to DuckDB's log.

        The entry is attributed to the database scope: it carries no connection
        or query ids. Whether it is recorded at all is up to the
        database's log configuration: if logging is off, or level is below the
        configured threshold, or log_type is not among the enabled types, the
        call succeeds and writes nothing. An empty log_type selects the default
        type. Read entries back with `SELECT * FROM duckdb_logs`.

        Args:
            instance: The instance to log through.
            level: Severity of the message.
            log_type: The log type to record under, matched case-sensitively. Empty selects the default type.
            message: The message body. Borrowed for the call only.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_instance_log(instance, level, log_type.as_unsafe_any_origin(), message.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_log[log_type_origin: ImmOrigin, message_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        level: DUCKDB_V2_LOG_LEVEL,
        log_type: Pointer[duckdb_v2_str, log_type_origin],
        message: Pointer[duckdb_v2_str, message_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Writes a message to DuckDB's log.

        The entry is attributed to the connection scope, so it carries the
        connection's ids. Whether it is recorded at all is up to the
        database's log configuration: if logging is off, or level is below the
        configured threshold, or log_type is not among the enabled types, the
        call succeeds and writes nothing. An empty log_type selects the default
        type. Read entries back with `SELECT * FROM duckdb_logs`.

        Args:
            conn: The connection to log through.
            level: Severity of the message.
            log_type: The log type to record under, matched case-sensitively. Empty selects the default type.
            message: The message body. Borrowed for the call only.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_connection_log(conn, level, log_type.as_unsafe_any_origin(), message.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Custom type
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_custom_type_create[type__origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        type_: Pointer[duckdb_v2_custom_type_handle, type__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new custom type through a factory.

        The type starts out empty: configure it with `duckdb_v2_custom_type_set_name` and `duckdb_v2_custom_type_set_base_type`, then
        make it available with `duckdb_v2_connection_register_custom_type` or `duckdb_v2_extension_register_custom_type`. The caller
        owns the returned handle and must destroy it with `duckdb_v2_custom_type_destroy`, also after registration.

        The custom type can only be registered on the database the factory belongs to.

        Args:
            factory: The factory to create the custom type through.
            type_: On success, receives the newly created custom type. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_type_create(factory, type_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_type_set_name[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        type_: duckdb_v2_custom_type_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the custom type.

        This is the name the type is referred to by in SQL, and the alias carried by every logical type instance of
        it. The name is borrowed and copied. Calling this again replaces the previous name. A name must be set
        before registration.

        Args:
            type_: The type to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_type_set_name(type_, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_type_set_base_type[err_origin: MutOrigin](
        self,
        type_: duckdb_v2_custom_type_handle,
        base_type: duckdb_v2_logical_type_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the base type of the custom type.

        The custom type shares the base type's internal representation but is logically distinct, so it can carry
        its own cast functions. The type is borrowed and copied. Calling this again replaces the previous base type.
        A base type must be set before registration, and it must be a fully defined concrete type -- ANY is a
        signature wildcard, not something a registered type can be built on.

        Args:
            type_: The type to set the base type of.
            base_type: The logical type to base the custom type on. Borrowed for the call only.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_type_set_base_type(type_, base_type, err.as_unsafe_any_origin())

    def duckdb_v2_connection_register_custom_type[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        type_: duckdb_v2_custom_type_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the custom type, making it available for use in SQL queries.

        The type is registered on the connection's database, visible to every connection, in the connection's transaction:
        inside an explicit transaction, it is invisible to other connections until the transaction commits, and a rollback
        undoes it. Registration requires a name and a complete base type. The custom type must have been created through a
        factory of the same database. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_custom_type_destroy`, which does not affect the registered type.

        Args:
            conn: The connection to register on.
            type_: The custom type to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_register_custom_type(conn, type_, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_custom_type[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        type_: duckdb_v2_custom_type_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the custom type, making it available for use in SQL queries.

        The type is registered on the loading extension's database and attributed to the extension. Use this from the
        extension's load callback. Registration requires a name and a complete base type. The custom type must have been
        created through a factory of the same database. The caller still owns the handle after registration and must
        destroy it with `duckdb_v2_custom_type_destroy`, which does not affect the registered type.

        Args:
            extension: The loading extension.
            type_: The custom type to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_custom_type(extension, type_, err.as_unsafe_any_origin())

    def duckdb_v2_custom_type_destroy[type__origin: MutOrigin](
        self,
        type_: Pointer[duckdb_v2_custom_type_handle, type__origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the custom type, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction. Destroying the handle after registration does not affect the registered type.

        Args:
            type_: The type to destroy.
        """
        return self._duckdb_v2_custom_type_destroy(type_.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Logical Type
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_factory_create_type_from_id[param_names_origin: ImmOrigin, param_values_origin: ImmOrigin, out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        type_id: DUCKDB_V2_LOGICAL_TYPE_ID,
        param_names: Pointer[duckdb_v2_identifier_t, param_names_origin],
        param_values: Pointer[duckdb_v2_value_handle, param_values_origin],
        param_count: idx_t,
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a logical type from a type id plus value parameters.

        The id-keyed twin of factory_create_type_from_name: the type id names the
        kind, and the parameters bind it. With param_count 0 it instantiates a
        primitive directly, without touching the catalog: BOOLEAN,
        TINYINT..BIGINT, UTINYINT..UBIGINT, HUGEINT, UHUGEINT, FLOAT, DOUBLE,
        DATE, every TIME and TIMESTAMP variant, INTERVAL, VARCHAR, BLOB, BIT,
        BIGNUM, and UUID. ANY is accepted as well.

        ANY is a function-signature wildcard, constructible here so it can be
        passed to the function parameter and varargs setters, as a fixed-arity
        ANY parameter or an ANY varargs type. Data-creating surfaces reject it:
        value and data chunk creation, scalar and aggregate return types, table
        function result columns, cast source and target types, and custom type
        registration.

        With parameters, the id resolves to its canonical built-in type and binds
        through the same constructors as factory_create_type_from_name, so the parameterized
        kinds construct here too: decimal(width, scale); list(T); array(T, size);
        map(K, V); struct(fields); union(members); enum(entries); and varchar
        with a named "collation" parameter. Parameters are (name, value) pairs in
        two parallel arrays, exactly as for factory_create_type_from_name.

        Returns ERROR_INPUT_INVALID when param_count is 0 and the id needs
        parameters (DECIMAL, LIST, STRUCT, TUPLE, MAP, ARRAY, UNION, ENUM,
        VARIANT, GEOMETRY), for the bind-time-only ids (SQLNULL, UNKNOWN), for
        TYPE — construct that via factory_create_type_from_text — and for INVALID.

        Args:
            factory: The factory to resolve the type in.
            type_id: The type id to instantiate.
            param_names: Optional. An array of param_count parameter names; a {NULL, 0} entry is positional. Pass NULL for all-positional parameters.
            param_values: An array of param_count parameter values. Borrowed (copied in). Pass NULL when param_count is 0.
            param_count: The number of parameters. 0 instantiates a parameterless primitive.
            out_type: Receives the new logical type handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_factory_create_type_from_id(factory, type_id, param_names.as_unsafe_any_origin(), param_values.as_unsafe_any_origin(), param_count, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_factory_create_type_from_name[param_names_origin: ImmOrigin, param_values_origin: ImmOrigin, out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        name: duckdb_v2_qname_handle,
        param_names: Pointer[duckdb_v2_identifier_t, param_names_origin],
        param_values: Pointer[duckdb_v2_value_handle, param_values_origin],
        param_count: idx_t,
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a logical type from a type name plus value parameters.

        The generic constructor: resolves the name in the factory's catalog and
        binds it with the given parameters, exactly as SQL binds a type
        expression. Built-in parameterized kinds and registered extension types
        construct through this same call.

        An unqualified name is resolved along the search path first and then in
        the system catalog, which is where the built-in kinds live. A qualified
        name is resolved exactly as written, with no system-catalog fallback, so
        it names the type in that catalog or schema or fails.

        Parameters are (name, value) pairs in two parallel arrays. param_names
        may be NULL to make every parameter positional, and a {NULL, 0} entry
        makes that one parameter positional. Child types cross as TYPE values,
        built with value_create_type. The
        built-in shapes are: decimal(width, scale); list(T); array(T, size);
        map(K, V); struct(fields, as named or all-positional TYPE values);
        union(members, as named TYPE values); enum(entries, as VARCHAR values);
        and varchar with a named "collation" VARCHAR parameter.

        A name that resolves to a type with no bind function takes no parameters,
        and passing any fails. Bind errors — unknown name, wrong parameter count
        or types — surface from the call.

        Resolves in the scope of the factory: a connection's or callback's
        factory reaches the catalog, an instance's factory knows only the
        built-in types. A connection's factory looks up catalog types in the
        connection's transaction, or in one of its own when none is open. Through an
        instance's factory, only an unqualified built-in name resolves.

        The returned logical type is caller-owned and must be destroyed via
        logical_type_destroy. A type resolved from the catalog shares
        database-owned storage, such as an ENUM dictionary, so destroy it before
        closing the database. This is the inverse of
        logical_type_get_param_count / logical_type_get_param.

        Args:
            factory: The factory to resolve the type in.
            name: The type name to resolve. Parts are matched case-insensitively; qualify it to name a type in a particular catalog or schema.
            param_names: Optional. An array of param_count parameter names; a {NULL, 0} entry is positional. Pass NULL for all-positional parameters.
            param_values: An array of param_count parameter values. Borrowed (copied in). Pass NULL when param_count is 0.
            param_count: The number of parameters.
            out_type: Receives the new logical type handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_factory_create_type_from_name(factory, name, param_names.as_unsafe_any_origin(), param_values.as_unsafe_any_origin(), param_count, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_factory_create_type_from_text[text_origin: ImmOrigin, out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        text: Pointer[duckdb_v2_str, text_origin],
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a logical type by parsing SQL text.

        Parses a SQL type expression and returns the bound
        logical type. It accepts primitives ("INTEGER"), parameterized kinds
        ("DECIMAL(18,3)", "INTEGER[]", "STRUCT(a INTEGER, b VARCHAR)",
        "MAP(VARCHAR, INTEGER)", "INTEGER[3]", "UNION(i INTEGER, s VARCHAR)",
        "ENUM('a', 'b')"), and catalog-registered type names, both user-defined
        and from extensions. A catalog type name binds to its structural type,
        and the name is not preserved as an alias. Names are case-insensitive.
        Parse and bind errors surface from the call.

        Resolves in the scope of the factory: a connection's or callback's
        factory reaches the catalog, an instance's factory knows only the
        built-in types. A connection's factory looks up catalog types in the
        connection's transaction, or in one of its own when none is open. Text naming
        only built-in types never touches the catalog.

        The returned logical type is caller-owned and must be destroyed via
        logical_type_destroy. A type resolved from the catalog shares
        database-owned storage, such as an ENUM dictionary, so destroy it before
        closing the database. This is the inverse of logical_type_to_text for
        every constructible kind.

        Args:
            factory: The factory to resolve the type in.
            text: View of the SQL type expression to parse.
            out_type: Receives the new logical type handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_factory_create_type_from_text(factory, text.as_unsafe_any_origin(), out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_logical_type_copy[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        type_: duckdb_v2_logical_type_handle,
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a copy of a logical type.

        On success, writes the new caller-owned handle into *out_type; destroy it
        via logical_type_destroy.

        Args:
            type_: The logical type to copy.
            out_type: Receives the new logical type handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_logical_type_copy(type_, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_logical_type_destroy[type__origin: MutOrigin](
        self,
        type_: Pointer[duckdb_v2_logical_type_handle, type__origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a logical type handle.

        Null-safe: passing nullptr or a slot already set to nullptr is a
        no-op. On success the slot is set to nullptr.

        Args:
            type_: The logical type to destroy.
        """
        return self._duckdb_v2_logical_type_destroy(type_.as_unsafe_any_origin())

    def duckdb_v2_logical_type_is_equal[result_origin: MutOrigin, err_origin: MutOrigin](
        self,
        left: duckdb_v2_logical_type_handle,
        right: duckdb_v2_logical_type_handle,
        result: Pointer[Bool, result_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Compares two logical types for deep equality.

        Two types are equal when they agree in kind and in every parameter,
        recursively. DECIMAL(10, 2) equals DECIMAL(10, 2), but not DECIMAL(10, 3)
        and not FLOAT; two STRUCTs are equal when they have the same field names
        in the same order and equal field types.

        Args:
            left: The first logical type.
            right: The second logical type.
            result: Receives the result of the comparison.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_logical_type_is_equal(left, right, result.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_logical_type_get_id[out_id_origin: MutOrigin, err_origin: MutOrigin](
        self,
        type_: duckdb_v2_logical_type_handle,
        out_id: Pointer[DUCKDB_V2_LOGICAL_TYPE_ID, out_id_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the logical type id.

        Args:
            type_: The logical type.
            out_id: Receives the type id.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_logical_type_get_id(type_, out_id.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_logical_type_get_name[out_name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        type_: duckdb_v2_logical_type_handle,
        out_name: Pointer[duckdb_v2_identifier_t, out_name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the logical type's name.

        The alias when one is set — an extension or user-defined name such as
        "POINT_2D" — otherwise the canonical name of the type id, such as
        "INTEGER", "DECIMAL", or "TIMESTAMP WITH TIME ZONE". Never the empty
        view. This is exactly the name vocabulary create_type_from_name accepts.
        The view is valid until the logical type is destroyed; a canonical name
        points at static storage.

        Args:
            type_: The logical type.
            out_name: Receives a borrowed view of the name (alias when set, else the id's canonical name).
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_logical_type_get_name(type_, out_name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_logical_type_to_text[out_text_origin: MutOrigin, out_length_origin: MutOrigin, err_origin: MutOrigin](
        self,
        type_: duckdb_v2_logical_type_handle,
        out_text: Pointer[c_char, out_text_origin],
        out_capacity: idx_t,
        out_length: Pointer[idx_t, out_length_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Renders a logical type as SQL text.

        An aliased type renders as its alias, and create_type_from_text resolves
        that spelling only when the name is registered in the factory's
        catalog. The text round-trips through create_type_from_text for every
        constructible kind, with one exception: ANY renders as "ANY", but
        create_type_from_text cannot parse it back, since ANY is a signature
        wildcard rather than a parseable SQL type.

        Writes into a caller-supplied buffer, so nothing is allocated on the
        caller's behalf and nothing has to be freed. Pass out_text = NULL to size
        the buffer without rendering into it: out_length then receives the
        length, and out_capacity is ignored. With out_text != NULL, out_capacity
        must be at least out_length + 1, or the call returns
        ERROR_INPUT_OBJECT_SIZE with out_length set to the required length and
        out_text left untouched.

        out_length never counts the terminator, but a successful write always
        appends one, so the buffer is usable as a C string.

        Args:
            type_: The logical type.
            out_text: Caller-owned buffer receiving the text plus a null terminator, or NULL to only report the required length in out_length.
            out_capacity: Bytes available in out_text, terminator included. Ignored when out_text is NULL.
            out_length: Receives the text length excluding the null terminator — written on success and on ERROR_INPUT_OBJECT_SIZE.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_logical_type_to_text(type_, out_text.as_unsafe_any_origin(), out_capacity, out_length.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_logical_type_get_param_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        type_: duckdb_v2_logical_type_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of value parameters of a logical type.

        The inspection dual of create_type_from_name: these are the parameters
        that reconstruct the type through it. Per kind: DECIMAL 2 (width, scale);
        LIST 1 (element type); ARRAY 2 (element type, size); MAP 2 (key type,
        value type); STRUCT and TUPLE one per field; UNION one per member; ENUM
        one per dictionary entry; VARCHAR 1 when a collation is set, else 0;
        GEOMETRY 1 when a coordinate system is set, else 0; everything else 0. A
        bound type reports only what it actually carries, so a bind-time modifier
        that is not retained — an ignored VARCHAR length, say — does not
        reappear.

        Args:
            type_: The logical type.
            out_count: Receives the number of parameters.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_logical_type_get_param_count(type_, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_logical_type_get_param[out_name_origin: MutOrigin, out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        type_: duckdb_v2_logical_type_handle,
        index: idx_t,
        out_name: Pointer[duckdb_v2_identifier_t, out_name_origin],
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns one value parameter of a logical type.

        out_name receives a borrowed view of the parameter name — a STRUCT field
        name, a UNION member name, "collation" — or the empty view {NULL, 0} for
        a positional parameter. A non-empty view is valid until the logical type
        is destroyed. out_value receives an owned value, destroyed via
        value_destroy: child types come back as TYPE values (unwrap them with
        value_get_type), DECIMAL width and scale as UTINYINT, ARRAY size as
        BIGINT, and ENUM dictionary entries and collations as VARCHAR. An
        out-of-range index returns ERROR_INPUT_INVALID. Each call allocates one
        owned value.

        Args:
            type_: The logical type.
            index: The parameter index, in [0, param_count).
            out_name: Receives a borrowed view of the parameter name, or the empty view {NULL, 0} for a positional parameter.
            out_value: Receives the owned parameter value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_logical_type_get_param(type_, index, out_name.as_unsafe_any_origin(), out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_factory_create_type_with_alias[alias_name_origin: ImmOrigin, out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        base_type: duckdb_v2_logical_type_handle,
        alias_name: Pointer[duckdb_v2_identifier_t, alias_name_origin],
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a logical type that is an alias of another logical type.

        The alias keeps the base type's internal representation, so executing
        against it needs no special handling, while remaining logically distinct
        from the base type. Intended for custom type bind callbacks, where both
        the base type and the name come from the bind info.

        The alias is not registered anywhere, so this works through any
        factory. An empty alias name returns
        ERROR_INPUT_INVALID.

        Args:
            factory: The factory to resolve the type in.
            base_type: The logical type to alias. Typically the base type supplied in the custom type bind info.
            alias_name: The name for the resulting type. Typically the name of the custom type being constructed, also available from the bind info.
            out_type: Receives the new type: the base type's internal representation under the given alias name.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_factory_create_type_with_alias(factory, base_type, alias_name.as_unsafe_any_origin(), out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_factory_create_common_type[types_origin: ImmOrigin, out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        types: Pointer[duckdb_v2_logical_type_handle, types_origin],
        type_count: idx_t,
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates the common type of a set of logical types.

        The common type is the type every input implicitly casts to, resolved by
        the same rule a SQL list literal and value_create_list follow:
        INTEGER and BIGINT resolve to BIGINT, and DECIMAL(4,1) and DECIMAL(5,4)
        to DECIMAL(7,4). The types are combined pairwise from left to right, and
        the result is not guaranteed to be independent of their order.

        A connection's or a callback's factory also applies the casts that
        extensions registered, while an instance's factory knows only the
        built-in ones, so the two can resolve the same set differently. A single
        type resolves to a copy of itself.

        Returns ERROR_INPUT_INVALID for an empty set, for a NULL entry and for
        ANY, and ERROR_QUERY_NOT_IMPLEMENTED when the types have no common type.

        Args:
            factory: The factory to resolve the type in.
            types: An array of type_count logical types. Borrowed.
            type_count: The number of types. Must be at least 1.
            out_type: Receives the new logical type handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_factory_create_common_type(factory, types.as_unsafe_any_origin(), type_count, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Prepared Statement
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_prepared_statement_create[out_prepared_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        statement: duckdb_v2_sql_statement_handle,
        require_cacheable: Bool,
        out_prepared: Pointer[duckdb_v2_prepared_statement_handle, out_prepared_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Prepares a parsed statement into a reusable handle. Non-consuming.

        Copies the statement's AST, then binds and plans it once. Binder and catalog errors surface here, exactly as
        they would from `duckdb_v2_statement_execute`. The statement is borrowed rather than consumed, since a copy is what
        gets prepared, so it can be prepared again or executed directly; the caller destroys it with
        `duckdb_v2_sql_statement_destroy`.

        By default this succeeds for any preparable statement, whether or not its plan will be reused; ask
        `duckdb_v2_prepared_statement_reuses_plan` which one you got. Setting `require_cacheable` instead fails with
        `ERROR_INPUT_INVALID` when the plan would not be reused, so a caller who wants the handle only for the speedup
        finds out here rather than after silently taking the slow path.

        A statement that DuckDB expands into several, such as a dynamic PIVOT, is kept as written and expanded again at
        each execution, in the transaction state of that execution. It runs nothing here, its plan is never reused, and
        its result's metadata is deferred as for `duckdb_v2_statement_execute`. Parameters on such a statement are refused
        with `ERROR_INPUT_INVALID`.

        Refuses with `ERROR_RESOURCE_IN_USE` while a statement on the connection is still running. Drain, destroy, or
        interrupt that result first, or prepare on another connection. `*out_prepared` is set to NULL on failure.

        Args:
            conn: The connection supplying the catalog, transaction, and parser state. The prepared statement belongs to it.
            statement: The statement to prepare. Borrowed and copied, not consumed; destroy it with `duckdb_v2_sql_statement_destroy`.
            require_cacheable: When true, fail with `ERROR_INPUT_INVALID` unless the prepared plan will be reused across executions, as
                `duckdb_v2_prepared_statement_reuses_plan` would report it.
            out_prepared: On success, receives the new prepared statement. Owned by the caller; destroy via `duckdb_v2_prepared_statement_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_prepared_statement_create(conn, statement, require_cacheable, out_prepared.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_prepared_statement_execute[parameter_names_origin: ImmOrigin, parameter_values_origin: ImmOrigin, out_result_origin: MutOrigin, err_origin: MutOrigin](
        self,
        prepared: duckdb_v2_prepared_statement_handle,
        parameter_names: Pointer[duckdb_v2_identifier_t, parameter_names_origin],
        parameter_values: Pointer[duckdb_v2_value_handle, parameter_values_origin],
        parameter_count: idx_t,
        out_result: Pointer[duckdb_v2_result_handle, out_result_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Executes a prepared statement, streaming its result. Non-consuming.

        Returns a result without executing anything: execution happens incrementally as the result is stepped or
        drained, exactly as with `duckdb_v2_statement_execute`. The handle returned is an ordinary result, with identical
        behaviour throughout -- streaming, draining, the changed-row count of a DML statement, the output schema, the
        statement type, and the result type.

        `parameter_values` binds the statement's parameters as constants for this execution. Binding is positional by
        default ($1 = element 0); supply `parameter_names` to bind by name instead, where a non-empty entry binds its
        value to that named parameter ($name, matched case-insensitively) and a {NULL, 0} entry stays positional. Pass
        NULL for both arrays, or a count of 0, for a statement without parameters. Both arrays are borrowed and copied
        in, so the caller still owns and destroys them. A key set that does not match the statement's parameters is
        rejected with `ERROR_INPUT_INVALID`, with one exception: a named parameter left without a value reads the
        session variable of the same name (`SET VARIABLE`) when one exists.

        Not consumed: execute the same handle again, with the same values or different ones, as often as you like.
        Values are bound per execution and nothing carries over between them. A catalog change since the statement was
        prepared, or a parameter type that differs from the one the cached plan assumed, triggers a re-bind that is
        invisible apart from its cost.

        Refuses with `ERROR_RESOURCE_IN_USE` while a statement on the connection is still running; drain, destroy, or
        interrupt that result first, or execute on another connection. A failed execution, at any stage, leaves the prepared statement usable.
        `*out_result` is set to NULL on failure.

        Args:
            prepared: The prepared statement to execute. Borrowed; not consumed.
            parameter_names: Optional. An array of `parameter_count` parameter names; a non-empty entry binds its value to the named
                parameter ($name, case-insensitive), a {NULL, 0} entry keeps it positional ($1 = element 0). Pass NULL to
                bind everything positionally.
            parameter_values: Optional. An array of `parameter_count` values. Each binds by name when `parameter_names` supplies one, and
                positionally ($1 = element 0) otherwise. Borrowed and copied in. Pass NULL for a statement without
                parameters.
            parameter_count: The number of entries in `parameter_names` and `parameter_values`. Pass 0 for a statement without parameters.
            out_result: On success, receives the new result. Owned by the caller; destroy via `duckdb_v2_result_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_prepared_statement_execute(prepared, parameter_names.as_unsafe_any_origin(), parameter_values.as_unsafe_any_origin(), parameter_count, out_result.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_prepared_statement_reuses_plan[out_reuses_origin: MutOrigin, err_origin: MutOrigin](
        self,
        prepared: duckdb_v2_prepared_statement_handle,
        out_reuses: Pointer[Bool, out_reuses_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports whether the prepared statement reuses its compiled plan across executions.

        True when executions reuse the plan built at prepare time, provided the supplied values match the planned
        parameter types and nothing the plan depends on has changed; false when the statement re-binds on every
        execution, making it no faster than `duckdb_v2_statement_execute`. A plan is reused only when all parameter types
        were resolved at prepare time and the plan is cacheable: `SELECT 42` reuses, `SELECT $1::INTEGER + 1` reuses,
        a statement reading a base table does not (it re-binds so a catalog change is picked up), and `SELECT $1 + $2`
        does not (the types are unknown until values arrive).

        A static property of the built plan, fixed when the statement was prepared and independent of the values later
        passed to `duckdb_v2_prepared_statement_execute`.

        Args:
            prepared: The prepared statement to inspect.
            out_reuses: Receives true when the compiled plan is reused across executions, false when the statement re-binds each time.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_prepared_statement_reuses_plan(prepared, out_reuses.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_prepared_statement_destroy[prepared_origin: MutOrigin](
        self,
        prepared: Pointer[duckdb_v2_prepared_statement_handle, prepared_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a prepared statement.

        Null-safe: passing NULL, or a slot already set to NULL, is a no-op. A result produced by
        `duckdb_v2_prepared_statement_execute` is independently owned and keeps the session alive itself, so the prepared
        statement may be destroyed while results made from it are still live. On success the slot is set to NULL.

        Args:
            prepared: The prepared statement to destroy.
        """
        return self._duckdb_v2_prepared_statement_destroy(prepared.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Query metrics
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_connection_get_query_metrics[metrics_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        metrics: Pointer[duckdb_v2_query_metrics_handle, metrics_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Takes a snapshot of the metrics of the last query the connection finished.

        The snapshot is owned by the caller and does not change afterwards. It holds the metrics DuckDB's profiling
        configuration gathered: without profiling enabled, the root node carries no metrics and has no children. A
        snapshot is not promised to be complete; any metric, and any operator node, may be missing.

        Fails with `ERROR_RESOURCE_IN_USE` while a query is running on the connection, i.e. while a result of it has
        not yet been drained or destroyed.

        Args:
            conn: The connection to take the snapshot of.
            metrics: On success, receives the owned snapshot. Destroy via `duckdb_v2_query_metrics_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_get_query_metrics(conn, metrics.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_enable_profiling[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        enabled: Bool,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Enables or disables profiling for the queries the connection runs from now on.

        While profiling is enabled, DuckDB gathers the metrics `duckdb_v2_connection_get_query_metrics` reports. Profiling also
        prints the profile of every query, as configured by the `enable_profiling` and `profiling_output` options, which
        by default print a query tree to the standard output: set `enable_profiling` to `no_output` to only gather the
        metrics. Disabling profiling stops both.

        Args:
            conn: The connection to enable or disable profiling for.
            enabled: Whether to enable profiling.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_enable_profiling(conn, enabled, err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_get_root[node_origin: MutOrigin, err_origin: MutOrigin](
        self,
        metrics: duckdb_v2_query_metrics_handle,
        node: Pointer[duckdb_v2_query_metrics_node_handle, node_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the root node of the snapshot, which describes the query as a whole. Its children, if any, describe
        the operators that executed the query.

        Args:
            metrics: The snapshot.
            node: Receives the borrowed root node. Valid until the snapshot is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_query_metrics_get_root(metrics, node.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_node_get_name[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        node: duckdb_v2_query_metrics_node_handle,
        name: Pointer[duckdb_v2_str, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the name of the node: `QUERY` for the root node, and the name of the operator, e.g. `TABLE_SCAN`, for
        the other nodes.

        Args:
            node: The node.
            name: Receives a borrowed view of the name. Valid until the snapshot is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_query_metrics_node_get_name(node, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_node_get_child_count[count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        node: duckdb_v2_query_metrics_node_handle,
        count: Pointer[idx_t, count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of children of the node. Valid indices for `duckdb_v2_query_metrics_node_get_child` are
        [0, count).

        Args:
            node: The node.
            count: Receives the number of children.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_query_metrics_node_get_child_count(node, count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_node_get_child[child_origin: MutOrigin, err_origin: MutOrigin](
        self,
        node: duckdb_v2_query_metrics_node_handle,
        index: idx_t,
        child: Pointer[duckdb_v2_query_metrics_node_handle, child_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the child of the node at index. An out-of-range index is rejected with `ERROR_INPUT_OUT_OF_RANGE`.

        Args:
            node: The node.
            index: Zero-based child index.
            child: Receives the borrowed child. Valid until the snapshot is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_query_metrics_node_get_child(node, index, child.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_node_get_metric_count[count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        node: duckdb_v2_query_metrics_node_handle,
        count: Pointer[idx_t, count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of metrics the node carries. Valid indices for `duckdb_v2_query_metrics_node_get_metric_name` and
        `duckdb_v2_query_metrics_node_get_metric_value` are [0, count); the order of the metrics is unspecified.

        Args:
            node: The node.
            count: Receives the number of metrics.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_query_metrics_node_get_metric_count(node, count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_node_get_metric_name[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        node: duckdb_v2_query_metrics_node_handle,
        index: idx_t,
        name: Pointer[duckdb_v2_str, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the name of the metric at index, e.g. `query.total_time`. An out-of-range index is rejected with
        `ERROR_INPUT_OUT_OF_RANGE`.

        Args:
            node: The node.
            index: Zero-based metric index.
            name: Receives a borrowed view of the name. Valid until the snapshot is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_query_metrics_node_get_metric_name(node, index, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_node_get_metric_value[value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        node: duckdb_v2_query_metrics_node_handle,
        index: idx_t,
        value: Pointer[duckdb_v2_value_handle, value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the value of the metric at index, a number such as a UBIGINT count or a DOUBLE duration. An
        out-of-range index is rejected with `ERROR_INPUT_OUT_OF_RANGE`.

        Args:
            node: The node.
            index: Zero-based metric index.
            value: Receives the owned value. Destroy via `duckdb_v2_value_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_query_metrics_node_get_metric_value(node, index, value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_node_get_metric[name_origin: ImmOrigin, value_origin: MutOrigin, present_origin: MutOrigin, err_origin: MutOrigin](
        self,
        node: duckdb_v2_query_metrics_node_handle,
        name: Pointer[duckdb_v2_str, name_origin],
        value: Pointer[duckdb_v2_value_handle, value_origin],
        present: Pointer[Bool, present_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Looks up a metric of the node by name, e.g. `query.total_time`. When the node does not carry it, `present`
        receives false and `value` receives null.

        Args:
            node: The node.
            name: The name of the metric, matched exactly. Borrowed for the call only.
            value: Receives the owned value, if present. Destroy via `duckdb_v2_value_destroy`.
            present: Receives whether the node carries the metric.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_query_metrics_node_get_metric(node, name.as_unsafe_any_origin(), value.as_unsafe_any_origin(), present.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_query_metrics_destroy[metrics_origin: MutOrigin](
        self,
        metrics: Pointer[duckdb_v2_query_metrics_handle, metrics_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the snapshot, releasing its resources and invalidating the nodes borrowed from it.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction.

        Args:
            metrics: The snapshot to destroy.
        """
        return self._duckdb_v2_query_metrics_destroy(metrics.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Qname
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_qname_parse[text_origin: ImmOrigin, name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        text: Pointer[duckdb_v2_str, text_origin],
        name: Pointer[duckdb_v2_qname_handle, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Parses SQL text into a qualified name.

        Applies the engine's qualified-name rules: dots separate parts, and a double-quoted part may contain dots and
        doubled interior quotes. More than three parts and an unterminated quote are rejected with the parser's own
        error. Invalid UTF-8 and text without at least one non-empty part are rejected with `ERROR_INPUT_INVALID`.
        When the parts are already separate, build the name with `duckdb_v2_qname_create` rather than joining them and parsing
        the result.

        Args:
            text: The name text to parse. Borrowed for the call only.
            name: On success, receives the qualified name. Owned by the caller; destroy via `duckdb_v2_qname_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_qname_parse(text.as_unsafe_any_origin(), name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_qname_create[parts_origin: ImmOrigin, name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        parts: Pointer[duckdb_v2_identifier_t, parts_origin],
        part_count: idx_t,
        name: Pointer[duckdb_v2_qname_handle, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a qualified name from its parts.

        The parts are ordered outermost first, so the last one is the object name. Between one and three parts are
        accepted -- the engine qualifies at most catalog.schema.name today -- and every part must be non-empty:
        partial qualification is expressed by passing fewer parts, never by empty placeholders. Zero parts, more than
        three, and an empty part are all rejected with `ERROR_INPUT_INVALID`. The parts are borrowed and copied.

        Args:
            parts: An array of `part_count` non-empty identifier views, outermost first.
            part_count: The number of parts, between one and three.
            name: On success, receives the qualified name. Owned by the caller; destroy via `duckdb_v2_qname_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_qname_create(parts.as_unsafe_any_origin(), part_count, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_qname_get_part_count[count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        name: duckdb_v2_qname_handle,
        count: Pointer[idx_t, count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns how many parts the qualified name has.

        Always at least one. Valid indices for `duckdb_v2_qname_get_part` are [0, count), and the object name is the part at
        count - 1.

        Args:
            name: The qualified name.
            count: Receives the number of parts.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_qname_get_part_count(name, count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_qname_get_part[part_origin: MutOrigin, err_origin: MutOrigin](
        self,
        name: duckdb_v2_qname_handle,
        index: idx_t,
        part: Pointer[duckdb_v2_identifier_t, part_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows one part of the qualified name.

        Parts are ordered outermost first, so the object name is the part at `duckdb_v2_qname_get_part_count` - 1. The view
        is valid until the qualified name is destroyed. An index outside [0, count) is rejected with
        `ERROR_INPUT_OUT_OF_RANGE`.

        Args:
            name: The qualified name.
            index: Zero-based part index.
            part: Receives a borrowed view of the part, valid until the qualified name is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_qname_get_part(name, index, part.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_qname_render[out_text_origin: MutOrigin, out_length_origin: MutOrigin, err_origin: MutOrigin](
        self,
        name: duckdb_v2_qname_handle,
        out_text: Pointer[c_char, out_text_origin],
        out_capacity: idx_t,
        out_length: Pointer[idx_t, out_length_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Renders the qualified name as SQL text.

        Joins the parts with dots, quoting and escaping each one only where the identifier requires it, so the result
        parses back through `duckdb_v2_qname_parse` to an equal name.

        Writes into a caller-supplied buffer, so nothing is allocated on the caller's behalf and nothing has to be
        freed. Pass out_text = NULL to size the buffer without rendering into it: out_length then receives the length,
        and out_capacity is ignored. With out_text != NULL, out_capacity must be at least out_length + 1, or the call
        returns ERROR_INPUT_OBJECT_SIZE with out_length set to the required length and out_text left untouched.

        out_length never counts the terminator, but a successful write always appends one, so the buffer is usable as
        a C string.

        Args:
            name: The qualified name to render.
            out_text: Caller-owned buffer receiving the text plus a null terminator, or NULL to only report the required length in out_length.
            out_capacity: Bytes available in out_text, terminator included. Ignored when out_text is NULL.
            out_length: Receives the text length excluding the null terminator — written on success and on ERROR_INPUT_OBJECT_SIZE.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_qname_render(name, out_text.as_unsafe_any_origin(), out_capacity, out_length.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_qname_equals[result_origin: MutOrigin, err_origin: MutOrigin](
        self,
        left: duckdb_v2_qname_handle,
        right: duckdb_v2_qname_handle,
        result: Pointer[Bool, result_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Compares two qualified names.

        True when both have the same number of parts and every part matches case-insensitively, which is the engine's
        own identifier equality: casing never distinguishes two names. This is the only way to compare names; two
        handles holding equal names are still distinct pointers.

        Args:
            left: The first qualified name.
            right: The second qualified name.
            result: Receives whether the two names are equal.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_qname_equals(left, right, result.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_qname_hash[hash_origin: MutOrigin, err_origin: MutOrigin](
        self,
        name: duckdb_v2_qname_handle,
        hash: Pointer[UInt64, hash_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Hashes a qualified name.

        Consistent with `duckdb_v2_qname_equals`: names that compare equal hash equal, casing differences included. The value
        is not stable across processes or library versions, so use it for in-process lookup tables only and never
        persist it.

        Args:
            name: The qualified name to hash.
            hash: Receives the hash value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_qname_hash(name, hash.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_qname_destroy[name_origin: MutOrigin](
        self,
        name: Pointer[duckdb_v2_qname_handle, name_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the qualified name, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction. Any part views borrowed from it become dangling.

        Args:
            name: The qualified name to destroy.
        """
        return self._duckdb_v2_qname_destroy(name.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Query Result
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_statement_execute[parameter_names_origin: ImmOrigin, parameter_values_origin: ImmOrigin, out_result_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        statement: duckdb_v2_sql_statement_handle,
        parameter_names: Pointer[duckdb_v2_identifier_t, parameter_names_origin],
        parameter_values: Pointer[duckdb_v2_value_handle, parameter_values_origin],
        parameter_count: idx_t,
        out_result: Pointer[duckdb_v2_result_handle, out_result_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Executes a parsed statement on the connection, streaming its result. Non-consuming.

        Takes a statement produced by the sql_statement module (parse_sql /
        statement_iterator_next), preprocesses and prepares it, and returns a
        result handle without executing anything: execution happens incrementally
        as the result is stepped (result_step) or drained (result_fetch_chunk).
        This call reports only the errors detectable at prepare time — binder,
        catalog, pragma preprocessing — while errors raised during execution
        surface from the stepping functions.

        The statement is borrowed, not consumed, since a copy is what executes.
        It can be executed again, for example with a different set of values, and
        the caller destroys it with sql_statement_destroy.

        parameter_values binds the statement's parameters as constants for this
        execution. Binding is positional by default: the i-th value binds $(i+1),
        matching SQL's own convention, so dense $1..$N and ? placeholders work
        directly. Supply parameter_names to bind by name instead — a non-empty
        name binds its value to that named parameter ($name, matched
        case-insensitively), while a {NULL, 0} entry leaves that value
        positional. The parameter schema from statement_bind lists the names to
        use. Both arrays are borrowed and copied in; the caller still owns and
        destroys them. Pass NULL for both, or a count of 0, for an
        unparameterized statement. A key set that does not match the statement's
        parameters — names for a positional statement, or the reverse — is
        rejected with ERROR_INPUT_INVALID, and named and positional parameters
        cannot be mixed within one statement. Parameters and statement expansion
        are mutually exclusive: passing values for a statement that preprocesses
        into a group is rejected with ERROR_INPUT_INVALID.

        DuckDB can expand one statement into a group: a dynamic PIVOT, or
        statement-expanding DDL such as ALTER ... ADD COLUMN with a non-constant
        DEFAULT. The group executes as one result through the same steps, and the
        stream surfaces the rows of the first row-producing statement of the
        group. A row-producing statement followed by another cannot be served as
        a single result and reports ERROR_QUERY_NOT_IMPLEMENTED; no known
        expansion produces one.

        One running statement per connection: this refuses with
        ERROR_RESOURCE_IN_USE while a statement on the connection is still
        running. Drain, destroy, or interrupt that result first, or open another
        connection.

        Schema metadata — result type, statement type, column count, names,
        logical types — is available on the returned handle immediately, before
        the first step.

        *out_result is set to nullptr on failure.

        Args:
            conn: The connection on which to execute the statement.
            statement: The statement to execute. Borrowed and copied; not consumed. Destroy it with sql_statement_destroy.
            parameter_names: Optional. An array of parameter_count parameter names; a non-empty entry binds its value to the named parameter ($name, case-insensitive), a {NULL, 0} entry keeps it positional ($1 = element 0). Pass NULL for all-positional binding. Named and positional parameters cannot be mixed within one statement.
            parameter_values: Optional. An array of parameter_count value handles. Each binds by name when parameter_names supplies one, otherwise positionally ($1 = element 0). Borrowed (copied in). Pass NULL for an unparameterized statement.
            parameter_count: The number of parameters in parameter_names and parameter_values. Pass 0 for an unparameterized statement.
            out_result: Receives the new result handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_statement_execute(conn, statement, parameter_names.as_unsafe_any_origin(), parameter_values.as_unsafe_any_origin(), parameter_count, out_result.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_result_destroy[result_origin: MutOrigin](
        self,
        result: Pointer[duckdb_v2_result_handle, result_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a result handle.

        Null-safe: passing nullptr or a slot already set to nullptr is a no-op.
        Frees the memory the result owns and releases the connection for its next
        query. Safe at any point in the stream's life. Destroying a result before
        its statement ended (drained, or stepped to FINISHED) aborts the
        statement. On autocommit, its writes are rolled back. Inside a
        transaction, a statement that may write invalidates the transaction, and
        a read-only statement just stops. Chunks already fetched are
        caller-owned and stay valid. On success the slot is set to nullptr.

        Args:
            result: The result to destroy.
        """
        return self._duckdb_v2_result_destroy(result.as_unsafe_any_origin())

    def duckdb_v2_result_step[out_chunk_origin: MutOrigin, out_status_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_result_handle,
        out_chunk: Pointer[duckdb_v2_data_chunk_handle, out_chunk_origin],
        out_status: Pointer[DUCKDB_V2_RESULT_STEP_STATUS, out_status_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Runs one bounded unit of query execution and returns without blocking.

        The streaming primitive: a step does a bounded amount of execution work,
        mostly without blocking, and returns control to the caller, so an event
        loop stays responsive and can interleave other work between steps. The
        conveniences — result_wait, result_fetch_chunk, result_drain — block, and
        are for synchronous callers. out_status reports the outcome:

        - CHUNK: *out_chunk receives a caller-owned chunk (destroy via
          data_chunk_destroy). Written only for this status; nullptr otherwise.
        - WAITING: no chunk yet, but work was done. Transient: keep stepping and
          it resolves to CHUNK, FINISHED, CANCELLED, or an error. Block in
          result_wait rather than busy-stepping.
        - FINISHED: stream exhausted. Sticky.
        - CANCELLED: query interrupted via connection_interrupt. Sticky.
          Cancellation is a status here, not an error; result_fetch_chunk, which
          has no status out-param, reports it as ERROR_RUNTIME_INTERRUPT.

        Execution errors come back as the return code plus err, never as a
        status; out_status is then unspecified and *out_chunk is nullptr. Errors
        are sticky, so later steps report the same code.

        Args:
            result: The result to step.
            out_chunk: Receives an owned chunk if *out_status is CHUNK; set to nullptr otherwise.
            out_status: Receives the step status.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_result_step(result, out_chunk.as_unsafe_any_origin(), out_status.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_result_fetch_chunk[out_chunk_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_result_handle,
        out_chunk: Pointer[duckdb_v2_data_chunk_handle, out_chunk_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Blocks until the next chunk is available and returns it.

        A convenience over result_step: blocks until a chunk is produced or the
        stream ends. On success *out_chunk receives a caller-owned chunk (destroy
        via data_chunk_destroy), or nullptr at end-of-stream. End-of-stream is
        sticky, so later calls keep succeeding with *out_chunk set to nullptr.

        An interrupted query returns ERROR_RUNTIME_INTERRUPT — the same event
        result_step reports as status CANCELLED, carried on the error channel
        because this function has no status out-param.

        On failure *out_chunk is set to nullptr. Errors are sticky, so later
        calls report the same code.

        Args:
            result: The result to fetch from.
            out_chunk: Receives an owned chunk, or nullptr at end-of-stream.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_result_fetch_chunk(result, out_chunk.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_result_wait[err_origin: MutOrigin](
        self,
        result: duckdb_v2_result_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Blocks until result_step can make progress.

        A convenience over result_step: blocks until a step is worth issuing
        again, that is, until a unit of execution work can run on the calling
        thread. Never produces or consumes chunks. Waiting on a terminal result —
        FINISHED, CANCELLED, or a sticky error — returns immediately; it is a
        no-op, never an error.

        Args:
            result: The result to wait on.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_result_wait(result, err.as_unsafe_any_origin())

    def duckdb_v2_result_render_box[result_origin: MutOrigin, null_value_origin: ImmOrigin, user_data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: Pointer[duckdb_v2_result_handle, result_origin],
        max_rows: idx_t,
        max_width: idx_t,
        max_col_width: idx_t,
        null_value: Pointer[duckdb_v2_str, null_value_origin],
        render_mode: idx_t,
        limit: idx_t,
        sink: duckdb_v2_text_sink_fn,
        user_data: Pointer[NoneType, user_data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Renders the result as a box table, consuming it.

        Drains the result into a column data collection and renders it with the
        same renderer the DuckDB CLI uses, so every client displays results
        identically without reimplementing table formatting. The result is
        consumed by transfer: the slot is set to NULL on success and on failure
        alike. A partially consumed result is accepted, and the remainder is what
        gets rendered.

        The whole remaining result materializes in memory before rendering.
        max_rows bounds what is DISPLAYED, not what is read, so with limit 0 the
        footer's row count is exact. A caller who cannot afford full
        materialization should bound the query itself (e.g. LIMIT n) and pass n
        as limit; the footer then renders "? rows" whenever the result fills that
        bound, since the true total is unknown at that point.

        Zero selects the renderer default for each sizing knob: max_rows 20,
        max_width the probed terminal width or 80 when that is unavailable,
        max_col_width 20. An empty null_value renders NULL cells as the default
        "NULL" text.

        The rendered text goes to sink rather than being returned: a box can be
        large, and this way nothing allocates a buffer the caller has to free.
        The sink is called exactly once with the whole box, so its view carries
        the full length — write it straight to a stream, or copy it into your own
        string. sink must not be NULL.

        Args:
            result: The result to render; consumed and set to NULL. Left intact only when the call rejects null arguments.
            max_rows: Maximum rows displayed; 0 selects the renderer default (20).
            max_width: Maximum total width in characters; 0 selects the renderer default.
            max_col_width: Maximum width of one column; 0 selects the renderer default (20).
            null_value: Text rendered for NULL cells; empty selects "NULL".
            render_mode: 0 renders rows (records down the page); 1 renders columns; other values are rejected with INVALID_INPUT.
            limit: The row limit the caller applied to the query before rendering; 0 means none. When the materialized result holds exactly this many rows the true total is unknown, so the footer renders "? rows" instead of an exact count.
            sink: Receives the whole rendered box in a single call. Borrowed for the duration of that call; see text_sink for the full contract.
            user_data: Opaque pointer passed through to sink untouched. May be NULL.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_result_render_box(result.as_unsafe_any_origin(), max_rows, max_width, max_col_width, null_value.as_unsafe_any_origin(), render_mode, limit, sink, user_data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_result_drain[out_rows_changed_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_result_handle,
        out_rows_changed: Pointer[idx_t, out_rows_changed_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Runs the result to completion and reports the changed-row count.

        A convenience over result_step: blocks until the stream is fully
        consumed, so every side effect is applied. Rows of a row-producing result
        are discarded. For a CHANGED_ROWS result *out_rows_changed receives the
        affected row count; for every other result type, and for a stream whose
        Count chunk was already consumed, it receives 0.

        The result type (result_get_result_type) is prepare-time metadata, so a
        caller can choose between consuming rows and draining without inspecting
        the SQL. Draining an already FINISHED result succeeds. Cancellation
        surfaces as ERROR_RUNTIME_INTERRUPT; errors are sticky, and on failure
        *out_rows_changed is unspecified.

        Args:
            result: The result to drain.
            out_rows_changed: Receives the affected row count for CHANGED_ROWS results, 0 otherwise.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_result_drain(result, out_rows_changed.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_result_get_result_type[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_result_handle,
        out_type: Pointer[DUCKDB_V2_RESULT_TYPE, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the shape of the result: query, changed rows, or nothing.

        QUERY_RESULT for statements that produce rows (SELECT, RETURNING,
        EXPLAIN), CHANGED_ROWS for an INSERT, UPDATE, or DELETE without
        RETURNING, NOTHING for DDL and other statements with no row output.

        Prepare-time metadata: available from statement_execute on, except for a
        statement that expands into a group, where it fails with
        ERROR_INPUT_METADATA_DEFERRED until stepping has bound the row-producing
        statement, or the group ended without one.

        Args:
            result: The result.
            out_type: Receives the result shape.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_result_get_result_type(result, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_result_get_statement_type[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_result_handle,
        out_type: Pointer[DUCKDB_V2_STATEMENT_TYPE, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the SQL statement type that produced the result.

        Prepare-time metadata: available from statement_execute on. A statement
        that expands into a group reports its type as written: MULTI, or PRAGMA
        for a pragma such as IMPORT DATABASE.

        Args:
            result: The result.
            out_type: Receives the statement type.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_result_get_statement_type(result, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_result_get_schema[out_schema_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_result_handle,
        out_schema: Pointer[duckdb_v2_schema_handle, out_schema_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the result's output schema as a single schema handle.

        Builds an owned schema of the result's column names and types into
        *out_schema; destroy it via schema_destroy. Prepare-time metadata,
        available before the first step, or for an expanding statement once
        stepping has bound the row-producing statement (before that it fails with
        ERROR_INPUT_METADATA_DEFERRED). Never empty: a
        non-SELECT reports a single status column, either a BIGINT changed-rows
        count or a BOOLEAN success.

        This schema is the authoritative source for the column types of the
        chunks the result produces; vectors do not carry their own type.

        *out_schema is set to NULL on failure.

        Args:
            result: The result.
            out_schema: Receives the owned output schema. Destroy via schema_destroy.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_result_get_schema(result, out_schema.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Schema
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_schema_get_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        schema: duckdb_v2_schema_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of fields in a schema.

        Args:
            schema: The schema.
            out_count: Receives the field count.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_schema_get_count(schema, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_schema_get_field[out_name_origin: MutOrigin, out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        schema: duckdb_v2_schema_handle,
        index: idx_t,
        out_name: Pointer[duckdb_v2_identifier_t, out_name_origin],
        out_type: Pointer[duckdb_v2_logical_type_handle, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the name and type of the field at the given index.

        out_name and out_type are valid only until the schema is destroyed, and
        out_type must not be destroyed. An out-of-range index is rejected with
        ERROR_INPUT_INVALID.

        Args:
            schema: The schema.
            index: Zero-based field index.
            out_name: Receives a borrowed view of the field name. Valid until the schema is destroyed.
            out_type: Receives a borrowed field type. Valid until the schema is destroyed; do not destroy it.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_schema_get_field(schema, index, out_name.as_unsafe_any_origin(), out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_schema_destroy[schema_origin: MutOrigin](
        self,
        schema: Pointer[duckdb_v2_schema_handle, schema_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a schema handle.

        Frees the handle along with the names and types it owns. On success the
        slot is set to null. Safe to call on an already-null slot.

        Args:
            schema: The schema handle to destroy.
        """
        return self._duckdb_v2_schema_destroy(schema.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Sql Statement
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_parse_sql[sql_origin: ImmOrigin, out_iterator_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        sql: Pointer[c_char, sql_origin],
        out_iterator: Pointer[duckdb_v2_statement_iterator_handle, out_iterator_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Parses a SQL string into an iterator over its statements.

        Parses and nothing more: no binding, no catalog access, no transaction.
        The connection supplies the parser options and parser extensions, and is
        not otherwise touched. Statements are raw parser output; statement-level
        rewrites happen inside statement_execute. The SQL string is copied, so
        the caller may free it once this call returns. An input with no
        statements — empty, whitespace, or separators only — yields an iterator
        that is immediately exhausted.

        Args:
            conn: The connection supplying the parser configuration.
            sql: Null-terminated SQL string; may contain any number of statements.
            out_iterator: Receives the new iterator handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_parse_sql(conn, sql.as_unsafe_any_origin(), out_iterator.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_statement_iterator_next[out_statement_origin: MutOrigin, err_origin: MutOrigin](
        self,
        iterator: duckdb_v2_statement_iterator_handle,
        out_statement: Pointer[duckdb_v2_sql_statement_handle, out_statement_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Yields the next statement, or NULL when exhausted.

        On success *out_statement receives the next owned statement, or NULL once
        the iterator is exhausted — repeatedly, so calling again is harmless. A
        parse error within the input surfaces no later than the call that reaches
        the failing statement: an implementation that parses eagerly reports it
        from parse_sql instead and yields no statements at all, while an
        incremental one yields the statements ahead of the failure first. On
        failure *out_statement is set to NULL.

        Args:
            iterator: The iterator to advance.
            out_statement: Receives an owned statement, or NULL when the iterator is exhausted.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_statement_iterator_next(iterator, out_statement.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_statement_bind[out_schema_origin: MutOrigin, out_parameters_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        statement: duckdb_v2_sql_statement_handle,
        out_schema: Pointer[duckdb_v2_schema_handle, out_schema_origin],
        out_parameters: Pointer[duckdb_v2_schema_handle, out_parameters_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Binds a parsed statement without executing, yielding its schema signature.

        Preprocesses and binds the statement exactly as execution would, but runs
        nothing: the result is the statement's signature as two schemas, not a
        query result. The statement is borrowed, not consumed, so it can be bound
        as often as you like and executed later. out_schema receives the output
        schema (result columns) and is never empty, since a non-SELECT reports a
        single status column: a BIGINT changed-rows count, or a BOOLEAN success.
        out_parameters, when non-NULL, receives the input schema (parameter
        types, ordered by binding index). Both are owned; destroy them via
        schema_destroy.

        Binding is read-only and does not disturb a live result: it begins no
        query, claims no cursor, reuses an active transaction read-only, and runs
        alongside a paused stream. It is single-consumer like the stepping
        functions, so bind concurrently only on a second connection.
        Prepare-time errors — binder, catalog, preprocessing — surface here. A
        statement that expands into a group (a dynamic PIVOT, or
        statement-expanding DDL such as ALTER ADD COLUMN with a non-constant
        DEFAULT) has a schema known only at execution, and is reported with
        ERROR_INPUT_METADATA_DEFERRED; execute it instead.

        *out_schema and *out_parameters are set to NULL on failure.

        Args:
            conn: The connection supplying the catalog, transaction, and parser configuration.
            statement: The statement to bind. Borrowed; not consumed.
            out_schema: Receives the owned output schema (result columns). Destroy via schema_destroy.
            out_parameters: Optional. When non-NULL, receives the owned input schema (parameter types, ordered by binding index). Destroy via schema_destroy.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_statement_bind(conn, statement, out_schema.as_unsafe_any_origin(), out_parameters.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_statement_add_collection[name_origin: ImmOrigin, column_names_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        statement: duckdb_v2_sql_statement_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        collection: duckdb_v2_column_data_collection_handle,
        column_names: Pointer[duckdb_v2_identifier_t, column_names_origin],
        column_count: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Binds a column data collection to the statement under a name.

        Makes the collection visible to the statement as a table named `name`, by adding a common table expression to
        the parsed statement. The statement can then be bound, prepared or executed as usual; each execution reads the
        collection's contents at that moment, so a prepared statement can be executed again after the collection was
        cleared and refilled. Supported statement types are SELECT, INSERT, UPDATE, DELETE and MERGE INTO; any other
        type is rejected with `ERROR_INPUT_INVALID`.

        A name the statement already defines as a common table expression, in its SQL text or by a prior call, is
        rejected with `ERROR_INPUT_INVALID`. The binding shadows any catalog table named `name`, as a common table
        expression does.

        By default the collection's columns are named col1..colN. Pass `column_names` to name them instead; when
        supplied, `column_count` must equal the collection's column count. Pass NULL and 0 for the default names.

        The collection is borrowed: the caller keeps ownership and must keep it alive, and must not clear, reset or
        destroy it, for as long as the statement, any statement copied or prepared from it, or any result executing it
        is live. An empty collection is a valid binding. Several collections can be bound under distinct names.

        Args:
            statement: The statement to bind the collection to. Modified in place.
            name: The non-empty name the statement refers to the collection by. Borrowed and copied.
            collection: The collection to bind. Borrowed; the caller keeps ownership and must keep it alive.
            column_names: Optional. An array of `column_count` names for the collection's columns, in order. Pass NULL for col1..colN.
            column_count: The number of names in `column_names`. 0 for the default names; otherwise the collection's column count.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_statement_add_collection(statement, name.as_unsafe_any_origin(), collection, column_names.as_unsafe_any_origin(), column_count, err.as_unsafe_any_origin())

    def duckdb_v2_sql_statement_get_type[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        statement: duckdb_v2_sql_statement_handle,
        out_type: Pointer[DUCKDB_V2_STATEMENT_TYPE, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the statement's type as classified by the parser.

        This gives the type before the statement-level rewrites that
        `duckdb_v2_statement_execute` applies, if any. So a PRAGMA reports PRAGMA even
        where execution rewrites it into a SELECT or a CALL.
        `duckdb_v2_result_get_statement_type` on the executed result reports the
        rewritten type of a statement that rewrites into one. A statement the
        parser expands into a group reports MULTI, here and on its result. Its
        parts are not visible here, and statement_bind reports
        ERROR_INPUT_METADATA_DEFERRED for it.

        Args:
            statement: The statement.
            out_type: Receives the statement type.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_sql_statement_get_type(statement, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_sql_statement_get_text[out_text_origin: MutOrigin, err_origin: MutOrigin](
        self,
        statement: duckdb_v2_sql_statement_handle,
        out_text: Pointer[duckdb_v2_str, out_text_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the statement's own SQL text.

        The slice of the parsed string that belongs to this statement. A
        trailing terminator and the whitespace after it are included, whitespace
        and comments before the first token are not. The statement holds its own
        copy, so the view outlives the SQL string passed to parse_sql and the
        iterator, and stays valid until the statement is destroyed. A statement
        produced by a parser extension that overrides parsing carries whatever
        text the extension recorded.

        Args:
            statement: The statement.
            out_text: Receives a borrowed view of the statement text, valid until the statement is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_sql_statement_get_text(statement, out_text.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_sql_statement_get_parameter_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        statement: duckdb_v2_sql_statement_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of distinct parameters the statement declares.

        This counts the parameters the parser found ($1, ?, $name, ...), so it
        needs no catalog and no binding; only the parameter types wait for
        `duckdb_v2_statement_bind`. Repeated uses of one parameter count once.

        Args:
            statement: The statement.
            out_count: Receives the number of distinct parameters.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_sql_statement_get_parameter_count(statement, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_sql_statement_get_parameter_name[out_name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        statement: duckdb_v2_sql_statement_handle,
        index: idx_t,
        out_name: Pointer[duckdb_v2_identifier_t, out_name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the name of one parameter, in binding order.

        Parse-time metadata. Positions follow the parameters' binding indices,
        the order of `duckdb_v2_statement_bind`'s parameter schema, so position i here
        names field i there. The name is the binding key that
        `duckdb_v2_statement_execute` accepts: "1", "2", ... for a positional parameter
        ($1 or ?), the identifier for a named one ($name). Positional indices may
        be gapped ($1 and $3 without $2), in which case the names are "1" and "3"
        at positions 0 and 1. The view is valid until the statement is destroyed.
        An index outside [0, count) is rejected with ERROR_INPUT_OUT_OF_RANGE.

        Args:
            statement: The statement.
            index: Zero-based position in binding order.
            out_name: Receives a borrowed view of the parameter name, valid until the statement is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_sql_statement_get_parameter_name(statement, index, out_name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_sql_statement_destroy[statement_origin: MutOrigin](
        self,
        statement: Pointer[duckdb_v2_sql_statement_handle, statement_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a statement handle.

        Null-safe: passing nullptr or a slot already set to nullptr is a no-op.
        statement_execute does not consume a statement, so every statement is
        destroyed here once it is no longer needed. On success the slot is set to
        nullptr.

        Args:
            statement: The statement to destroy.
        """
        return self._duckdb_v2_sql_statement_destroy(statement.as_unsafe_any_origin())

    def duckdb_v2_statement_iterator_destroy[iterator_origin: MutOrigin](
        self,
        iterator: Pointer[duckdb_v2_statement_iterator_handle, iterator_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a statement iterator handle.

        Null-safe: passing nullptr or a slot already set to nullptr is a no-op.
        Statements already yielded are independently owned and stay valid. On
        success the slot is set to nullptr.

        Args:
            iterator: The iterator to destroy.
        """
        return self._duckdb_v2_statement_iterator_destroy(iterator.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Tokenizer
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_tokenize_sql[sql_origin: ImmOrigin, out_iterator_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        sql: Pointer[duckdb_v2_str, sql_origin],
        out_iterator: Pointer[duckdb_v2_token_iterator_handle, out_iterator_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Tokenizes a SQL string into an iterator over its tokens.

        Lexical tokenization, in the context of whatever grammar extensions are loaded on the given connection. Closing
        the connection or changing settings afterwards does not affect the tokens. The SQL string is borrowed for the call
        only, the caller may free it once this call returns. Whitespace is not a token. Malformed input is not an error;
        `duckdb_v2_token_iterator_ends_unterminated` reports whether the input ended inside an open token.

        *out_iterator is set to NULL on failure.

        Args:
            conn: The connection supplying the grammar.
            sql: The SQL text. Borrowed for the call only; may contain interior null bytes. {NULL, 0} is the empty input.
            out_iterator: Receives the new iterator handle. Destroy via token_iterator_destroy.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_tokenize_sql(conn, sql.as_unsafe_any_origin(), out_iterator.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_token_iterator_next[out_type_origin: MutOrigin, out_start_origin: MutOrigin, out_length_origin: MutOrigin, err_origin: MutOrigin](
        self,
        iterator: duckdb_v2_token_iterator_handle,
        out_type: Pointer[DUCKDB_V2_TOKEN_TYPE, out_type_origin],
        out_start: Pointer[idx_t, out_start_origin],
        out_length: Pointer[idx_t, out_length_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Yields the next token, or END_OF_INPUT once exhausted.

        On success writes the token's class, byte offset and byte length into the out-parameters. The lexeme is the input
        bytes [start, start + length). Once the input is exhausted, every call gives TOKEN_TYPE_END_OF_INPUT with start
        equal to the input length and length 0. On failure out params are set to TOKEN_TYPE_INVALID, 0, 0.

        Args:
            iterator: The iterator to advance.
            out_type: Receives the token's class, or TOKEN_TYPE_END_OF_INPUT once exhausted.
            out_start: Receives the token's byte offset into the input; the input length for END_OF_INPUT.
            out_length: Receives the token's byte length; 0 for END_OF_INPUT.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_token_iterator_next(iterator, out_type.as_unsafe_any_origin(), out_start.as_unsafe_any_origin(), out_length.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_token_iterator_ends_unterminated[out_ends_unterminated_origin: MutOrigin, err_origin: MutOrigin](
        self,
        iterator: duckdb_v2_token_iterator_handle,
        out_ends_unterminated: Pointer[Bool, out_ends_unterminated_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports whether the input ended before the closing delimiter of its last token.

        True when the input ends inside an open string, quoted identifier, block comment or dollar-quoted string, or in a
        line comment with no trailing newline; false otherwise, including for empty or whitespace-only input.
        Equivalently, the last token `duckdb_v2_token_iterator_next` yields before TOKEN_TYPE_END_OF_INPUT is the open one, so
        its class and lexeme say which delimiter is missing. A property of the input, not of the iterator position: the
        answer is the same before, during and after draining. The only failure is a null argument.

        Args:
            iterator: The iterator.
            out_ends_unterminated: Receives whether the input ended inside an open token.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_token_iterator_ends_unterminated(iterator, out_ends_unterminated.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_token_iterator_destroy[iterator_origin: MutOrigin](
        self,
        iterator: Pointer[duckdb_v2_token_iterator_handle, iterator_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a token iterator handle.

        Args:
            iterator: The iterator to destroy.
        """
        return self._duckdb_v2_token_iterator_destroy(iterator.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Value
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_value_destroy[value_origin: MutOrigin](
        self,
        value: Pointer[duckdb_v2_value_handle, value_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a value handle.

        Null-safe: passing nullptr or a slot already set to nullptr is a no-op.
        On success the slot is set to nullptr.

        Args:
            value: The value to destroy.
        """
        return self._duckdb_v2_value_destroy(value.as_unsafe_any_origin())

    def duckdb_v2_value_get_bool[out__origin: MutOrigin, err_origin: MutOrigin](
        self,
        value: duckdb_v2_value_handle,
        out_: Pointer[Bool, out__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the value as a BOOLEAN.

        A value of a different type is converted through the default cast set, on
        a copy, so reading never alters the value. An unsupported conversion
        returns ERROR_INPUT_INVALID, as does a NULL value.

        Args:
            value: The value to read.
            out_: Receives the payload as a bool.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_value_get_bool(value, out_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

