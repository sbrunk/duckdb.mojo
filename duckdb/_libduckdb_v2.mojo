struct _duckdb_v2_statement_iterator:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_statement_iterator_handle = Pointer[_duckdb_v2_statement_iterator, MutUntrackedOrigin]


# ===--------------------------------------------------------------------===#
# Types: Tokenizer
# ===--------------------------------------------------------------------===#


#! The lexical class of a token.
comptime DUCKDB_V2_TOKEN_TYPE = Int32
# Not an actual token class; out_type is set to this when `duckdb_v2_token_iterator_next` fails.
comptime DUCKDB_V2_TOKEN_TYPE_INVALID: DUCKDB_V2_TOKEN_TYPE = 0
# A keyword of the connection's grammar.
comptime DUCKDB_V2_TOKEN_TYPE_KEYWORD: DUCKDB_V2_TOKEN_TYPE = 1
# A bare or double-quoted identifier, quotes included.
comptime DUCKDB_V2_TOKEN_TYPE_IDENTIFIER: DUCKDB_V2_TOKEN_TYPE = 2
# A quoted or dollar-quoted string, delimiters included.
comptime DUCKDB_V2_TOKEN_TYPE_STRING_LITERAL: DUCKDB_V2_TOKEN_TYPE = 3
# A numeric literal.
comptime DUCKDB_V2_TOKEN_TYPE_NUMBER_LITERAL: DUCKDB_V2_TOKEN_TYPE = 4
# An operator or punctuation run other than the statement terminator.
comptime DUCKDB_V2_TOKEN_TYPE_OPERATOR: DUCKDB_V2_TOKEN_TYPE = 5
# A line or block comment, delimiters included.
comptime DUCKDB_V2_TOKEN_TYPE_COMMENT: DUCKDB_V2_TOKEN_TYPE = 6
# A statement-terminating semicolon.
comptime DUCKDB_V2_TOKEN_TYPE_TERMINATOR: DUCKDB_V2_TOKEN_TYPE = 7
# Not a token; reported by token_iterator_next once the input is exhausted, with start equal to the input length and length 0.
comptime DUCKDB_V2_TOKEN_TYPE_END_OF_INPUT: DUCKDB_V2_TOKEN_TYPE = 8

#! An opaque, owned handle to an iterator over the tokens of a SQL string, produced by tokenize_sql.
struct _duckdb_v2_token_iterator:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_token_iterator_handle = Pointer[_duckdb_v2_token_iterator, MutUntrackedOrigin]


# ===--------------------------------------------------------------------===#
# Types: Vector
# ===--------------------------------------------------------------------===#


#! Internal representation of a vector, with FSST / SEQUENCE / SHREDDED
#! collapsed into OTHER: the view getter rejects those and requires an
#! explicit vector_flatten first. OTHER is the 0-value, so a
#! zero-initialized out-param reads as "unspecified, needs flatten" rather
#! than silently looking like FLAT.
comptime DUCKDB_V2_VECTOR_TYPE = Int32
# Default for zero-init. Covers FSST / SEQUENCE / SHREDDED — call vector_flatten first.
comptime DUCKDB_V2_VECTOR_TYPE_OTHER: DUCKDB_V2_VECTOR_TYPE = 0
# Standard per-row storage.
comptime DUCKDB_V2_VECTOR_TYPE_FLAT: DUCKDB_V2_VECTOR_TYPE = 1
# A single value applies to every row in the vector.
comptime DUCKDB_V2_VECTOR_TYPE_CONSTANT: DUCKDB_V2_VECTOR_TYPE = 2
# Data + selection vector indirection into another vector.
comptime DUCKDB_V2_VECTOR_TYPE_DICTIONARY: DUCKDB_V2_VECTOR_TYPE = 3

@fieldwise_init
struct duckdb_v2_vector_view(Copyable, Movable):
    var data: Pointer[NoneType, ImmUntrackedOrigin]
    var validity: Pointer[UInt64, ImmUntrackedOrigin]
    var sel: Pointer[duckdb_v2_sel_t, ImmUntrackedOrigin]
    var count: idx_t

@fieldwise_init
struct duckdb_v2_list_entry(Copyable, Movable):
    var offset: idx_t
    var length: idx_t

@fieldwise_init
struct duckdb_v2_hugeint_t(Copyable, Movable):
    var lower: UInt64
    var upper: Int64

@fieldwise_init
struct duckdb_v2_uhugeint_t(Copyable, Movable):
    var lower: UInt64
    var upper: UInt64

@fieldwise_init
struct duckdb_v2_interval_t(Copyable, Movable):
    var months: Int32
    var days: Int32
    var micros: Int64


