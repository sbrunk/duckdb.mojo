# The aggregate's result depends on the order in which rows are aggregated (default).
comptime DUCKDB_V2_FUNCTION_PROPERTY_AGG_ORDER_DEPENDENT_YES: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 196608
# The aggregate's result does not depend on input order.
comptime DUCKDB_V2_FUNCTION_PROPERTY_AGG_ORDER_DEPENDENT_NO: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 196609
# The aggregate's result is affected by a DISTINCT modifier (default).
