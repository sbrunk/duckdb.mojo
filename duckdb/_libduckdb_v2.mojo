# ===--------------------------------------------------------------------===#
# Types: Errors
# ===--------------------------------------------------------------------===#


#! Error codes for API calls.
comptime DUCKDB_V2_ERROR = Int32
# Success.
comptime DUCKDB_V2_ERROR_NONE: DUCKDB_V2_ERROR = 0
# Generic API error.
comptime DUCKDB_V2_ERROR_API: DUCKDB_V2_ERROR = 1
# The specified file could not be found.
comptime DUCKDB_V2_ERROR_IO_FILE_NOT_FOUND: DUCKDB_V2_ERROR = 1001
# Failed to read from the storage device.
comptime DUCKDB_V2_ERROR_IO_READ_FAILURE: DUCKDB_V2_ERROR = 1002
# Unexpected end of file reached.
comptime DUCKDB_V2_ERROR_IO_EOF: DUCKDB_V2_ERROR = 1003
# A generic I/O error occurred while reading or writing data.
comptime DUCKDB_V2_ERROR_IO_GENERAL: DUCKDB_V2_ERROR = 1004
# A network-level failure occurred during an I/O operation.
comptime DUCKDB_V2_ERROR_IO_NETWORK: DUCKDB_V2_ERROR = 1005
# An HTTP request issued by the database failed.
comptime DUCKDB_V2_ERROR_IO_HTTP: DUCKDB_V2_ERROR = 1006
# General invalid input error.
comptime DUCKDB_V2_ERROR_INPUT_INVALID: DUCKDB_V2_ERROR = 2001
# A specific function parameter is malformed.
comptime DUCKDB_V2_ERROR_INPUT_PARAMETER_INVALID: DUCKDB_V2_ERROR = 2002
# A provided value is outside the acceptable range.
comptime DUCKDB_V2_ERROR_INPUT_OUT_OF_RANGE: DUCKDB_V2_ERROR = 2003
# An object exceeded its maximum permitted size.
comptime DUCKDB_V2_ERROR_INPUT_OBJECT_SIZE: DUCKDB_V2_ERROR = 2004
# The metadata asked for is known only once execution binds the statement that produces it, because the statement expands into several. Step the result and ask again.
comptime DUCKDB_V2_ERROR_INPUT_METADATA_DEFERRED: DUCKDB_V2_ERROR = 2005
# The requested resource is already in use.
comptime DUCKDB_V2_ERROR_RESOURCE_IN_USE: DUCKDB_V2_ERROR = 3001
# An allocation failed because the system ran out of memory.
comptime DUCKDB_V2_ERROR_RESOURCE_OUT_OF_MEMORY: DUCKDB_V2_ERROR = 3002
# A connection-level failure occurred (e.g. the connection has been closed or invalidated).
comptime DUCKDB_V2_ERROR_RESOURCE_CONNECTION: DUCKDB_V2_ERROR = 3003
# An operation failed because of an unresolved dependency between catalog objects.
comptime DUCKDB_V2_ERROR_RESOURCE_DEPENDENCY: DUCKDB_V2_ERROR = 3004
# An extension required by the operation is not loaded.
comptime DUCKDB_V2_ERROR_RESOURCE_MISSING_EXTENSION: DUCKDB_V2_ERROR = 3005
# Autoloading an extension failed.
comptime DUCKDB_V2_ERROR_RESOURCE_AUTOLOAD: DUCKDB_V2_ERROR = 3006
# A value could not be converted to the requested type.
comptime DUCKDB_V2_ERROR_TYPE_CONVERSION: DUCKDB_V2_ERROR = 4001
# An unknown or unsupported type was encountered.
comptime DUCKDB_V2_ERROR_TYPE_UNKNOWN: DUCKDB_V2_ERROR = 4002
# A type was used in a context where it is not valid.
