comptime DUCKDB_V2_LOGICAL_TYPE_ID_ARRAY: DUCKDB_V2_LOGICAL_TYPE_ID = 108
comptime DUCKDB_V2_LOGICAL_TYPE_ID_VARIANT: DUCKDB_V2_LOGICAL_TYPE_ID = 109
# Unnamed struct; shares the physical representation of STRUCT.
comptime DUCKDB_V2_LOGICAL_TYPE_ID_TUPLE: DUCKDB_V2_LOGICAL_TYPE_ID = 110


# ===--------------------------------------------------------------------===#
# Types: Prepared Statement
# ===--------------------------------------------------------------------===#


#! An owned handle to a statement bound and planned once, executable repeatedly via
#! `duckdb_v2_prepared_statement_execute`. Construct with `duckdb_v2_prepared_statement_create` and destroy with
#! `duckdb_v2_prepared_statement_destroy`. It keeps its connection's session alive, so it stays usable across executions
#! and even after the connection is disconnected.
struct _duckdb_v2_prepared_statement:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_prepared_statement_handle = Pointer[_duckdb_v2_prepared_statement, MutUntrackedOrigin]


# ===--------------------------------------------------------------------===#
# Types: Query metrics
# ===--------------------------------------------------------------------===#


#! An owned snapshot of the metrics of a query. Taken with `duckdb_v2_connection_get_query_metrics`, read from its root
#! node via `duckdb_v2_query_metrics_get_root`, and destroyed with `duckdb_v2_query_metrics_destroy`. Later queries do not
#! update it.
struct _duckdb_v2_query_metrics:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_query_metrics_handle = Pointer[_duckdb_v2_query_metrics, MutUntrackedOrigin]

#! A borrowed opaque handle to one node of a query metrics snapshot, valid for as long as the snapshot is. Read its
#! name with `duckdb_v2_query_metrics_node_get_name`, its metrics with `duckdb_v2_query_metrics_node_get_metric` or by index, and
#! its children with `duckdb_v2_query_metrics_node_get_child`.
struct _duckdb_v2_query_metrics_node:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_query_metrics_node_handle = Pointer[_duckdb_v2_query_metrics_node, MutUntrackedOrigin]


# ===--------------------------------------------------------------------===#
# Types: Qname
# ===--------------------------------------------------------------------===#


#! An owned qualified name: an ordered path of one to three non-empty identifier parts whose last element is the
#! object name. Construct with `duckdb_v2_qname_parse` or `duckdb_v2_qname_create`, read with `duckdb_v2_qname_get_part_count` and
#! `duckdb_v2_qname_get_part`, render back to SQL with `duckdb_v2_qname_render`, compare with `duckdb_v2_qname_equals`, and destroy
#! with `duckdb_v2_qname_destroy`. Two handles are compared with `duckdb_v2_qname_equals`, never by pointer.
struct _duckdb_v2_qname:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_qname_handle = Pointer[_duckdb_v2_qname, MutUntrackedOrigin]


# ===--------------------------------------------------------------------===#
# Types: Query Result
# ===--------------------------------------------------------------------===#


#! Shape of a query result. QUERY_RESULT carries rows and columns;
#! CHANGED_ROWS carries an affected row count, as an INSERT, UPDATE, or
#! DELETE without RETURNING produces; NOTHING covers DDL and other
#! statements with no row output.
comptime DUCKDB_V2_RESULT_TYPE = Int32
comptime DUCKDB_V2_RESULT_TYPE_QUERY_RESULT: DUCKDB_V2_RESULT_TYPE = 0
comptime DUCKDB_V2_RESULT_TYPE_CHANGED_ROWS: DUCKDB_V2_RESULT_TYPE = 1
comptime DUCKDB_V2_RESULT_TYPE_NOTHING: DUCKDB_V2_RESULT_TYPE = 2

#! Outcome of a result_step call. WAITING is the 0-value, so a
#! zero-initialized out-param reads as "no work product yet" rather than
#! CHUNK, the same convention VECTOR_TYPE_OTHER follows. The four states are
#! the ones a consumer acts on; they are deliberately not a projection of
#! any internal enum.
comptime DUCKDB_V2_RESULT_STEP_STATUS = Int32
# No chunk yet; step again, or block in result_wait.
comptime DUCKDB_V2_RESULT_STEP_STATUS_WAITING: DUCKDB_V2_RESULT_STEP_STATUS = 0
# A caller-owned chunk was written to *out_chunk, or an array to *out_array.
comptime DUCKDB_V2_RESULT_STEP_STATUS_CHUNK: DUCKDB_V2_RESULT_STEP_STATUS = 1
# Stream exhausted. Sticky.
comptime DUCKDB_V2_RESULT_STEP_STATUS_FINISHED: DUCKDB_V2_RESULT_STEP_STATUS = 2
# Query was interrupted. Sticky.
comptime DUCKDB_V2_RESULT_STEP_STATUS_CANCELLED: DUCKDB_V2_RESULT_STEP_STATUS = 3


# ===--------------------------------------------------------------------===#
# Types: Schema
# ===--------------------------------------------------------------------===#


#! An owned, ordered list of (name, type) fields. Read with schema_get_count
#! and schema_get_field. Destroy via schema_destroy.
struct _duckdb_v2_schema:
    var internal_ptr: Pointer[NoneType, MutUntrackedOrigin]
comptime duckdb_v2_schema_handle = Pointer[_duckdb_v2_schema, MutUntrackedOrigin]


