    # ===--------------------------------------------------------------------===#
    # Arena
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_arena_allocate[out_ptr_origin: MutOrigin, err_origin: MutOrigin](
        self,
        arena: duckdb_v2_arena_handle,
        byte_len: idx_t,
        out_ptr: Pointer[Pointer[UInt8, MutUntrackedOrigin], out_ptr_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Allocate `byte_len` bytes from the arena.

        Returns a writable pointer to `byte_len` uninitialized bytes, valid for as long as the arena is. There is no
        minimum or maximum allocation size, and the arena may return a pointer to a block of memory that is larger than
        `byte_len`. The arena will free all allocated memory when it is destroyed, so the caller should not attempt to free the returned pointer themselves.

        Args:
            arena: The arena to allocate from.
            byte_len: Number of bytes to reserve. May be 0.
            out_ptr: Receives a writable pointer to byte_len arena-owned bytes.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_arena_allocate(arena, byte_len, out_ptr.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Arrow
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_arrow_importer_create[schema_origin: MutOrigin, out_importer_origin: MutOrigin, err_origin: MutOrigin](
        self,
        context: duckdb_v2_context_handle,
        schema: Pointer[ArrowSchema, schema_origin],
        batch_size: idx_t,
        out_importer: Pointer[duckdb_v2_arrow_importer_handle, out_importer_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Resolves an Arrow schema into a reusable importer.

        Works out every column's DuckDB logical type and the Arrow type information the conversion needs, once, so any
        number of arrays of that shape can be imported without re-reading the schema. `schema` is read, not consumed:
        the caller keeps ownership and still releases it.

        `batch_size` caps the rows per produced chunk. A long array is split across several chunks. Rows left over that
        do not fill a batch are held back and joined with the next array, unless the append asked to flush. Pass 0 for
        no maximum: each array becomes one chunk, however long it is.

        Resolving reads the catalog for extension types, so `context` must have an active transaction. The importer
        keeps using that context for every conversion and must not outlive it. Within one connection the context is
        the same throughout, so an importer created in a bind callback is usable from the matching exec callback.
        `*out_importer` is set to NULL on failure.

        Args:
            context: The context used to resolve the Arrow types, extension types included.
            schema: The schema to resolve. Read, not consumed; the caller keeps ownership.
            batch_size: Maximum rows per produced chunk, or 0 for no maximum.
            out_importer: On success, receives the new importer. Owned by the caller; destroy via `duckdb_v2_arrow_importer_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_importer_create(context, schema.as_unsafe_any_origin(), batch_size, out_importer.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_importer_get_schema[out_schema_origin: MutOrigin, err_origin: MutOrigin](
        self,
        importer: duckdb_v2_arrow_importer_handle,
        out_schema: Pointer[duckdb_v2_schema_handle, out_schema_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the resolved DuckDB schema.

        Writes an owned schema handle with the DuckDB name and logical type of every column the importer resolved.
        This is how a caller learns the DuckDB shape of an ArrowSchema, to declare a table function's result columns
        for instance, without reimplementing the mapping from Arrow format strings to logical types.

        The fields were resolved at creation, so this reads no catalog and needs no transaction. `*out_schema` is set
        to NULL on failure.

        Args:
            importer: The importer to read.
            out_schema: On success, receives an owned schema. Destroy via `duckdb_v2_schema_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_importer_get_schema(importer, out_schema.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_importer_append[array_origin: MutOrigin, err_origin: MutOrigin](
        self,
        importer: duckdb_v2_arrow_importer_handle,
        array: Pointer[ArrowArray, array_origin],
        consume: Bool,
        flush: Bool,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Gives the importer one array to convert.

        Take the chunks with `duckdb_v2_arrow_importer_next_chunk` until that returns NULL. Appending while the previous array
        still has rows left is rejected with `ERROR_INPUT_INVALID`. An array whose shape does not match the resolved
        schema -- a different child count, a child whose length differs from the array's, a null or already-released
        child -- is rejected the same way, before anything is read.

        `flush` marks the end of the input: rows that do not fill a batch then come out as a final short chunk instead
        of being held back for the next array. Pass NULL for `array` with `flush` set to release the held rows without
        supplying more input.

        `consume` decides what happens to the caller's array.

        When true, the importer takes over the array and sets its `release` to NULL; the caller must not release it
        afterwards. The produced chunks reference the Arrow buffers directly, without copying, and keep them alive, so
        the chunks stay valid after the importer is destroyed. Prefer this path.

        When false, the caller keeps the array and must keep it valid until the drain finishes. The produced chunks are
        copies, so they do not depend on the array, at the cost of one copy per chunk.

        Either way, a chunk that joins rows held back from the previous array is a copy, since it cannot reference two
        arrays.

        Only the default, dictionary-encoded and run-end-encoded Arrow layouts are supported. Any other layout reports
        `ERROR_QUERY_NOT_IMPLEMENTED` when the column is converted.

        Args:
            importer: The importer to feed.
            array: The array to convert. Its `release` is set to NULL when `consume` is true.
            consume: True to hand the array over for a zero-copy import; false to keep it, in which case every produced chunk is
                a copy.
            flush: True to mark the end of the input, releasing held rows as a final short chunk. Pass NULL for `array` with
                this set to flush without supplying more input.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_importer_append(importer, array.as_unsafe_any_origin(), consume, flush, err.as_unsafe_any_origin())

    def duckdb_v2_arrow_importer_next_chunk[out_chunk_origin: MutOrigin, err_origin: MutOrigin](
        self,
        importer: duckdb_v2_arrow_importer_handle,
        out_chunk: Pointer[duckdb_v2_data_chunk_handle, out_chunk_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Produces the next chunk of the appended array, or NULL once the array is drained.

        Call it in a loop until `*out_chunk` is NULL. An importer with no array appended also returns NULL. Each chunk
        holds at most the importer's `batch_size` rows, or the whole array when that is 0. A chunk may start with rows
        held back from the previous array, and rows that do not fill a batch are held back in turn unless the append
        asked to flush. So NULL means the array has been read, not that all of its rows have come out.

        The conversion runs under the context the importer was created with, which must still be alive. `*out_chunk`
        is set to NULL on failure.

        Args:
            importer: The importer to drain.
            out_chunk: On success, receives the next chunk, or NULL once the array is drained. Destroy via `duckdb_v2_data_chunk_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_importer_next_chunk(importer, out_chunk.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_importer_destroy[importer_origin: MutOrigin](
        self,
        importer: Pointer[duckdb_v2_arrow_importer_handle, importer_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys an importer.

        Null-safe: passing NULL, or a slot already set to NULL, is a no-op. Chunks already produced stay valid,
        including the zero-copy ones, which keep the Arrow buffers alive themselves. An array appended with `consume`
        true and not fully drained is released here. Rows held back for a next array are dropped. On success the slot
        is set to NULL.

        Args:
            importer: The importer to destroy.
        """
        return self._duckdb_v2_arrow_importer_destroy(importer.as_unsafe_any_origin())

    def duckdb_v2_arrow_exporter_create[types_origin: ImmOrigin, names_origin: ImmOrigin, out_exporter_origin: MutOrigin, err_origin: MutOrigin](
        self,
        context: duckdb_v2_context_handle,
        types: Pointer[duckdb_v2_logical_type_handle, types_origin],
        names: Pointer[duckdb_v2_str, names_origin],
        count: idx_t,
        batch_size: idx_t,
        out_exporter: Pointer[duckdb_v2_arrow_exporter_handle, out_exporter_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates an exporter for one fixed list of columns.

        Resolves the extension types and captures the session's Arrow settings, so every array this exporter produces
        matches the schema `duckdb_v2_arrow_exporter_get_schema` reports, even if a setting changes afterwards.

        `batch_size` caps the rows per produced array. A long chunk is split across several arrays. Rows left over that
        do not fill a batch are held back and joined with the next chunk, unless the append asked to flush. Pass 0 for
        no maximum: each chunk becomes one array, however long it is.

        `types` and `names` are parallel arrays of `count` entries, borrowed and copied; they may be NULL only when
        `count` is 0. Resolving reads the catalog, so `context` must have an active transaction. `*out_exporter` is
        set to NULL on failure.

        Args:
            context: The context whose Arrow settings are captured and whose transaction resolves the types.
            types: An array of `count` column types. May be NULL only when `count` is 0.
            names: An array of `count` column names, parallel to `types`. Each name must be valid UTF-8.
                May be NULL only when `count` is 0.
            count: The number of columns, being the length of both `types` and `names`.
            batch_size: Maximum rows per produced array, or 0 for no maximum.
            out_exporter: On success, receives the new exporter. Owned by the caller; destroy via `duckdb_v2_arrow_exporter_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_exporter_create(context, types.as_unsafe_any_origin(), names.as_unsafe_any_origin(), count, batch_size, out_exporter.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_exporter_get_schema[out_schema_origin: MutOrigin, err_origin: MutOrigin](
        self,
        exporter: duckdb_v2_arrow_exporter_handle,
        out_schema: Pointer[ArrowSchema, out_schema_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the Arrow schema of the arrays this exporter produces.

        Fills the caller-allocated `out_schema`. The caller owns the result and releases it with
        `out_schema->release(out_schema)`. Callable at any point, and always returns the same schema, since it is built
        from the settings captured at creation.

        Args:
            exporter: The exporter to read.
            out_schema: Caller-allocated schema the library fills. Release it with `out_schema->release(out_schema)`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_exporter_get_schema(exporter, out_schema.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_exporter_append[chunk_origin: MutOrigin, err_origin: MutOrigin](
        self,
        exporter: duckdb_v2_arrow_exporter_handle,
        chunk: Pointer[duckdb_v2_data_chunk_handle, chunk_origin],
        consume: Bool,
        flush: Bool,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Gives the exporter one chunk to convert.

        The chunk is converted in full before this returns. The conversion copies into freshly allocated Arrow buffers,
        so nothing of the caller's is retained. Every array completed by this chunk becomes available from
        `duckdb_v2_arrow_exporter_next_array`; rows that do not complete a batch are held back and finished by the next
        chunk. Completed arrays queue up, so appending again before they are taken is allowed.

        `flush` marks the end of the input: the held rows are then finished as a final short array. Pass NULL for
        `chunk` with `flush` set to release the held rows without supplying more input.

        The chunk's types must match the ones the exporter was created with, or the call is rejected with
        `ERROR_INPUT_INVALID` before anything is read.

        `consume` decides only what happens to the caller's handle, since the data is copied either way. When true the
        chunk is destroyed and the slot set to NULL, saving a `duckdb_v2_data_chunk_destroy` for a chunk the caller owns.
        When false the chunk is left untouched, which is what a chunk borrowed from a callback needs, such as the output
        chunk of a table function's exec callback, which the caller does not own and must not destroy.

        Args:
            exporter: The exporter to feed.
            chunk: The chunk to convert. Destroyed and set to NULL only when `consume` is true.
            consume: True to hand the chunk over, destroying it; false to leave the caller's handle untouched.
            flush: True to mark the end of the input, releasing the held rows as a final short array. Pass NULL for `chunk`
                with this set to flush without supplying more input.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_exporter_append(exporter, chunk.as_unsafe_any_origin(), consume, flush, err.as_unsafe_any_origin())

    def duckdb_v2_arrow_exporter_next_array[out_array_origin: MutOrigin, err_origin: MutOrigin](
        self,
        exporter: duckdb_v2_arrow_exporter_handle,
        out_array: Pointer[ArrowArray, out_array_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Takes the next completed array, or reports that none is ready.

        Call it in a loop after every `duckdb_v2_arrow_exporter_append` until `out_array->release` is NULL, which is how the
        Arrow C Data Interface signals "no array" and what a stream's `get_next` does at end of input. Rows held back
        towards an unfinished batch are not an array yet; they come out after a further append or a flush.

        Each array is owned by the caller and released with `out_array->release(out_array)`, independently of the
        exporter and of every other array.

        Args:
            exporter: The exporter to drain.
            out_array: Caller-allocated array the library fills. Left released -- `release` NULL -- when none is ready. Release a
                filled one with `out_array->release(out_array)`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_exporter_next_array(exporter, out_array.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_exporter_destroy[exporter_origin: MutOrigin](
        self,
        exporter: Pointer[duckdb_v2_arrow_exporter_handle, exporter_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys an exporter.

        Null-safe: passing NULL, or a slot already set to NULL, is a no-op. Arrays already taken stay valid. Arrays
        still queued inside are released here, and rows held back towards an unfinished batch are dropped. On success
        the slot is set to NULL.

        Args:
            exporter: The exporter to destroy.
        """
        return self._duckdb_v2_arrow_exporter_destroy(exporter.as_unsafe_any_origin())

    def duckdb_v2_statement_execute_arrow[parameter_names_origin: ImmOrigin, parameter_values_origin: ImmOrigin, out_result_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        statement: duckdb_v2_sql_statement_handle,
        parameter_names: Pointer[duckdb_v2_identifier_t, parameter_names_origin],
        parameter_values: Pointer[duckdb_v2_value_handle, parameter_values_origin],
        parameter_count: idx_t,
        batch_size: idx_t,
        out_result: Pointer[duckdb_v2_arrow_result_handle, out_result_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Executes a parsed statement. The result produces Arrow arrays.

        Works like `duckdb_v2_statement_execute`. `*out_result` is set to NULL on failure.

        Args:
            conn: The connection to run the statement on.
            statement: The statement to execute. Not consumed.
            parameter_names: Optional. As in `duckdb_v2_statement_execute`.
            parameter_values: Optional. As in `duckdb_v2_statement_execute`.
            parameter_count: The number of parameters. 0 for none.
            batch_size: Maximum rows per array. Arrays can be shorter. 0 means 131072.
            out_result: Receives the new result. Destroy via `duckdb_v2_arrow_result_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_statement_execute_arrow(conn, statement, parameter_names.as_unsafe_any_origin(), parameter_values.as_unsafe_any_origin(), parameter_count, batch_size, out_result.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_prepared_statement_execute_arrow[parameter_names_origin: ImmOrigin, parameter_values_origin: ImmOrigin, out_result_origin: MutOrigin, err_origin: MutOrigin](
        self,
        prepared: duckdb_v2_prepared_statement_handle,
        parameter_names: Pointer[duckdb_v2_identifier_t, parameter_names_origin],
        parameter_values: Pointer[duckdb_v2_value_handle, parameter_values_origin],
        parameter_count: idx_t,
        batch_size: idx_t,
        out_result: Pointer[duckdb_v2_arrow_result_handle, out_result_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Executes a prepared statement. The result produces Arrow arrays.

        Works like `duckdb_v2_prepared_statement_execute`. `*out_result` is set to NULL on failure.

        Args:
            prepared: The prepared statement to execute. Not consumed.
            parameter_names: Optional. As in `duckdb_v2_prepared_statement_execute`.
            parameter_values: Optional. As in `duckdb_v2_prepared_statement_execute`.
            parameter_count: The number of parameters. 0 for none.
            batch_size: Maximum rows per array. Arrays can be shorter. 0 means 131072.
            out_result: Receives the new result. Destroy via `duckdb_v2_arrow_result_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_prepared_statement_execute_arrow(prepared, parameter_names.as_unsafe_any_origin(), parameter_values.as_unsafe_any_origin(), parameter_count, batch_size, out_result.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_destroy[result_origin: MutOrigin](
        self,
        result: Pointer[duckdb_v2_arrow_result_handle, result_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the result. Works like `duckdb_v2_result_destroy`.

        Args:
            result: The result to destroy.
        """
        return self._duckdb_v2_arrow_result_destroy(result.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_step[out_array_origin: MutOrigin, out_status_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_arrow_result_handle,
        out_array: Pointer[ArrowArray, out_array_origin],
        out_status: Pointer[DUCKDB_V2_RESULT_STEP_STATUS, out_status_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Runs a bounded amount of the query and returns without blocking.

        Works like `duckdb_v2_result_step`. On status `CHUNK`, `out_array` holds the next array. Otherwise its `release` is
        NULL.

        Args:
            result: The result to step.
            out_array: Caller-allocated array the library fills. Release it with `out_array->release(out_array)`.
            out_status: Receives the step status.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_result_step(result, out_array.as_unsafe_any_origin(), out_status.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_fetch_array[out_array_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_arrow_result_handle,
        out_array: Pointer[ArrowArray, out_array_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Blocks until the next array is ready.

        Works like `duckdb_v2_result_fetch_chunk`. At the end of the result, `out_array->release` is NULL.

        Args:
            result: The result to fetch from.
            out_array: Caller-allocated array the library fills. Release it with `out_array->release(out_array)`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_result_fetch_array(result, out_array.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_wait[err_origin: MutOrigin](
        self,
        result: duckdb_v2_arrow_result_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Blocks until `duckdb_v2_arrow_result_step` can make progress. Works like `duckdb_v2_result_wait`.

        Args:
            result: The result to wait on.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_result_wait(result, err.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_drain[out_rows_changed_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_arrow_result_handle,
        out_rows_changed: Pointer[idx_t, out_rows_changed_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Runs the query to the end and reports the changed-row count. Works like `duckdb_v2_result_drain`.

        Args:
            result: The result to drain.
            out_rows_changed: Receives the changed-row count for an INSERT, UPDATE or DELETE, 0 otherwise.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_result_drain(result, out_rows_changed.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_get_result_type[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_arrow_result_handle,
        out_type: Pointer[DUCKDB_V2_RESULT_TYPE, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the shape of the result. Works like `duckdb_v2_result_get_result_type`.

        Args:
            result: The result.
            out_type: Receives the result shape.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_result_get_result_type(result, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_get_statement_type[out_type_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_arrow_result_handle,
        out_type: Pointer[DUCKDB_V2_STATEMENT_TYPE, out_type_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the type of statement that produced the result. Works like `duckdb_v2_result_get_statement_type`.

        Args:
            result: The result.
            out_type: Receives the statement type.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_result_get_statement_type(result, out_type.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_get_schema[out_schema_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: duckdb_v2_arrow_result_handle,
        out_schema: Pointer[ArrowSchema, out_schema_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the Arrow schema of the result's arrays.

        Available whenever `duckdb_v2_result_get_schema` would be.

        Args:
            result: The result.
            out_schema: Caller-allocated schema the library fills. Release it with `out_schema->release(out_schema)`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_result_get_schema(result, out_schema.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_arrow_result_to_arrow_c_stream[result_origin: MutOrigin, out_stream_origin: MutOrigin, err_origin: MutOrigin](
        self,
        result: Pointer[duckdb_v2_arrow_result_handle, result_origin],
        out_stream: Pointer[ArrowArrayStream, out_stream_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Turns the result into an ArrowArrayStream.

        On success the stream takes over the result and `*result` is set to NULL. Each `get_next` returns the next
        array. Arrays already fetched are not repeated. Releasing the stream destroys the result.

        Converting runs no part of the query. The stream's `get_schema` can: for a statement that expands into several
        statements, such as PIVOT, it runs the ones before the statement that returns rows. A failing `get_next` or
        `get_schema` returns `EIO`; `get_last_error` has the message.

        Args:
            result: The result to take over. Set to NULL on success.
            out_stream: Caller-allocated stream the library fills. Release it with `out_stream->release(out_stream)`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_arrow_result_to_arrow_c_stream(result.as_unsafe_any_origin(), out_stream.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Catalog
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_connection_describe_table[desc_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        name: duckdb_v2_qname_handle,
        desc: Pointer[duckdb_v2_table_description_handle, desc_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Resolves a table name and snapshots its description.

        Resolves name in the connection's catalogs and returns an owned description of the table it names. name may be
        partial: an unqualified or schema-qualified name resolves through the connection's search path, exactly as the
        same name resolves in SQL. A two-part name tries the first part as a schema and as an attached database, as SQL
        does, and is rejected when both readings exist. A name that resolves to nothing is rejected with the engine's
        missing-table error; a name that resolves to a view is rejected with the engine's not-a-table error, since a
        description snapshots a base table.

        Args:
            conn: The connection whose catalogs and search path resolve the name.
            name: The possibly partial table name to resolve. Borrowed for the call only.
            desc: On success, receives the owned description. Destroy via `duckdb_v2_table_description_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_describe_table(conn, name, desc.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_description_get_qname[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        desc: duckdb_v2_table_description_handle,
        name: Pointer[duckdb_v2_qname_handle, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the resolved qualified name of the described table.

        Returns an owned copy of the fully resolved name: the catalog, schema, and table the lookup landed on, with the
        casing the table was created with, never an echo of the requested name. Rendering it produces SQL that pins the
        described table regardless of search path.

        Args:
            desc: The description.
            name: Receives the owned resolved name. Destroy via `duckdb_v2_qname_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_description_get_qname(desc, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_description_is_readonly[readonly_origin: MutOrigin, err_origin: MutOrigin](
        self,
        desc: duckdb_v2_table_description_handle,
        readonly: Pointer[Bool, readonly_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns whether the described table's catalog is read-only.

        True when the catalog the name resolved into was attached read-only, in which case no write to the table can
        succeed. False does not by itself prove a write will succeed; it clears the catalog-level check only.

        Args:
            desc: The description.
            readonly: Receives whether the catalog is read-only.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_description_is_readonly(desc, readonly.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_description_get_column_count[count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        desc: duckdb_v2_table_description_handle,
        count: Pointer[idx_t, count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of columns of the described table.

        Counts every column in declared order, generated columns included. Valid indices for
        `duckdb_v2_table_description_get_column` are [0, count).

        Args:
            desc: The description.
            count: Receives the column count.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_description_get_column_count(desc, count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_description_get_column[column_origin: MutOrigin, err_origin: MutOrigin](
        self,
        desc: duckdb_v2_table_description_handle,
        index: idx_t,
        column: Pointer[duckdb_v2_column_description_handle, column_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns an owned description of the column at index.

        Columns are numbered in declared order, generated columns included. An out-of-range index is rejected with
        `ERROR_INPUT_OUT_OF_RANGE`.

        Args:
            desc: The description.
            index: Zero-based column index.
            column: Receives the owned column description. Destroy via `duckdb_v2_column_description_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_table_description_get_column(desc, index, column.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_table_description_destroy[desc_origin: MutOrigin](
        self,
        desc: Pointer[duckdb_v2_table_description_handle, desc_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the table description, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction. Column descriptions obtained from it are independent and stay valid.

        Args:
            desc: The description to destroy.
        """
        return self._duckdb_v2_table_description_destroy(desc.as_unsafe_any_origin())

    def duckdb_v2_column_description_get_name[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        column: duckdb_v2_column_description_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the name of the column.

        The name carries the casing the column was declared with.

        Args:
            column: The column description.
            name: Receives a borrowed view of the column name. Valid until the column description is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_column_description_get_name(column, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_description_get_type[type__origin: MutOrigin, err_origin: MutOrigin](
        self,
        column: duckdb_v2_column_description_handle,
        type_: Pointer[duckdb_v2_logical_type_handle, type__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the type of the column.

        Args:
            column: The column description.
            type_: Receives the borrowed column type. Valid until the column description is destroyed; do not destroy it.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_column_description_get_type(column, type_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_description_has_default[has_default_origin: MutOrigin, err_origin: MutOrigin](
        self,
        column: duckdb_v2_column_description_handle,
        has_default: Pointer[Bool, has_default_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns whether the column has a default value.

        True when the column declares a default expression; the engine evaluates it for rows that omit the column.
        Generated columns report false.

        Args:
            column: The column description.
            has_default: Receives whether the column has a default value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_column_description_has_default(column, has_default.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_description_has_generated[has_generated_origin: MutOrigin, err_origin: MutOrigin](
        self,
        column: duckdb_v2_column_description_handle,
        has_generated: Pointer[Bool, has_generated_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns whether the column is generated.

        True when the column is a generated column, computed by the engine from a generation expression and not
        writable.

        Args:
            column: The column description.
            has_generated: Receives whether the column is generated.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_column_description_has_generated(column, has_generated.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_description_destroy[column_origin: MutOrigin](
        self,
        column: Pointer[duckdb_v2_column_description_handle, column_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the column description, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction. Any name or type borrowed from it becomes dangling.

        Args:
            column: The column description to destroy.
        """
        return self._duckdb_v2_column_description_destroy(column.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Configuration
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_instance_get_config[out_config_origin: MutOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        out_config: Pointer[duckdb_v2_config_handle, out_config_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the config of an instance: the GLOBAL scope.

        Reads report GLOBAL, and writes are `SET GLOBAL`. Writing at SESSION
        scope returns ERROR_INPUT_INVALID: an instance has no session. Options
        that can only be chosen at startup are passed to `duckdb_v2_instance_create_with_options`.
        The returned handle is borrowed: it is valid for as long as the instance
        is, and must not be destroyed.

        Args:
            instance: The instance.
            out_config: Receives the borrowed config.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_get_config(instance, out_config.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_get_config[out_config_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        out_config: Pointer[duckdb_v2_config_handle, out_config_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the config of a connection.

        Reads follow the connection's cascade: its SESSION value if it set one,
        otherwise the GLOBAL value, otherwise the default. Writes accept any
        scope the option supports. The returned handle is borrowed: it is valid
        for as long as the connection is, and must not be destroyed.

        Args:
            conn: The connection.
            out_config: Receives the borrowed config.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_get_config(conn, out_config.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_context_get_config[out_config_origin: MutOrigin, err_origin: MutOrigin](
        self,
        ctx: duckdb_v2_context_handle,
        out_config: Pointer[duckdb_v2_config_handle, out_config_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the config of a context.

        The same scope `duckdb_v2_connection_get_config` gives for the context's
        connection. The returned handle is borrowed: it is valid for as long as
        the context is, and must not be destroyed.

        Args:
            ctx: The context.
            out_config: Receives the borrowed config.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_context_get_config(ctx, out_config.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_config_get_option_value[name_origin: ImmOrigin, out_value_origin: MutOrigin, out_scope_origin: MutOrigin, err_origin: MutOrigin](
        self,
        config: duckdb_v2_config_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        out_scope: Pointer[DUCKDB_V2_SETTING_SCOPE, out_scope_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reads the effective value of an option in this config, and the scope it
        came from.

        Aliases resolve transparently, and an unknown name returns
        ERROR_INPUT_INVALID. The caller destroys the returned value.

        Args:
            config: The config to read from.
            name: Option name (canonical or alias).
            out_value: Receives the value, typed as the option. Owned by the caller.
            out_scope: Receives the scope the value came from.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_config_get_option_value(config, name.as_unsafe_any_origin(), out_value.as_unsafe_any_origin(), out_scope.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_config_set_option_value[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        config: duckdb_v2_config_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        value: duckdb_v2_value_handle,
        scope: DUCKDB_V2_SETTING_SCOPE,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Writes an option in this config.

        `scope` chooses the destination, mirroring SQL:
          - DEFAULT writes to the option's default scope, like a bare
            `SET name = value`.
          - GLOBAL writes through to the instance, visible to all connections,
            like `SET GLOBAL`.
          - SESSION writes to one connection's session only, like `SET SESSION`.
        A scope neither the option (`duckdb_v2_option_supports_scope`) nor the config
        supports returns ERROR_INPUT_INVALID; an instance's config supports only
        GLOBAL. The value is cast to the option's type as SQL `SET` does. An
        unknown name is rejected unless an extension that defines it can be
        autoloaded. An option that can only be chosen at startup is rejected:
        pass it to `duckdb_v2_instance_create_with_options`.

        Args:
            config: The config to write to.
            name: Option name (canonical or alias).
            value: The value, cast to the option's type as SQL `SET` does. Borrowed.
            scope: Target scope: DEFAULT, GLOBAL, or SESSION.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_config_set_option_value(config, name.as_unsafe_any_origin(), value, scope, err.as_unsafe_any_origin())

    def duckdb_v2_config_set_option_text[name_origin: ImmOrigin, setting_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        config: duckdb_v2_config_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        setting: Pointer[duckdb_v2_str, setting_origin],
        scope: DUCKDB_V2_SETTING_SCOPE,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Writes an option in this config from text, the form SQL `SET` accepts.

        `duckdb_v2_config_set_option_value` with the text as a VARCHAR value: the engine casts
        it to the option's type, so this is the one-call form for a setting
        spelled the way SQL spells it, e.g. "1GB" for memory_limit. Scope
        handling and errors are `duckdb_v2_config_set_option_value`'s.

        Args:
            config: The config to write to.
            name: Option name (canonical or alias).
            setting: The setting, in the textual form SQL `SET` accepts.
            scope: Target scope: DEFAULT, GLOBAL, or SESSION.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_config_set_option_text(config, name.as_unsafe_any_origin(), setting.as_unsafe_any_origin(), scope, err.as_unsafe_any_origin())

    def duckdb_v2_config_get_option_by_name[name_origin: ImmOrigin, out_option_origin: MutOrigin, err_origin: MutOrigin](
        self,
        config: duckdb_v2_config_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        out_option: Pointer[duckdb_v2_option_handle, out_option_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Describes a config option registered on this config's instance, by name.

        Allocates an option descriptor: canonical name, default value,
        description, supported and default scopes, and aliases. Aliases resolve transparently — passing an alias returns the
        canonical option, with the alias listed in its alias array. An unknown
        name returns ERROR_INPUT_INVALID, which includes an option of an
        extension that has not loaded yet. The caller destroys the returned
        option.

        Args:
            config: The config whose instance registered the options.
            name: Option name (canonical or alias).
            out_option: Receives the option descriptor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_config_get_option_by_name(config, name.as_unsafe_any_origin(), out_option.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_config_get_option_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        config: duckdb_v2_config_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of config options registered on this config's instance.

        Counts core options plus the extension options registered on this
        instance. Aliases are NOT counted separately; each one is reachable
        through its canonical option's alias array.

        Args:
            config: The config whose instance registered the options.
            out_count: Receives the option count.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_config_get_option_count(config, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_config_get_option_by_index[out_option_origin: MutOrigin, err_origin: MutOrigin](
        self,
        config: duckdb_v2_config_handle,
        index: idx_t,
        out_option: Pointer[duckdb_v2_option_handle, out_option_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Describes the config option at the given index on this config's instance.

        Index space: [0, core_count) addresses core options, [core_count, total)
        extension options. The mapping is stable for as long as no extension
        registers new options. An out-of-range index returns ERROR_INPUT_INVALID.
        The caller destroys the returned option.

        Args:
            config: The config whose instance registered the options.
            index: The option index, in [0, option_count).
            out_option: Receives the option descriptor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_config_get_option_by_index(config, index, out_option.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_option_destroy[option_origin: MutOrigin](
        self,
        option: Pointer[duckdb_v2_option_handle, option_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys an option descriptor.

        Frees the handle along with the strings it owns. On success the slot is
        set to null. Safe to call on an already-null slot.

        Args:
            option: The option handle to destroy.
        """
        return self._duckdb_v2_option_destroy(option.as_unsafe_any_origin())

    def duckdb_v2_option_get_name[out_name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_option_handle,
        out_name: Pointer[duckdb_v2_identifier_t, out_name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the option's canonical name.

        When the option was resolved from an alias, this still reports the
        canonical name; the alias is reachable via `duckdb_v2_option_get_alias`.

        Args:
            option: The option.
            out_name: Receives a borrowed view of the option name. Valid until the option is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_option_get_name(option, out_name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_option_get_default_value[out_value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_option_handle,
        out_value: Pointer[duckdb_v2_value_handle, out_value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the option's static default, as a value of the option's type.

        A NULL value for an option whose declaration has no default. The caller
        destroys the returned value.

        Args:
            option: The option.
            out_value: Receives the default value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_option_get_default_value(option, out_value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_option_get_description[out_description_origin: MutOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_option_handle,
        out_description: Pointer[duckdb_v2_str, out_description_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the option's human-readable description.

        Args:
            option: The option.
            out_description: Receives a borrowed view of the description. Valid until the option is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_option_get_description(option, out_description.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_option_supports_scope[out_supported_origin: MutOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_option_handle,
        scope: DUCKDB_V2_SETTING_SCOPE,
        out_supported: Pointer[Bool, out_supported_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports whether the option may be written at a scope.

        GLOBAL and SESSION are the scopes to ask about; DEFAULT is supported by
        every option that supports either. A write at an unsupported scope
        returns ERROR_INPUT_INVALID.

        Args:
            option: The option.
            scope: The scope to ask about.
            out_supported: Receives whether a write at the scope is accepted.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_option_supports_scope(option, scope, out_supported.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_option_get_default_scope[out_scope_origin: MutOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_option_handle,
        out_scope: Pointer[DUCKDB_V2_SETTING_SCOPE, out_scope_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the scope a DEFAULT write of the option goes to: GLOBAL or
        SESSION.

        Args:
            option: The option.
            out_scope: Receives the default scope.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_option_get_default_scope(option, out_scope.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_option_get_alias_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_option_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of aliases registered for this option.

        Zero for an extension option; extension options carry no aliases.

        Args:
            option: The option.
            out_count: Receives the alias count.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_option_get_alias_count(option, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_option_get_alias[out_alias_origin: MutOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_option_handle,
        index: idx_t,
        out_alias: Pointer[duckdb_v2_identifier_t, out_alias_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the alias name at the given index.

        An out-of-range index returns ERROR_INPUT_INVALID.

        Args:
            option: The option.
            index: The alias index, in [0, alias_count).
            out_alias: Receives a borrowed view of the alias. Valid until the option is destroyed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_option_get_alias(option, index, out_alias.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Custom Option
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_custom_option_create[option_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        option: Pointer[duckdb_v2_custom_option_handle, option_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new custom option through a factory.

        The option starts out empty: configure it with the setter functions, then make it available with
        `duckdb_v2_connection_register_custom_option` or `duckdb_v2_extension_register_custom_option`. The caller owns the returned
        handle and must destroy it with `duckdb_v2_custom_option_destroy`, also after registration.

        The custom option can only be registered on the instance the factory belongs to.

        Args:
            factory: The factory to create the custom option through.
            option: On success, receives the newly created custom option. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_create(factory, option.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_set_name[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_custom_option_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the custom option, as `SET` and the config functions refer to it.

        The name is borrowed and copied. Calling this again replaces the previous name. A name must be set before
        registration.

        Args:
            option: The option to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_set_name(option, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_set_type[err_origin: MutOrigin](
        self,
        option: duckdb_v2_custom_option_handle,
        type_: duckdb_v2_logical_type_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the type of the custom option. Every value written to the option is cast to it, as SQL `SET` does.

        The type is borrowed and copied. Optional when a default value is set, whose type the option then takes.

        Args:
            option: The option to set the type of.
            type_: The type to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_set_type(option, type_, err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_set_default_value[err_origin: MutOrigin](
        self,
        option: duckdb_v2_custom_option_handle,
        value: duckdb_v2_value_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the default value of the custom option: its value until it is set, and the value `RESET` restores.

        The value is borrowed and copied, and cast to the option's type at registration, which fails when the cast
        does. Without a default value the option reads as NULL until it is set.

        Args:
            option: The option to set the default value of.
            value: The default value. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_set_default_value(option, value, err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_set_description[description_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_custom_option_handle,
        description: Pointer[duckdb_v2_str, description_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the description of the custom option, as `duckdb_v2_option_get_description` and `duckdb_settings()` report it.

        The description is borrowed and copied. Calling this again replaces the previous description.

        Args:
            option: The option to set the description of.
            description: The description to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_set_description(option, description.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_set_default_scope[err_origin: MutOrigin](
        self,
        option: duckdb_v2_custom_option_handle,
        scope: DUCKDB_V2_SETTING_SCOPE,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the scope a write at `SETTING_SCOPE_DEFAULT` goes to, like SQL `SET name = value`.

        Must be GLOBAL or SESSION, and a scope the option supports. Defaults to SESSION, or to GLOBAL when the option
        does not support SESSION.

        Args:
            option: The option to set the default scope of.
            scope: The default scope, GLOBAL or SESSION.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_set_default_scope(option, scope, err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_set_supports_scope[err_origin: MutOrigin](
        self,
        option: duckdb_v2_custom_option_handle,
        scope: DUCKDB_V2_SETTING_SCOPE,
        supported: Bool,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets whether the custom option can be written at a scope, as `duckdb_v2_option_supports_scope` reports it.

        A custom option supports both GLOBAL and SESSION unless told otherwise. A write at a scope it does not support
        fails, from SQL as from `duckdb_v2_config_set_option_value`. Registration fails when the option supports neither scope.

        Args:
            option: The option to configure.
            scope: The scope, GLOBAL or SESSION.
            supported: Whether the option can be written at the scope.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_set_supports_scope(option, scope, supported, err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_set_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        option: duckdb_v2_custom_option_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets arbitrary user data on the custom option.

        Associates an opaque pointer with the option, retrievable from the update callback via
        `duckdb_v2_custom_option_update_get_user_data`. The opaque handle bundles the pointer with an optional destructor,
        invoked when the data is no longer needed: once the custom option handle is destroyed and, if it was
        registered, the instance is too.

        Args:
            option: The option to set the user data of.
            data: Opaque handle bundling the user data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_set_user_data(option, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_set_update_callback[err_origin: MutOrigin](
        self,
        option: duckdb_v2_custom_option_handle,
        callback: duckdb_v2_custom_option_update_callback_fn,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the optional update callback of the custom option.

        The callback is invoked whenever the option is set or reset, from SQL as from `duckdb_v2_config_set_option_value`, after the
        new value is cast to the option's type and before it is stored. It may replace the value with
        `duckdb_v2_custom_option_update_set_value`, or refuse it by reporting an error. It is not invoked for the default value
        at registration, nor for a value given to the instance at startup. The callback must not write options itself.

        Args:
            option: The option to set the update callback of.
            callback: The update callback to set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_set_update_callback(option, callback, err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_update_get_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_custom_option_update_info_handle,
        data: Pointer[Pointer[NoneType, MutUntrackedOrigin], data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the user data set via `duckdb_v2_custom_option_set_user_data`.

        Args:
            info: The update info handle.
            data: Receives the user data pointer, or null if none was set.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_update_get_user_data(info, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_update_get_value[value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_custom_option_update_info_handle,
        value: Pointer[duckdb_v2_value_handle, value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the value the option is updated to, already cast to the option's type. On a reset this is the
        default value, which may be NULL. The returned value is owned by the caller and must be destroyed via
        `duckdb_v2_value_destroy`.

        Args:
            info: The update info handle.
            value: Receives the new value. Owned by the caller; destroy via `duckdb_v2_value_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_update_get_value(info, value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_update_set_value[err_origin: MutOrigin](
        self,
        info: duckdb_v2_custom_option_update_info_handle,
        value: duckdb_v2_value_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Replaces the value the option is updated to, e.g. to normalize it. The value is borrowed and copied, and cast to
        the option's type, which fails when the cast does.

        Args:
            info: The update info handle.
            value: The value to store instead. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_update_set_value(info, value, err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_update_get_scope[scope_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_custom_option_update_info_handle,
        scope: Pointer[DUCKDB_V2_SETTING_SCOPE, scope_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the scope the value is written at: GLOBAL or SESSION, a DEFAULT write already resolved to the option's
        default scope.

        Args:
            info: The update info handle.
            scope: Receives the scope.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_update_get_scope(info, scope.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_update_is_reset[is_reset_origin: MutOrigin, err_origin: MutOrigin](
        self,
        info: duckdb_v2_custom_option_update_info_handle,
        is_reset: Pointer[Bool, is_reset_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves whether the update is a reset to the default value, like SQL `RESET`.

        Args:
            info: The update info handle.
            is_reset: Receives whether the update is a reset.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_custom_option_update_is_reset(info, is_reset.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_register_custom_option[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        option: duckdb_v2_custom_option_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the custom option on the connection's instance, visible to every connection.

        Registration is not transactional: it takes effect at once, also inside an explicit transaction, and a rollback
        does not undo it. Registration requires a name and a type, or a default value to take the type from, and fails
        when an option of the same name already exists. A value given for the option at startup is picked up. The custom
        option must have been created through a factory of the same instance. The caller still owns the handle after
        registration and must destroy it with `duckdb_v2_custom_option_destroy`, which does not affect the registered option.

        Args:
            conn: The connection to register on.
            option: The custom option to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_register_custom_option(conn, option, err.as_unsafe_any_origin())

    def duckdb_v2_extension_register_custom_option[err_origin: MutOrigin](
        self,
        extension: duckdb_v2_extension_handle,
        option: duckdb_v2_custom_option_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Registers the custom option on the loading extension's instance, visible to every connection.

        Use this from the extension's load callback. Registration is not transactional, requires a name and a type, or a
        default value to take the type from, and fails when an option of the same name already exists. A value given
        for the option at startup is picked up. The custom option must have been created through a factory of the same
        instance. The caller still owns the handle after registration and must destroy it with
        `duckdb_v2_custom_option_destroy`, which does not affect the registered option.

        Args:
            extension: The loading extension.
            option: The custom option to register.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_extension_register_custom_option(extension, option, err.as_unsafe_any_origin())

    def duckdb_v2_custom_option_destroy[option_origin: MutOrigin](
        self,
        option: Pointer[duckdb_v2_custom_option_handle, option_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the custom option, releasing its resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to
        prevent double-destruction. Destroying the handle after registration does not affect the registered option.

        Args:
            option: The option to destroy.
        """
        return self._duckdb_v2_custom_option_destroy(option.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Connection
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_connection_create[out_conn_origin: MutOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        out_conn: Pointer[duckdb_v2_connection_handle, out_conn_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Opens a connection to an instance.

        Each connection carries its own client context and session-scoped (LOCAL)
        settings. Connections to the same instance share its catalog, buffer
        pool, and transaction manager. A connection may be created before any
        database is attached to the instance; until one is, only the system
        catalog and the connection's temporary catalog are visible. The caller
        destroys it via `duckdb_v2_connection_destroy`.

        Args:
            instance: The instance to connect to.
            out_conn: Receives the new connection handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_create(instance, out_conn.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_destroy[conn_origin: MutOrigin](
        self,
        conn: Pointer[duckdb_v2_connection_handle, conn_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the connection.

        Always succeeds. Releases the connection's reference on the underlying
        database instance, which survives for as long as anything else still
        references it. On success the handle is set to null. Safe to call on an
        already-null slot.

        Args:
            conn: The connection to destroy.
        """
        return self._duckdb_v2_connection_destroy(conn.as_unsafe_any_origin())

    def duckdb_v2_connection_interrupt[err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Interrupts the query currently executing on the connection.

        The cross-thread (but not cross-connection) cancellation entry point
        for streaming results: safe to call from any thread within the execution
        of a query through a connection, including while another thread steps
        the query's result. A no-op when no query is active. Cancellation surfaces
        on the consuming side as step status CANCELLED (`duckdb_v2_result_step`), or as
        ERROR_RUNTIME_INTERRUPT (`duckdb_v2_result_fetch_chunk`).

        Args:
            conn: The connection whose active query to interrupt.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_interrupt(conn, err.as_unsafe_any_origin())

    def duckdb_v2_connection_progress_get[out_percentage_origin: MutOrigin, out_rows_processed_origin: MutOrigin, out_total_rows_to_process_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        out_percentage: Pointer[Float64, out_percentage_origin],
        out_rows_processed: Pointer[UInt64, out_rows_processed_origin],
        out_total_rows_to_process: Pointer[UInt64, out_total_rows_to_process_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Captures a snapshot of the active query's execution progress.

        Reads the percentage and row counts from one consistent snapshot
        of the query currently executing on the connection. Safe to call
        from any thread, including while another thread steps the query's
        result.

        Progress is published only when the enable_progress_bar option is
        set; the bridge does not enable tracking itself. Both row counts
        are 0 when no information is available. The percentage is -1 when
        tracking is disabled, no query is active, or no progress has been
        published yet.

        Args:
            conn: The connection.
            out_percentage: Receives the percentage complete in [0, 100], -1 if tracking is disabled, no query is active, or no progress has been published yet.
            out_rows_processed: Receives the number of rows processed so far.
            out_total_rows_to_process: Receives the total number of rows the query will process.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_progress_get(conn, out_percentage.as_unsafe_any_origin(), out_rows_processed.as_unsafe_any_origin(), out_total_rows_to_process.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Column Data Collection
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_column_data_collection_create[types_array_origin: ImmOrigin, out_collection_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        types_array: Pointer[duckdb_v2_logical_type_handle, types_array_origin],
        types_count: idx_t,
        out_collection: Pointer[duckdb_v2_column_data_collection_handle, out_collection_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates an empty column data collection from a factory.

        Allocates a new, empty column data collection, drawing its buffers from the factory's database. The collection starts with no chunks and is ready to have chunks appended to it. A collection must have at least one column; an empty types array is rejected with INVALID_INPUT.

        Args:
            factory: The factory to create with.
            types_array: Pointer to an array of logical_type handles, one per column. This defines the schema for the chunks that will be stored in the collection. All chunks appended to this collection must have vectors that conform to these types.
            types_count: Number of elements in the types_array.
            out_collection: Receives the new collection handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_create(factory, types_array.as_unsafe_any_origin(), types_count, out_collection.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_reset[err_origin: MutOrigin](
        self,
        collection: duckdb_v2_column_data_collection_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Drops all buffered rows, keeping the column types.

        Drops all buffered rows and releases their memory. The column types are
        unchanged and the collection is immediately appendable again. Existing
        append and scan states are invalidated. Use
        `duckdb_v2_column_data_collection_clear` instead to keep the memory for the
        next appends.

        Args:
            collection: The collection to reset.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_reset(collection, err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_clear[err_origin: MutOrigin](
        self,
        collection: duckdb_v2_column_data_collection_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Drops all buffered rows, keeping the column types and the memory.

        Like `duckdb_v2_column_data_collection_reset`, but the buffers are retained
        rather than released, so the next appends write into memory that is
        already allocated. Use this when the collection is refilled repeatedly.
        The column types are unchanged and the collection is immediately
        appendable again. Existing append and scan states are invalidated.

        Args:
            collection: The collection to clear.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_clear(collection, err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_destroy[collection_origin: MutOrigin](
        self,
        collection: Pointer[duckdb_v2_column_data_collection_handle, collection_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a column data collection and all its chunks.

        Cleans up the collection and all resources associated with it, including all contained chunks. Sets the collection handle to NULL.

        Args:
            collection: The collection to destroy.
        """
        return self._duckdb_v2_column_data_collection_destroy(collection.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_combine[source_origin: MutOrigin, err_origin: MutOrigin](
        self,
        target: duckdb_v2_column_data_collection_handle,
        source: Pointer[duckdb_v2_column_data_collection_handle, source_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Merges the source collection into the target collection, consuming the source in the process.

        Transfers all chunks from the source collection to the target collection. This destroys the source collection, setting the source handle to NULL. The two collections must have the same column types, and must have been created from factories of the same database: the transferred chunks keep their original buffers, so combining collections from different databases would tie the target to a buffer manager it does not own.

        Args:
            target: The collection to merge into. After the call, this collection will contain all chunks from both collections.
            source: The collection to merge from. This collection will be destroyed by this operation and its handle set to NULL.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_combine(target, source.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_row_count[out_row_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        collection: duckdb_v2_column_data_collection_handle,
        out_row_count: Pointer[idx_t, out_row_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the total number of rows across all chunks in the collection.

        Sums the row counts of all chunks in the collection. This is the total number of rows represented by the collection, which may be more than the number of rows in any individual chunk.

        Args:
            collection: The collection to inspect.
            out_row_count: Receives the total row count.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_row_count(collection, out_row_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_append_state_create[out_state_origin: MutOrigin, err_origin: MutOrigin](
        self,
        collection: duckdb_v2_column_data_collection_handle,
        out_state: Pointer[duckdb_v2_column_data_collection_append_state_handle, out_state_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Initializes an append state for the collection.

        Returns an append state handle that can be used to append chunks to the collection while maintaining any necessary state across calls.

        Args:
            collection: The collection to prepare for appending.
            out_state: Receives the new append state handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_append_state_create(collection, out_state.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_append_state_destroy[state_origin: MutOrigin](
        self,
        state: Pointer[duckdb_v2_column_data_collection_append_state_handle, state_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys an append state handle.

        Cleans up any resources associated with the append state. After this call, the state handle must not be used again.

        Args:
            state: The append state to destroy.
        """
        return self._duckdb_v2_column_data_collection_append_state_destroy(state.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_append[err_origin: MutOrigin](
        self,
        collection: duckdb_v2_column_data_collection_handle,
        state: duckdb_v2_column_data_collection_append_state_handle,
        chunk: duckdb_v2_data_chunk_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Appends a data chunk to the collection.

        Appends a copy of the given chunk to the end of the collection. The
        chunk's column count and types must equal the collection's exactly; a
        mismatch is rejected with INVALID_INPUT before anything is copied.
        VARCHAR values must already contain valid UTF-8; this function does not validate text.
        Complex-typed vectors may be flattened in place by the copy.

        Args:
            collection: The collection to append to.
            state: The append state to use this append operation.
            chunk: The chunk to append.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_append(collection, state, chunk, err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_shared_scan_state_create[out_state_origin: MutOrigin, err_origin: MutOrigin](
        self,
        collection: duckdb_v2_column_data_collection_handle,
        out_state: Pointer[duckdb_v2_column_data_collection_shared_scan_state_handle, out_state_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Initializes a shared scan state for the collection.

        Returns a shared scan state handle that can be used by multiple threads to coordinate scanning of the collection. Caller owns the returned state and must destroy it via column_data_collection_shared_scan_state_destroy when done.

        Args:
            collection: The collection to prepare for shared scanning.
            out_state: Receives the new shared scan state handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_shared_scan_state_create(collection, out_state.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_shared_scan_state_destroy[state_origin: MutOrigin](
        self,
        state: Pointer[duckdb_v2_column_data_collection_shared_scan_state_handle, state_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a shared scan state handle.

        Cleans up any resources associated with the shared scan state. After this call, the state handle must not be used again.

        Args:
            state: The shared scan state to destroy.
        """
        return self._duckdb_v2_column_data_collection_shared_scan_state_destroy(state.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_worker_scan_state_create[out_state_origin: MutOrigin, err_origin: MutOrigin](
        self,
        collection: duckdb_v2_column_data_collection_handle,
        out_state: Pointer[duckdb_v2_column_data_collection_worker_scan_state_handle, out_state_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Initializes a worker scan state for the collection.

        Returns a "local" scan state handle for a worker thread to use while scanning the collection. This allows each thread to maintain its own progress and any other necessary information across multiple scan calls, while still coordinating with other threads via the shared scan state.

        Args:
            collection: The collection to prepare for worker scanning.
            out_state: Receives the new worker scan state handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_worker_scan_state_create(collection, out_state.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_worker_scan_state_destroy[state_origin: MutOrigin](
        self,
        state: Pointer[duckdb_v2_column_data_collection_worker_scan_state_handle, state_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a worker scan state handle.

        Cleans up any resources associated with the worker scan state. After this call, the state handle must not be used again.

        Args:
            state: The worker scan state to destroy.
        """
        return self._duckdb_v2_column_data_collection_worker_scan_state_destroy(state.as_unsafe_any_origin())

    def duckdb_v2_column_data_collection_scan[did_produce_chunk_origin: MutOrigin, err_origin: MutOrigin](
        self,
        collection: duckdb_v2_column_data_collection_handle,
        shared_state: duckdb_v2_column_data_collection_shared_scan_state_handle,
        worker_state: duckdb_v2_column_data_collection_worker_scan_state_handle,
        out_chunk: duckdb_v2_data_chunk_handle,
        did_produce_chunk: Pointer[Bool, did_produce_chunk_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Scans the collection to retrieve the next data chunk, using shared state for coordination across threads and worker-local state for individual progress tracking.

        Retrieves the next chunk of data from the collection based on the provided shared scan state and worker-local scan state. The output chunk's column count and types must equal the collection's exactly; a mismatch is rejected with INVALID_INPUT.

        The scan is zero-copy where possible: the output chunk's vectors may reference the collection's buffers, kept alive by the worker scan state. The chunk's data is therefore only valid until the next scan call with the same worker state, or until the worker state or the collection is destroyed, whichever comes first. Copy the data out (or append it to another collection) before continuing the scan if it must outlive that window.

        Args:
            collection: The collection to scan.
            shared_state: The shared scan state to use for coordinating across threads.
            worker_state: The worker-local scan state to use for this thread's scan operation.
            out_chunk: The output chunk to write to.
            did_produce_chunk: Receives true when a chunk was produced by this call, or false when the scan has completed (the chunk is then reset to empty).
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_column_data_collection_scan(collection, shared_state, worker_state, out_chunk, did_produce_chunk.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Data Chunk
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_data_chunk_create[types_origin: ImmOrigin, out_chunk_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        types: Pointer[duckdb_v2_logical_type_handle, types_origin],
        column_count: idx_t,
        out_chunk: Pointer[duckdb_v2_data_chunk_handle, out_chunk_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates an empty data chunk with the given column types, drawing its allocator from a factory.

        The chunk's vectors are allocated through the factory's database, so the
        memory is accounted to that database. Allocates one FLAT vector per element of the
        types array, each at default capacity. Every vector starts at size 0; set
        it with vector_set_size once the vector is populated. The chunk is
        caller-owned and must be destroyed via data_chunk_destroy.

        Args:
            factory: The factory to create with.
            types: Pointer to an array of logical_type handles, one per column.
            column_count: Number of elements in the types array.
            out_chunk: Receives the new chunk handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_data_chunk_create(factory, types.as_unsafe_any_origin(), column_count, out_chunk.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_data_chunk_copy[out_chunk_origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        chunk: duckdb_v2_data_chunk_handle,
        out_chunk: Pointer[duckdb_v2_data_chunk_handle, out_chunk_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a deep copy of a data chunk, drawing its allocator from a factory.

        Allocates a new chunk with the source chunk's column types and copies all rows into it, through the factory's database. The copy is flattened and owns all its data, so it stays valid after the source chunk or whatever backs it (such as a column data collection scan state) is destroyed. The returned chunk is caller-owned and must be destroyed via data_chunk_destroy.

        Args:
            factory: The factory to create with.
            chunk: The chunk to copy. Left unchanged.
            out_chunk: Receives the new chunk handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_data_chunk_copy(factory, chunk, out_chunk.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_data_chunk_destroy[chunk_origin: MutOrigin](
        self,
        chunk: Pointer[duckdb_v2_data_chunk_handle, chunk_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys a data chunk handle.

        Null-safe: passing nullptr or a slot already set to nullptr is a no-op.
        On success the slot is set to nullptr. Any vector previously borrowed
        from this chunk becomes invalid.

        Args:
            chunk: The chunk to destroy.
        """
        return self._duckdb_v2_data_chunk_destroy(chunk.as_unsafe_any_origin())

    def duckdb_v2_data_chunk_clear[err_origin: MutOrigin](
        self,
        chunk: duckdb_v2_data_chunk_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Empties a data chunk so it can be filled again.

        The chunk's size becomes 0, and each of its vectors becomes a writable FLAT vector of its type again, as on
        creation, so a chunk can be reused for one batch after another instead of being created for each. Data, views
        and pointers taken from the chunk or its vectors beforehand do not survive this. Must not be called on a chunk
        DuckDB lends to a callback for reading.

        Args:
            chunk: The chunk to clear.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_data_chunk_clear(chunk, err.as_unsafe_any_origin())

    def duckdb_v2_data_chunk_get_size[out_size_origin: MutOrigin, err_origin: MutOrigin](
        self,
        chunk: duckdb_v2_data_chunk_handle,
        out_size: Pointer[idx_t, out_size_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the row count of a data chunk.

        Args:
            chunk: The chunk.
            out_size: Receives the row count.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_data_chunk_get_size(chunk, out_size.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_data_chunk_get_capacity[out_capacity_origin: MutOrigin, err_origin: MutOrigin](
        self,
        chunk: duckdb_v2_data_chunk_handle,
        out_capacity: Pointer[idx_t, out_capacity_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of rows a data chunk can hold, e.g. how many rows the exec callback of a table function may
        write into its output chunk in one call.

        Args:
            chunk: The chunk.
            out_capacity: Receives the number of rows the chunk can hold.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_data_chunk_get_capacity(chunk, out_capacity.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_data_chunk_get_vector_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        chunk: duckdb_v2_data_chunk_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of vectors in a data chunk.

        Equals the column count of the producing result.

        Args:
            chunk: The chunk.
            out_count: Receives the vector count.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_data_chunk_get_vector_count(chunk, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_data_chunk_get_vector[out_vector_origin: MutOrigin, err_origin: MutOrigin](
        self,
        chunk: duckdb_v2_data_chunk_handle,
        index: idx_t,
        out_vector: Pointer[duckdb_v2_vector_handle, out_vector_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the vector at the given index in a data chunk.

        The returned handle is borrowed and valid until the chunk is destroyed;
        do not destroy it. An out-of-range index returns ERROR_INPUT_INVALID.

        Args:
            chunk: The chunk.
            index: The vector index, in [0, vector_count).
            out_vector: Receives the borrowed vector handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via error_info_destroy.
        """
        return self._duckdb_v2_data_chunk_get_vector(chunk, index, out_vector.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Environment
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_environment_create[out_env_origin: MutOrigin, err_origin: MutOrigin](
        self,
        out_env: Pointer[duckdb_v2_environment_handle, out_env_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates the V2 environment. Call once at program start.

        Args:
            out_env: Receives the new environment handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_environment_create(out_env.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_environment_destroy[env_origin: MutOrigin](
        self,
        env: Pointer[duckdb_v2_environment_handle, env_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the environment.

        Refuses with ERROR_RESOURCE_IN_USE while any instance created through
        this environment is still alive; destroy those instances first, then
        retry. On success the handle is set to null.

        Args:
            env: The environment.
        """
        return self._duckdb_v2_environment_destroy(env.as_unsafe_any_origin())

    def duckdb_v2_environment_get_instance_count[out_count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        env: duckdb_v2_environment_handle,
        out_count: Pointer[idx_t, out_count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of instances currently alive under the environment.

        A diagnostic accessor, for tracking down leaked instances when
        `duckdb_v2_environment_destroy` returns ERROR_RESOURCE_IN_USE. The count is a
        snapshot and may change before the next call.

        Args:
            env: The environment.
            out_count: Receives the number of live instances.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_environment_get_instance_count(env, out_count.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Error
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_error_info_get_code[out_code_origin: MutOrigin](
        self,
        info: duckdb_v2_error_info_handle,
        out_code: Pointer[DUCKDB_V2_ERROR, out_code_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the error code associated with an error info handle.

        On success, writes the info's error code to `*out_code`. On failure
        (e.g. if `info` is invalid), leaves `*out_code` unchanged and returns
        a non-success error code.

        Args:
            info: The error info handle to query.
            out_code: The error code associated with the info, if the call succeeds.
        """
        return self._duckdb_v2_error_info_get_code(info, out_code.as_unsafe_any_origin())

    def duckdb_v2_error_info_get_text[out_text_origin: MutOrigin](
        self,
        info: duckdb_v2_error_info_handle,
        out_text: Pointer[duckdb_v2_str, out_text_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the error text associated with an error info handle.

        Returns a borrowed pointer to the info's null-terminated error text.
        The pointer is owned by DuckDB and is valid until the info is destroyed
        or a new text is set; callers must not free it, and must not read it once
        the info has been destroyed.

        Args:
            info: The error info handle to query.
            out_text: Receives a borrowed view of the text. Owned by DuckDB; valid until the info handle is destroyed.
        """
        return self._duckdb_v2_error_info_get_text(info, out_text.as_unsafe_any_origin())

    def duckdb_v2_error_info_get_raw_text[out_raw_text_origin: MutOrigin](
        self,
        info: duckdb_v2_error_info_handle,
        out_raw_text: Pointer[duckdb_v2_str, out_raw_text_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves the error text body without the leading category prefix.

        Returns a borrowed view of the same text error_info_get_text reports,
        minus the leading "<Type> Error: " prefix. This is the authoritative
        unprefixed body: the API exposes no type name, so the prefix cannot be
        reconstructed and the body cannot be derived from error_info_get_text.
        Unprefixed does not mean plain — the body keeps whatever form it was
        rendered in (a LINE/caret block by default, JSON under errors_as_json).
        `{NULL, 0}` when there is no text. The pointer is owned by DuckDB and
        valid until the info handle is destroyed.

        Args:
            info: The error info handle to query.
            out_raw_text: Receives a borrowed view of the raw text. Owned by DuckDB; valid until the info handle is destroyed.
        """
        return self._duckdb_v2_error_info_get_raw_text(info, out_raw_text.as_unsafe_any_origin())

    def duckdb_v2_error_info_set_code(
        self,
        info: duckdb_v2_error_info_handle,
        code: DUCKDB_V2_ERROR,
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the error code for an error info handle.

        On success, replaces the info's error code with the provided one. On
        failure, nothing is changed. Accepts a `nullptr` info handle, in which
        case the call is a no-op and returns ERROR_NONE.

        Args:
            info: The error info handle to set. On success, updated with the provided code.
            code: The error code to set in the info.
        """
        return self._duckdb_v2_error_info_set_code(info, code)

    def duckdb_v2_error_info_set_text[text_origin: ImmOrigin](
        self,
        info: duckdb_v2_error_info_handle,
        text: Pointer[duckdb_v2_str, text_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the error text for an error info handle.

        On success, replaces the info's text with the provided one; DuckDB
        allocates its own copy of the string. On failure, nothing is changed.
        Accepts a `nullptr` info handle, in which case the call is a no-op and
        returns ERROR_NONE.

        Args:
            info: The error info handle to set. On success, updated with the provided text.
            text: The error text to set in the info.
        """
        return self._duckdb_v2_error_info_set_text(info, text.as_unsafe_any_origin())

    def duckdb_v2_error_info_destroy[info_origin: MutOrigin](
        self,
        info: Pointer[duckdb_v2_error_info_handle, info_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys an error info handle and frees its resources.

        Null-safe: calling with a null handle, or a null pointer-to-handle, is a
        no-op and returns ERROR_NONE. On return `*info` is set to nullptr. Safe
        to call on any info DuckDB returned.

        Args:
            info: The error info handle to destroy. Set to nullptr on return.
        """
        return self._duckdb_v2_error_info_destroy(info.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Expression
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_expression_get_type[type__origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        type_: Pointer[DUCKDB_V2_EXPRESSION_TYPE, type__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the type of an expression node.

        The type decides which of the type-specific accessors apply, and what the node's children mean; see
        `EXPRESSION_TYPE`. A node of a type this API does not model reports `EXPRESSION_TYPE_INVALID`.

        Args:
            expression: The expression node.
            type_: Receives the node type.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_get_type(expression, type_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_expression_get_return_type[type__origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        type_: Pointer[duckdb_v2_logical_type_handle, type__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the logical type the expression node evaluates to.

        For a cast this is the target type. The returned type is owned by the caller and must be destroyed via
        `duckdb_v2_logical_type_destroy`.

        Args:
            expression: The expression node.
            type_: Receives the owned logical type.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_get_return_type(expression, type_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_expression_get_child_count[count_origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        count: Pointer[idx_t, count_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the number of child nodes of an expression node.

        Works for every node type, including `EXPRESSION_TYPE_INVALID`. Constants, parameters and column references
        have no children.

        Args:
            expression: The expression node.
            count: Receives the number of children.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_get_child_count(expression, count.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_expression_get_child[child_origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        index: idx_t,
        child: Pointer[duckdb_v2_expression_handle, child_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Retrieves a child node of an expression node by index.

        Fails if the index is out of bounds. Children are ordered as the node type describes (see
        `EXPRESSION_TYPE`). The child is borrowed and shares the lifetime of its parent.

        Args:
            expression: The expression node.
            index: The index of the child to retrieve.
            child: Receives the borrowed child node.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_get_child(expression, index, child.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_expression_constant_get_value[value_origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        value: Pointer[duckdb_v2_value_handle, value_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the value of a constant node.

        Fails if the node is not of type `EXPRESSION_TYPE_VALUE_CONSTANT`. The returned value is owned by the caller
        and must be destroyed via `duckdb_v2_value_destroy`.

        Args:
            expression: The constant node.
            value: Receives the owned constant value.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_constant_get_value(expression, value.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_expression_column_ref_get_index[index_origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        index: Pointer[idx_t, index_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the column a column reference node points at.

        Fails if the node is not of type `EXPRESSION_TYPE_BOUND_COLUMN_REF`. The index counts the columns of the
        operator the predicate is evaluated against, which is not necessarily the full set of columns that operator
        can produce: a callback resolves it through whatever handed it the expression, e.g.
        `duckdb_v2_table_function_filter_pushdown_get_column_index` for a filter offered to a table function.

        Args:
            expression: The column reference node.
            index: Receives the column index.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_column_ref_get_index(expression, index.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_expression_function_get_name[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the name of the scalar function a function node calls.

        Applies to `EXPRESSION_TYPE_BOUND_FUNCTION` and to the node types that are function calls underneath: the
        comparisons, `EXPRESSION_TYPE_COMPARE_BETWEEN` and `EXPRESSION_TYPE_OPERATOR_CAST`. Fails for any other node
        type. For a comparison the name is its operator, e.g. `<`; for `BETWEEN` and casts it is an internal name, so
        dispatch on the type rather than the name for those. The name is borrowed and shares the lifetime of the node.

        Args:
            expression: The function node.
            name: Receives a borrowed view of the function name.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_function_get_name(expression, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_expression_function_get_qname[name_origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        name: Pointer[duckdb_v2_qname_handle, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the qualified name of the scalar function a function node calls.

        Applies to the same node types as `duckdb_v2_expression_function_get_name`, and fails for any other. The name is
        qualified with the catalog and schema the function was resolved in, where known. The returned name is owned
        by the caller and must be destroyed via `duckdb_v2_qname_destroy`.

        Args:
            expression: The function node.
            name: Receives the owned qualified name.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_function_get_qname(expression, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_expression_cast_get_mode[mode_origin: MutOrigin, err_origin: MutOrigin](
        self,
        expression: duckdb_v2_expression_handle,
        mode: Pointer[DUCKDB_V2_CAST_MODE, mode_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns whether a cast node is a regular `CAST` or a `TRY_CAST`.

        Fails if the node is not of type `EXPRESSION_TYPE_OPERATOR_CAST`. A `TRY_CAST` yields NULL for a value it
        cannot convert where a regular `CAST` would fail the query.

        Args:
            expression: The cast node.
            mode: Receives the cast mode.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_expression_cast_get_mode(expression, mode.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Factory
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_instance_get_factory[out_factory_origin: MutOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        out_factory: Pointer[duckdb_v2_factory_handle, out_factory_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the factory of an instance.

        The factory creates the built-in types and their values, casts with the
        built-in casts only, and allocates data chunks and column data
        collections through the instance.
        Anything that needs a catalog — catalog-registered types, qualified type
        names — returns ERROR_INPUT_INVALID. The returned handle is borrowed: it
        is valid for as long as the instance is, and must not be destroyed.

        Args:
            instance: The instance.
            out_factory: Receives the borrowed factory.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_get_factory(instance, out_factory.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_get_factory[out_factory_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        out_factory: Pointer[duckdb_v2_factory_handle, out_factory_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the factory of a connection.

        The factory reaches the connection's catalog and settings. Catalog
        lookups run in the connection's active transaction, or in a transaction
        of their own when none is open; nothing else opens a transaction. The
        returned handle is borrowed: it is valid for as long as the connection
        is, and must not be destroyed.

        Args:
            conn: The connection.
            out_factory: Receives the borrowed factory.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_get_factory(conn, out_factory.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_context_get_factory[out_factory_origin: MutOrigin, err_origin: MutOrigin](
        self,
        ctx: duckdb_v2_context_handle,
        out_factory: Pointer[duckdb_v2_factory_handle, out_factory_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the factory of a context.

        The factory reaches the context's catalog and settings, within the
        transaction the context already has. The returned handle is borrowed:
        it is valid for as long as the context is, and must not be destroyed.

        Args:
            ctx: The context.
            out_factory: Receives the borrowed factory.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_context_get_factory(ctx, out_factory.as_unsafe_any_origin(), err.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # File system
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_context_get_file_system[file_system_origin: MutOrigin, err_origin: MutOrigin](
        self,
        context: duckdb_v2_context_handle,
        file_system: Pointer[duckdb_v2_file_system_handle, file_system_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the file system of a context.

        The returned handle is borrowed: it is valid only for as long as the context is, and must not be destroyed.

        Args:
            context: The context to take the file system from.
            file_system: Receives the borrowed file system.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_context_get_file_system(context, file_system.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_instance_get_file_system[file_system_origin: MutOrigin, err_origin: MutOrigin](
        self,
        instance: duckdb_v2_instance_handle,
        file_system: Pointer[duckdb_v2_file_system_handle, file_system_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the file system of an instance.

        Paths are resolved with the instance's GLOBAL settings and secrets, and file I/O is not attributed to any query.

        The returned handle is borrowed: it is valid only for as long as the instance is, and must not be destroyed.

        Args:
            instance: The instance to take the file system from.
            file_system: Receives the borrowed file system.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_instance_get_file_system(instance, file_system.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_connection_get_file_system[file_system_origin: MutOrigin, err_origin: MutOrigin](
        self,
        conn: duckdb_v2_connection_handle,
        file_system: Pointer[duckdb_v2_file_system_handle, file_system_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Borrows the file system of a connection.

        Paths are resolved with the connection's settings and secrets, and file I/O is attributed to its running query, as through `duckdb_v2_context_get_file_system` in a callback.

        The returned handle is borrowed: it is valid only for as long as the connection is, and must not be destroyed.

        Args:
            conn: The connection to take the file system from.
            file_system: Receives the borrowed file system.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_connection_get_file_system(conn, file_system.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_open_options_create[options_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file_system: duckdb_v2_file_system_handle,
        options: Pointer[duckdb_v2_file_open_options_handle, options_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a set of open options for a file system.

        The options start out empty: give them flags with `duckdb_v2_file_open_options_set_flag`, which is required, and
        optionally attach values with `duckdb_v2_file_open_options_set_value`. They are then passed to `duckdb_v2_file_system_open`,
        and can be reused for as many opens as you like. The caller owns the returned handle and must destroy it with
        `duckdb_v2_file_open_options_destroy`.

        The options belong to the file system they were created from, since which values mean anything depends on
        which file system ends up handling the path.

        Args:
            file_system: The file system the options are for.
            options: On success, receives the new options. Owned by the caller; destroy via `duckdb_v2_file_open_options_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_open_options_create(file_system, options.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_open_options_set_flag[err_origin: MutOrigin](
        self,
        options: duckdb_v2_file_open_options_handle,
        flag: DUCKDB_V2_FILE_FLAG,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Applies one flag to the options.

        Additive: call it once per behaviour you want, and applying the same flag twice is harmless. At least one
        flag must be applied before the options can open anything, since the flags are what say whether the file is
        being read or written. There is no way to take a flag back -- build a fresh set of options instead.

        `FILE_FLAG_INVALID` names no behaviour and is rejected, as is any value that is not a `duckdb_v2_FILE_FLAG`.

        Args:
            options: The options to apply the flag to.
            flag: The flag to apply.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_open_options_set_flag(options, flag, err.as_unsafe_any_origin())

    def duckdb_v2_file_open_options_set_value[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        options: duckdb_v2_file_open_options_handle,
        name: Pointer[duckdb_v2_str, name_origin],
        value: duckdb_v2_value_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Attaches a named value to the options.

        These are hints for whichever file system ends up handling the path, and what they mean is that file system's
        business: a value it does not recognise is ignored rather than rejected, and the same name can mean different
        things to different file systems. They are the same values a file system reports when listing files, so a
        known file size or modification time learned from a listing can be handed straight back to avoid re-reading
        it.

        The name and the value are borrowed and copied, so the caller may destroy the value immediately after.
        Setting the same name again replaces the previous value. Names are case-sensitive.

        Args:
            options: The options to set the value on.
            name: The name of the value. Borrowed and copied.
            value: The value. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_open_options_set_value(options, name.as_unsafe_any_origin(), value, err.as_unsafe_any_origin())

    def duckdb_v2_file_open_options_destroy[options_origin: MutOrigin](
        self,
        options: Pointer[duckdb_v2_file_open_options_handle, options_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the options, releasing their resources.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction. Files already opened with these options are unaffected.

        Args:
            options: The options to destroy.
        """
        return self._duckdb_v2_file_open_options_destroy(options.as_unsafe_any_origin())

    def duckdb_v2_file_system_open[file_path_origin: ImmOrigin, file_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file_system: duckdb_v2_file_system_handle,
        file_path: Pointer[duckdb_v2_str, file_path_origin],
        options: duckdb_v2_file_open_options_handle,
        file: Pointer[duckdb_v2_file_handle, file_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Opens a file.

        Opens the file at the given path through the file system, which routes it the way the engine would -- a path
        handled by a registered virtual or remote file system goes there rather than to local disk. The returned
        handle is owned by the caller and must be destroyed with `duckdb_v2_file_destroy`.

        The options carry the flags and any file-system-specific values; see `duckdb_v2_file_open_options_create`. Opening
        without having set flags fails, since the flags are what say whether the file is being read or written.

        Failure to open -- a missing file without `FILE_FLAG_CREATE`, insufficient permissions, an existing file
        under `FILE_FLAG_EXCLUSIVE_CREATE` -- is reported as an error.

        Flag combinations that contradict each other, such as naming neither read nor write or combining
        `FILE_FLAG_CREATE` with `FILE_FLAG_CREATE_NEW`, are a programming error rather than a supported input. An
        assertion build catches them; elsewhere the behaviour is whatever the underlying file system does with them.

        Args:
            file_system: The file system to open the file through.
            file_path: The path of the file to open. Borrowed for the call only.
            options: How to open the file. Borrowed for the call only, and reusable across opens.
            file: On success, receives the open file. Owned by the caller; destroy via `duckdb_v2_file_destroy`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_system_open(file_system, file_path.as_unsafe_any_origin(), options, file.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_system_path_exists[path_origin: ImmOrigin, out_exists_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file_system: duckdb_v2_file_system_handle,
        path: Pointer[duckdb_v2_str, path_origin],
        out_exists: Pointer[Bool, out_exists_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports whether a file exists at the given path.

        The path is routed the way `duckdb_v2_file_system_open` routes it, so asking about a path handled by a remote file
        system may reach out to it. A directory is not a file, and reports false.

        Args:
            file_system: The file system to ask.
            path: The path to check. Borrowed for the call only.
            out_exists: Receives whether a file exists at the path.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_system_path_exists(file_system, path.as_unsafe_any_origin(), out_exists.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_system_path_is_remote[path_origin: ImmOrigin, out_is_remote_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file_system: duckdb_v2_file_system_handle,
        path: Pointer[duckdb_v2_str, path_origin],
        out_is_remote: Pointer[Bool, out_is_remote_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reports whether a path names a remote file, e.g. one under `s3://`, `https://`, `gcs://` or `azure://`.

        Decided from the path alone: no file system is consulted, so it answers even when the extension providing the
        remote file system is not loaded.

        Args:
            file_system: The file system the path is meant for.
            path: The path to check. Borrowed for the call only.
            out_is_remote: Receives whether the path names a remote file.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_system_path_is_remote(file_system, path.as_unsafe_any_origin(), out_is_remote.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_system_path_expand[path_origin: ImmOrigin, user_data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file_system: duckdb_v2_file_system_handle,
        path: Pointer[duckdb_v2_str, path_origin],
        sink: duckdb_v2_text_sink_fn,
        user_data: Pointer[NoneType, user_data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Expands a path as the file system does when opening it: a leading `~` becomes the home directory, as the
        `home_directory` setting configures it.

        A path without anything to expand is handed back as it is. The expanded path is handed to `sink` in a single
        call.

        Args:
            file_system: The file system whose settings expand the path.
            path: The path to expand. Borrowed for the call only.
            sink: Receives the expanded path in a single call. Borrowed for the duration of that call; see text_sink for the full contract.
            user_data: Opaque pointer passed through to sink untouched. May be NULL.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_system_path_expand(file_system, path.as_unsafe_any_origin(), sink, user_data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_system_path_glob[pattern_origin: ImmOrigin, user_data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file_system: duckdb_v2_file_system_handle,
        pattern: Pointer[duckdb_v2_str, pattern_origin],
        callback: duckdb_v2_file_system_path_glob_callback_fn,
        user_data: Pointer[NoneType, user_data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Finds the files matching a glob pattern, e.g. `*.csv` or `data_?.json` in a directory, handing each matched path to
        `callback`.

        The pattern is routed the way `duckdb_v2_file_system_open` routes a path, so globbing a remote path may reach out to
        the file system handling it, and is only supported where that file system supports it. A pattern without glob
        characters matches the file it names, if there is one. Matching nothing is not an error. In which order the
        paths are handed over is up to the file system.

        Args:
            file_system: The file system to glob in.
            pattern: The glob pattern. Borrowed for the call only.
            callback: Invoked once per matched path.
            user_data: Opaque pointer passed through to `callback` untouched. May be NULL.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_system_path_glob(file_system, pattern.as_unsafe_any_origin(), callback, user_data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_system_path_move[source_origin: ImmOrigin, target_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        file_system: duckdb_v2_file_system_handle,
        source: Pointer[duckdb_v2_str, source_origin],
        target: Pointer[duckdb_v2_str, target_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Moves, or renames, a file from one path to another.

        The move is handled by the file system `source` routes to, the way `duckdb_v2_file_system_open` routes a path; moving
        a file between two file systems is not supported. Whether an existing file at `target` is replaced, and whether
        the move is atomic, is up to that file system.

        Args:
            file_system: The file system to move the file in.
            source: The path of the file to move. Borrowed for the call only.
            target: The path to move the file to. Borrowed for the call only.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_system_path_move(file_system, source.as_unsafe_any_origin(), target.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_system_path_remove[path_origin: ImmOrigin, out_removed_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file_system: duckdb_v2_file_system_handle,
        path: Pointer[duckdb_v2_str, path_origin],
        out_removed: Pointer[Bool, out_removed_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Removes the file at a path, if there is one.

        The path is routed the way `duckdb_v2_file_system_open` routes it. A path with no file is not an error: `out_removed`
        then receives false. A file that exists but cannot be removed is.

        Args:
            file_system: The file system to remove the file from.
            path: The path of the file to remove. Borrowed for the call only.
            out_removed: Optional. Receives whether a file was removed.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_system_path_remove(file_system, path.as_unsafe_any_origin(), out_removed.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_read[buffer_origin: MutOrigin, bytes_read_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        buffer: Pointer[NoneType, buffer_origin],
        buffer_size: idx_t,
        bytes_read: Pointer[idx_t, bytes_read_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reads from the file into a caller-supplied buffer.

        Reads up to `buffer_size` bytes from the file's current position, advancing it by however many were read.
        Fewer bytes than asked for is normal at the end of the file, and zero means there is nothing left; neither is
        an error. The file must have been opened with `FILE_FLAG_READ`.

        Use `duckdb_v2_file_read_at` to read at an explicit offset instead, which leaves the position alone and so can run
        on several threads at once.

        Args:
            file: The file to read from.
            buffer: A caller-owned buffer of at least `buffer_size` bytes, receiving what was read.
            buffer_size: The maximum number of bytes to read.
            bytes_read: Receives how many bytes were actually read, which may be fewer than `buffer_size` at the end of the file.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_read(file, buffer.as_unsafe_any_origin(), buffer_size, bytes_read.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_write[buffer_origin: ImmOrigin, bytes_written_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        buffer: Pointer[NoneType, buffer_origin],
        buffer_size: idx_t,
        bytes_written: Pointer[idx_t, bytes_written_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Writes a caller-supplied buffer to the file.

        Writes up to `buffer_size` bytes at the file's current position, advancing it by however many were written.
        The file must have been opened with `FILE_FLAG_WRITE` or `FILE_FLAG_APPEND`. Writes may be buffered; use
        `duckdb_v2_file_sync` to force them out.

        Use `duckdb_v2_file_write_at` to write at an explicit offset instead, which leaves the position alone and so can run
        on several threads at once.

        Args:
            file: The file to write to.
            buffer: A caller-owned buffer of at least `buffer_size` bytes, holding what to write.
            buffer_size: The number of bytes to write.
            bytes_written: Receives how many bytes were actually written.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_write(file, buffer.as_unsafe_any_origin(), buffer_size, bytes_written.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_read_at[buffer_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        buffer: Pointer[NoneType, buffer_origin],
        buffer_size: idx_t,
        location: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Reads from a fixed offset, without moving the file's position.

        Reads exactly `buffer_size` bytes starting at `location`. Unlike `duckdb_v2_file_read`, a short read is an error
        rather than a result: reaching the end of the file before `buffer_size` bytes fails, so there is no count to
        report back. The file's read/write position is untouched, which is what makes this safe to call from several
        threads at once -- provided the file was opened with `FILE_FLAG_PARALLEL_ACCESS`.

        The file must have been opened with `FILE_FLAG_READ`.

        Args:
            file: The file to read from.
            buffer: A caller-owned buffer of at least `buffer_size` bytes, receiving what was read.
            buffer_size: The number of bytes to read. All of them are read, or the call fails.
            location: The absolute byte offset to read from, measured from the start of the file.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_read_at(file, buffer.as_unsafe_any_origin(), buffer_size, location, err.as_unsafe_any_origin())

    def duckdb_v2_file_write_at[buffer_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        buffer: Pointer[NoneType, buffer_origin],
        buffer_size: idx_t,
        location: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Writes at a fixed offset, without moving the file's position.

        Writes exactly `buffer_size` bytes starting at `location`, extending the file when the offset is past its end.
        Unlike `duckdb_v2_file_write` there is no count to report back: all of the bytes are written, or the call fails. The
        file's read/write position is untouched, which is what makes this safe to call from several threads at once --
        provided the file was opened with `FILE_FLAG_PARALLEL_ACCESS`, and that the threads write disjoint ranges.

        The file must have been opened with `FILE_FLAG_WRITE`. Writes may be buffered; use `duckdb_v2_file_sync` to force
        them out.

        Args:
            file: The file to write to.
            buffer: A caller-owned buffer of at least `buffer_size` bytes, holding what to write.
            buffer_size: The number of bytes to write. All of them are written, or the call fails.
            location: The absolute byte offset to write at, measured from the start of the file.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_write_at(file, buffer.as_unsafe_any_origin(), buffer_size, location, err.as_unsafe_any_origin())

    def duckdb_v2_file_tell[position_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        position: Pointer[idx_t, position_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the file's current read/write position, as a byte offset from the start of the file.

        Args:
            file: The file to query.
            position: Receives the current position, as a byte offset from the start of the file.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_tell(file, position.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_size[size_origin: MutOrigin, err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        size: Pointer[idx_t, size_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the total size of the file in bytes.

        Args:
            file: The file to query.
            size: Receives the total size of the file in bytes.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_size(file, size.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_file_seek[err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        position: idx_t,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Moves the file's read/write position.

        Sets the position to an absolute byte offset from the start of the file; subsequent reads and writes start
        there. Seeking past the end is allowed, and reading from there yields nothing.

        Args:
            file: The file to seek within.
            position: The absolute byte offset to seek to, measured from the start of the file.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_seek(file, position, err.as_unsafe_any_origin())

    def duckdb_v2_file_sync[err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Flushes buffered writes to persistent storage.

        Forces anything still buffered out to storage, which is what makes writes durable across a crash or a
        process exit. Closing or destroying the handle flushes as well.

        Args:
            file: The file to synchronize.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_sync(file, err.as_unsafe_any_origin())

    def duckdb_v2_file_close[err_origin: MutOrigin](
        self,
        file: duckdb_v2_file_handle,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Closes the file without destroying the handle.

        Releases the operating-system resources behind the file, such as its descriptor. The handle itself stays
        valid and must still be destroyed with `duckdb_v2_file_destroy`, but it can no longer read, write or seek.

        Args:
            file: The file to close.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_file_close(file, err.as_unsafe_any_origin())

    def duckdb_v2_file_destroy[file_origin: MutOrigin](
        self,
        file: Pointer[duckdb_v2_file_handle, file_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Destroys the file, closing it if it is still open.

        Null-safe: passing a null pointer or null handle is a no-op. The handle is set to null on return to prevent
        double-destruction.

        Args:
            file: The file to destroy.
        """
        return self._duckdb_v2_file_destroy(file.as_unsafe_any_origin())


    # ===--------------------------------------------------------------------===#
    # Aggregate
    # ===--------------------------------------------------------------------===#

    def duckdb_v2_aggregate_function_create[function__origin: MutOrigin, err_origin: MutOrigin](
        self,
        factory: duckdb_v2_factory_handle,
        function_: Pointer[duckdb_v2_aggregate_function_handle, function__origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Creates a new aggregate function through a factory.

        The function starts out empty: configure it with the setter functions (e.g. `duckdb_v2_aggregate_function_set_name`,
        `duckdb_v2_aggregate_function_set_update_callback`, etc.) and the signature obtained via
        `duckdb_v2_aggregate_function_get_signature`, then make it available with `duckdb_v2_connection_register_aggregate_function` or `duckdb_v2_extension_register_aggregate_function`. The caller owns the returned handle and must destroy it with
        `duckdb_v2_aggregate_function_destroy`, also after registration.

        The aggregate function can only be registered on the database the factory belongs to.

        Args:
            factory: The factory to create the aggregate function through.
            function_: On success, receives the newly created aggregate function. Owned by the caller.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_aggregate_function_create(factory, function_.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_aggregate_function_set_name[name_origin: ImmOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_aggregate_function_handle,
        name: Pointer[duckdb_v2_identifier_t, name_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets the name of the aggregate function.

        The name is borrowed and copied. Calling this again replaces the previous name.
        A name must be set before registration.

        Args:
            function_: The function to set the name of.
            name: The name to set. Borrowed and copied.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_aggregate_function_set_name(function_, name.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_aggregate_function_get_docs[docs_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_aggregate_function_handle,
        docs: Pointer[duckdb_v2_function_docs_handle, docs_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the documentation of the function so it can be filled in.

        Set a description with `duckdb_v2_function_docs_set_description`, and add examples and categories with
        `duckdb_v2_function_docs_add_example` and `duckdb_v2_function_docs_add_category`. The documentation is modified in place, describes this overload only, and is
        registered with the function. Optional.

        Args:
            function_: The function to get the documentation of.
            docs: The returned documentation. Borrowed and valid for the lifetime of the function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_aggregate_function_get_docs(function_, docs.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_aggregate_function_get_signature[sig_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_aggregate_function_handle,
        sig: Pointer[duckdb_v2_function_signature_handle, sig_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Returns the function's signature so it can be configured.

        Add parameters with `duckdb_v2_function_signature_add_parameter` and set the return type with
        `duckdb_v2_function_signature_set_return_type`.
        The signature is modified in place; the function must be given a signature with a return type before
        registration.

        Args:
            function_: The function to get the signature of.
            sig: The returned signature. Borrowed and valid for the lifetime of the function handle.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_aggregate_function_get_signature(function_, sig.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_aggregate_function_set_user_data[data_origin: MutOrigin, err_origin: MutOrigin](
        self,
        function_: duckdb_v2_aggregate_function_handle,
        data: Pointer[duckdb_v2_opaque, data_origin],
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets arbitrary user data on the aggregate function.

        Associates an opaque pointer with the function, retrievable from each callback via its user data accessor
        (e.g. `duckdb_v2_function_bind_get_user_data`, `duckdb_v2_aggregate_function_update_get_user_data`, etc.).
        The opaque handle bundles the pointer with an optional destructor, invoked when the data is no longer
        needed.

        Args:
            function_: The function to set the user data of.
            data: Opaque handle bundling the user data pointer plus an optional destructor.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_aggregate_function_set_user_data(function_, data.as_unsafe_any_origin(), err.as_unsafe_any_origin())

    def duckdb_v2_aggregate_function_set_property[err_origin: MutOrigin](
        self,
        function_: duckdb_v2_aggregate_function_handle,
        key: DUCKDB_V2_FUNCTION_PROPERTY_KEY,
        value: DUCKDB_V2_FUNCTION_PROPERTY_VALUE,
        err: Pointer[duckdb_v2_error_info_handle, err_origin],
    ) -> DUCKDB_V2_ERROR:
        """
        Sets a property on the aggregate function.

        Configures a function property that influences planning and execution, such as stability, NULL handling,
        fallibility, collation handling, or the aggregate-specific order/DISTINCT dependence. The value must be
        one of the `duckdb_v2_FUNCTION_PROPERTY_VALUE` entries belonging to `key`; passing a value that does not belong
        to the key, or a key that is not valid for aggregate functions, results in an error.

        Args:
            function_: The function to set the property of.
            key: The property to set.
            value: The value to set for the property. Must belong to `key`.
            err: Optional. On failure, receives an opaque info handle the caller must destroy via `duckdb_v2_error_info_destroy`.
        """
        return self._duckdb_v2_aggregate_function_set_property(function_, key, value, err.as_unsafe_any_origin())

