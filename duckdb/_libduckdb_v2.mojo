struct duckdb_ext_api_v2:
    """The stable part of the V2 extension API function pointer struct.

    Holds the functions that are stable as of `DUCKDB_V2_EXTENSION_API_VERSION`
    (0 function pointers). An extension that only uses these loads
    in that DuckDB version and every later 2.x release."""

    # No V2 function is stable yet.
    pass


