comptime DUCKDB_V2_FUNCTION_PROPERTY_COLLATION_HANDLING: DUCKDB_V2_FUNCTION_PROPERTY_KEY = 66304
# Aggregate only. Whether the aggregate's result depends on the order in which rows are aggregated. Accepts the `FUNCTION_PROPERTY_AGG_ORDER_DEPENDENT_*` values. Defaults to `YES`.
comptime DUCKDB_V2_FUNCTION_PROPERTY_AGG_ORDER_DEPENDENT: DUCKDB_V2_FUNCTION_PROPERTY_KEY = 196608
# Aggregate only. Whether the aggregate's result is affected by a DISTINCT modifier. Accepts the `FUNCTION_PROPERTY_AGG_DISTINCT_DEPENDENT_*` values. Defaults to `YES`.
comptime DUCKDB_V2_FUNCTION_PROPERTY_AGG_DISTINCT_DEPENDENT: DUCKDB_V2_FUNCTION_PROPERTY_KEY = 196864

#! A value for a `duckdb_v2_FUNCTION_PROPERTY_KEY`. Each key owns a 256-value block: a
#! value `V` is valid for key `K` iff `(V & 0xFFFF00) == K`, and shares the
#! key's function-type group (`V & 0xFF0000`) in its high byte. Passing a
#! value that does not match the key is rejected with an error. Boolean-like
#! properties are expressed as named values so that additional values can be
#! added later without breaking the ABI.
comptime DUCKDB_V2_FUNCTION_PROPERTY_VALUE = Int32
# The function always returns the same result given the same input.
comptime DUCKDB_V2_FUNCTION_PROPERTY_STABILITY_CONSISTENT: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 65536
# The result may differ per row (e.g. random()).
comptime DUCKDB_V2_FUNCTION_PROPERTY_STABILITY_VOLATILE: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 65537
# The result is stable within a single query/transaction but may change across queries (e.g. now()).
comptime DUCKDB_V2_FUNCTION_PROPERTY_STABILITY_CONSISTENT_WITHIN_QUERY: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 65538
# Default NULL handling: if any argument is NULL the result is NULL and the function is not invoked for that row.
comptime DUCKDB_V2_FUNCTION_PROPERTY_NULL_HANDLING_DEFAULT: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 65792
# The function handles NULL inputs itself and is invoked even when arguments are NULL.
comptime DUCKDB_V2_FUNCTION_PROPERTY_NULL_HANDLING_SPECIAL: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 65793
# The function never raises a runtime error. Declaring this promises that the callbacks never report an error; an error reported anyway becomes an internal error.
comptime DUCKDB_V2_FUNCTION_PROPERTY_FALLIBILITY_INFALLIBLE: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 66048
# The function may raise a runtime error for some inputs.
comptime DUCKDB_V2_FUNCTION_PROPERTY_FALLIBILITY_FALLIBLE: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 66049
# The function combines collations from its inputs and propagates them to its result (default).
comptime DUCKDB_V2_FUNCTION_PROPERTY_COLLATION_HANDLING_PROPAGATE: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 66304
# Combinable collations are executed on the input arguments before the function runs.
comptime DUCKDB_V2_FUNCTION_PROPERTY_COLLATION_HANDLING_PUSH_COMBINABLE: DUCKDB_V2_FUNCTION_PROPERTY_VALUE = 66305
# Collations are ignored by the function.
