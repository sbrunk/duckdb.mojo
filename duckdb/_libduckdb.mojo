    # ===--------------------------------------------------------------------===#
    # Hugeint And Uhugeint Helpers
    # ===--------------------------------------------------------------------===#

    def duckdb_hugeint_to_double(
        self,
        val: duckdb_hugeint,
    ) -> Float64:
        """
        Converts a duckdb_hugeint object (as obtained from a `DUCKDB_TYPE_HUGEINT` column) into a double.
        """
        return self._duckdb_hugeint_to_double(val)

    def duckdb_double_to_hugeint(
        self,
        val: Float64,
    ) -> duckdb_hugeint:
        """
        Converts a double value to a duckdb_hugeint object.

        If the conversion fails because the double value is too big the result will be 0.
        """
        return self._duckdb_double_to_hugeint(val)

    def duckdb_uhugeint_to_double(
        self,
        val: duckdb_uhugeint,
    ) -> Float64:
        """
        Converts a duckdb_uhugeint object (as obtained from a `DUCKDB_TYPE_UHUGEINT` column) into a double.
        """
        return self._duckdb_uhugeint_to_double(val)

    def duckdb_double_to_uhugeint(
        self,
        val: Float64,
    ) -> duckdb_uhugeint:
        """
        Converts a double value to a duckdb_uhugeint object.

        If the conversion fails because the double value is too big the result will be 0.
        """
        return self._duckdb_double_to_uhugeint(val)


    # ===--------------------------------------------------------------------===#
    # Decimal Helpers
    # ===--------------------------------------------------------------------===#

    def duckdb_double_to_decimal(
        self,
        val: Float64,
        width: UInt8,
        scale: UInt8,
    ) -> duckdb_decimal:
        """
        Converts a double value to a duckdb_decimal object.

        If the conversion fails because the double value is too big, or the width/scale are invalid the result will be 0.
        """
        return self._duckdb_double_to_decimal(val, width, scale)

    def duckdb_decimal_to_double(
        self,
        val: duckdb_decimal,
    ) -> Float64:
        """
        Converts a duckdb_decimal object (as obtained from a `DUCKDB_TYPE_DECIMAL` column) into a double.
        """
        return self._duckdb_decimal_to_double(val)


    # ===--------------------------------------------------------------------===#
    # Prepared Statements
    # ===--------------------------------------------------------------------===#

    def duckdb_prepare[query_origin: ImmOrigin, out_prepared_statement_origin: ImmOrigin](
        self,
        connection: duckdb_connection,
        query: Pointer[c_char, query_origin],
        out_prepared_statement: Pointer[duckdb_prepared_statement, out_prepared_statement_origin],
    ) -> duckdb_state:
        """
        Create a prepared statement object from a query.

        Note that after calling `duckdb_prepare`, the prepared statement should always be destroyed using
        `duckdb_destroy_prepare`, even if the prepare fails.

        If the prepare fails, `duckdb_prepare_error` can be called to obtain the reason why the prepare failed.
        """
        return self._duckdb_prepare(connection, query.as_unsafe_any_origin(), out_prepared_statement.as_unsafe_any_origin())

    def duckdb_destroy_prepare[prepared_statement_origin: ImmOrigin](
        self,
        prepared_statement: Pointer[duckdb_prepared_statement, prepared_statement_origin],
    ) -> NoneType:
        """
        Closes the prepared statement and de-allocates all memory allocated for the statement.
        """
        return self._duckdb_destroy_prepare(prepared_statement.as_unsafe_any_origin())

    def duckdb_prepare_error(
        self,
        prepared_statement: duckdb_prepared_statement,
    ) -> Pointer[c_char, ImmutAnyOrigin]:
        """
        Returns the error message associated with the given prepared statement.
        If the prepared statement has no error message, this returns `nullptr` instead.

        The error message should not be freed. It will be de-allocated when `duckdb_destroy_prepare` is called.
        """
        return self._duckdb_prepare_error(prepared_statement)

    def duckdb_nparams(
        self,
        prepared_statement: duckdb_prepared_statement,
    ) -> idx_t:
        """
        Returns the number of parameters that can be provided to the given prepared statement.

        Returns 0 if the query was not successfully prepared.
        """
        return self._duckdb_nparams(prepared_statement)

    def duckdb_parameter_name(
        self,
        prepared_statement: duckdb_prepared_statement,
        index: idx_t,
    ) -> Pointer[c_char, ImmutAnyOrigin]:
        """
        Returns the name used to identify the parameter
        The returned string should be freed using `duckdb_free`.

        Returns NULL if the index is out of range for the provided prepared statement.
        """
        return self._duckdb_parameter_name(prepared_statement, index)

    def duckdb_param_type(
        self,
        prepared_statement: duckdb_prepared_statement,
        param_idx: idx_t,
    ) -> duckdb_type:
        """
        Returns the parameter type for the parameter at the given index.

        Returns `DUCKDB_TYPE_INVALID` if the parameter index is out of range or the statement was not successfully prepared.
        """
        return self._duckdb_param_type(prepared_statement, param_idx)

    def duckdb_param_logical_type(
        self,
        prepared_statement: duckdb_prepared_statement,
        param_idx: idx_t,
    ) -> duckdb_logical_type:
        """
        Returns the logical type for the parameter at the given index.

        Returns `nullptr` if the parameter index is out of range or the statement was not successfully prepared.

        The return type of this call should be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_param_logical_type(prepared_statement, param_idx)

    def duckdb_clear_bindings(
        self,
        prepared_statement: duckdb_prepared_statement,
    ) -> duckdb_state:
        """
        Clear the params bind to the prepared statement.
        """
        return self._duckdb_clear_bindings(prepared_statement)

    def duckdb_prepared_statement_type(
        self,
        statement: duckdb_prepared_statement,
    ) -> duckdb_statement_type:
        """
        Returns the statement type of the statement to be executed.
        """
        return self._duckdb_prepared_statement_type(statement)

    def duckdb_prepared_statement_column_count(
        self,
        prepared_statement: duckdb_prepared_statement,
    ) -> idx_t:
        """
        Returns the number of columns present in a the result of the prepared statement. If any of the column types are invalid, the result will be 1.
        """
        return self._duckdb_prepared_statement_column_count(prepared_statement)

    def duckdb_prepared_statement_column_name(
        self,
        prepared_statement: duckdb_prepared_statement,
        col_idx: idx_t,
    ) -> Pointer[c_char, ImmutAnyOrigin]:
        """
        Returns the name of the specified column of the result of the prepared_statement.
        The returned string should be freed using `duckdb_free`.

        Returns `nullptr` if the column is out of range.
        """
        return self._duckdb_prepared_statement_column_name(prepared_statement, col_idx)

    def duckdb_prepared_statement_column_logical_type(
        self,
        prepared_statement: duckdb_prepared_statement,
        col_idx: idx_t,
    ) -> duckdb_logical_type:
        """
        Returns the column type of the specified column of the result of the prepared_statement.

        Returns `DUCKDB_TYPE_INVALID` if the column is out of range.
        The return type of this call should be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_prepared_statement_column_logical_type(prepared_statement, col_idx)

    def duckdb_prepared_statement_column_type(
        self,
        prepared_statement: duckdb_prepared_statement,
        col_idx: idx_t,
    ) -> duckdb_type:
        """
        Returns the column type of the specified column of the result of the prepared_statement.

        Returns `DUCKDB_TYPE_INVALID` if the column is out of range.
        """
        return self._duckdb_prepared_statement_column_type(prepared_statement, col_idx)


    # ===--------------------------------------------------------------------===#
    # Bind Values To Prepared Statements
    # ===--------------------------------------------------------------------===#

    def duckdb_bind_value(
        self,
        prepared_statement: duckdb_prepared_statement,
        param_idx: idx_t,
        val: duckdb_value,
    ) -> duckdb_state:
        """
        Binds a value to the prepared statement at the specified index.

        Supersedes all type-specific bind functions (e.g., `duckdb_bind_varchar`, `duckdb_bind_int64`, etc.).
        """
        return self._duckdb_bind_value(prepared_statement, param_idx, val)

    def duckdb_bind_parameter_index[param_idx_out_origin: MutOrigin, name_origin: ImmOrigin](
        self,
        prepared_statement: duckdb_prepared_statement,
        param_idx_out: Pointer[idx_t, param_idx_out_origin],
        name: Pointer[c_char, name_origin],
    ) -> duckdb_state:
        """
        Retrieve the index of the parameter for the prepared statement, identified by name.
        """
        return self._duckdb_bind_parameter_index(prepared_statement, param_idx_out.as_unsafe_any_origin(), name.as_unsafe_any_origin())

    def duckdb_bind_boolean(
        self,
        prepared_statement: duckdb_prepared_statement,
        param_idx: idx_t,
