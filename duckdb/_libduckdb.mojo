    # ===--------------------------------------------------------------------===#
    # Logical Type Interface
    # ===--------------------------------------------------------------------===#

    def duckdb_create_logical_type(
        self,
        type_: duckdb_type,
    ) -> duckdb_logical_type:
        """
        Creates a `duckdb_logical_type` from a primitive type.
        The resulting logical type must be destroyed with `duckdb_destroy_logical_type`.

        Returns an invalid logical type, if type is: `DUCKDB_TYPE_INVALID`, `DUCKDB_TYPE_DECIMAL`, `DUCKDB_TYPE_ENUM`,
        `DUCKDB_TYPE_LIST`, `DUCKDB_TYPE_STRUCT`, `DUCKDB_TYPE_MAP`, `DUCKDB_TYPE_ARRAY`, or `DUCKDB_TYPE_UNION`.
        """
        return self._duckdb_create_logical_type(type_)

    def duckdb_logical_type_get_alias(
        self,
        type_: duckdb_logical_type,
    ) -> Pointer[c_char, MutUntrackedOrigin]:
        """
        Returns the alias of a duckdb_logical_type, if set, else `nullptr`.
        The result must be destroyed with `duckdb_free`.
        """
        return self._duckdb_logical_type_get_alias(type_)

    def duckdb_logical_type_set_alias[alias__origin: ImmOrigin](
        self,
        type_: duckdb_logical_type,
        alias_: Pointer[c_char, alias__origin],
    ) -> NoneType:
        """
        Sets the alias of a duckdb_logical_type.
        """
        return self._duckdb_logical_type_set_alias(type_, alias_.as_unsafe_any_origin())

    def duckdb_create_list_type(
        self,
        type_: duckdb_logical_type,
    ) -> duckdb_logical_type:
        """
        Creates a LIST type from its child type.
        The return type must be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_create_list_type(type_)

    def duckdb_create_array_type(
        self,
        type_: duckdb_logical_type,
        array_size: idx_t,
    ) -> duckdb_logical_type:
        """
        Creates an ARRAY type from its child type.
        The return type must be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_create_array_type(type_, array_size)

    def duckdb_create_map_type(
        self,
        key_type: duckdb_logical_type,
        value_type: duckdb_logical_type,
    ) -> duckdb_logical_type:
        """
        Creates a MAP type from its key type and value type.
        The return type must be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_create_map_type(key_type, value_type)

    def duckdb_create_union_type[member_types_origin: ImmOrigin, member_names_origin: MutOrigin](
        self,
        member_types: Pointer[duckdb_logical_type, member_types_origin],
        member_names: Pointer[Pointer[c_char, ImmutAnyOrigin], member_names_origin],
        member_count: idx_t,
    ) -> duckdb_logical_type:
        """
        Creates a UNION type from the passed arrays.
        The return type must be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_create_union_type(member_types.as_unsafe_any_origin(), member_names.as_unsafe_any_origin(), member_count)

    def duckdb_create_struct_type[member_types_origin: ImmOrigin, member_names_origin: MutOrigin](
        self,
        member_types: Pointer[duckdb_logical_type, member_types_origin],
        member_names: Pointer[Pointer[c_char, ImmutAnyOrigin], member_names_origin],
        member_count: idx_t,
    ) -> duckdb_logical_type:
        """
        Creates a STRUCT type based on the member types and names.
        The resulting type must be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_create_struct_type(member_types.as_unsafe_any_origin(), member_names.as_unsafe_any_origin(), member_count)

    def duckdb_create_enum_type[member_names_origin: MutOrigin](
        self,
        member_names: Pointer[Pointer[c_char, ImmutAnyOrigin], member_names_origin],
        member_count: idx_t,
    ) -> duckdb_logical_type:
        """
        Creates an ENUM type from the passed member name array.
        The resulting type should be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_create_enum_type(member_names.as_unsafe_any_origin(), member_count)

    def duckdb_create_decimal_type(
        self,
        width: UInt8,
        scale: UInt8,
    ) -> duckdb_logical_type:
        """
        Creates a DECIMAL type with the specified width and scale.
        The resulting type should be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_create_decimal_type(width, scale)

    def duckdb_get_type_id(
        self,
        type_: duckdb_logical_type,
    ) -> duckdb_type:
        """
        Retrieves the enum `duckdb_type` of a `duckdb_logical_type`.
        """
        return self._duckdb_get_type_id(type_)

    def duckdb_decimal_width(
        self,
        type_: duckdb_logical_type,
    ) -> UInt8:
        """
        Retrieves the width of a decimal type.
        """
        return self._duckdb_decimal_width(type_)

    def duckdb_decimal_scale(
        self,
        type_: duckdb_logical_type,
    ) -> UInt8:
        """
        Retrieves the scale of a decimal type.
        """
        return self._duckdb_decimal_scale(type_)

    def duckdb_decimal_internal_type(
        self,
        type_: duckdb_logical_type,
    ) -> duckdb_type:
        """
        Retrieves the internal storage type of a decimal type.
        """
        return self._duckdb_decimal_internal_type(type_)

    def duckdb_enum_internal_type(
        self,
        type_: duckdb_logical_type,
    ) -> duckdb_type:
        """
        Retrieves the internal storage type of an enum type.
        """
        return self._duckdb_enum_internal_type(type_)

    def duckdb_enum_dictionary_size(
        self,
        type_: duckdb_logical_type,
    ) -> UInt32:
        """
        Retrieves the dictionary size of the enum type.
        """
        return self._duckdb_enum_dictionary_size(type_)

    def duckdb_enum_dictionary_value(
        self,
        type_: duckdb_logical_type,
        index: idx_t,
    ) -> Pointer[c_char, MutUntrackedOrigin]:
        """
        Retrieves the dictionary value at the specified position from the enum.

        The result must be freed with `duckdb_free`.
        """
        return self._duckdb_enum_dictionary_value(type_, index)

    def duckdb_list_type_child_type(
        self,
        type_: duckdb_logical_type,
    ) -> duckdb_logical_type:
        """
        Retrieves the child type of the given LIST type. Also accepts MAP types.
        The result must be freed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_list_type_child_type(type_)

    def duckdb_array_type_child_type(
        self,
        type_: duckdb_logical_type,
    ) -> duckdb_logical_type:
        """
        Retrieves the child type of the given ARRAY type.

        The result must be freed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_array_type_child_type(type_)

    def duckdb_array_type_array_size(
        self,
        type_: duckdb_logical_type,
    ) -> idx_t:
        """
        Retrieves the array size of the given array type.
        """
        return self._duckdb_array_type_array_size(type_)

    def duckdb_map_type_key_type(
        self,
        type_: duckdb_logical_type,
    ) -> duckdb_logical_type:
        """
        Retrieves the key type of the given map type.

        The result must be freed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_map_type_key_type(type_)

    def duckdb_map_type_value_type(
        self,
        type_: duckdb_logical_type,
    ) -> duckdb_logical_type:
        """
        Retrieves the value type of the given map type.

        The result must be freed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_map_type_value_type(type_)

    def duckdb_struct_type_child_count(
        self,
        type_: duckdb_logical_type,
    ) -> idx_t:
        """
        Returns the number of children of a struct type.
        """
        return self._duckdb_struct_type_child_count(type_)

    def duckdb_struct_type_child_name(
        self,
        type_: duckdb_logical_type,
        index: idx_t,
    ) -> Pointer[c_char, MutUntrackedOrigin]:
        """
        Retrieves the name of the struct child.

        The result must be freed with `duckdb_free`.
        """
        return self._duckdb_struct_type_child_name(type_, index)

    def duckdb_struct_type_child_type(
        self,
        type_: duckdb_logical_type,
        index: idx_t,
    ) -> duckdb_logical_type:
        """
        Retrieves the child type of the given struct type at the specified index.

        The result must be freed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_struct_type_child_type(type_, index)

    def duckdb_union_type_member_count(
        self,
        type_: duckdb_logical_type,
    ) -> idx_t:
        """
        Returns the number of members that the union type has.
        """
        return self._duckdb_union_type_member_count(type_)

    def duckdb_union_type_member_name(
        self,
        type_: duckdb_logical_type,
        index: idx_t,
    ) -> Pointer[c_char, MutUntrackedOrigin]:
        """
        Retrieves the name of the union member.

        The result must be freed with `duckdb_free`.
        """
        return self._duckdb_union_type_member_name(type_, index)

    def duckdb_union_type_member_type(
        self,
        type_: duckdb_logical_type,
        index: idx_t,
    ) -> duckdb_logical_type:
        """
        Retrieves the child type of the given union member at the specified index.

        The result must be freed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_union_type_member_type(type_, index)

    def duckdb_destroy_logical_type[type__origin: ImmOrigin](
        self,
        type_: Pointer[duckdb_logical_type, type__origin],
    ) -> NoneType:
        """
        Destroys the logical type and de-allocates all memory allocated for that type.
        """
        return self._duckdb_destroy_logical_type(type_.as_unsafe_any_origin())

    def duckdb_register_logical_type(
        self,
        con: duckdb_connection,
        type_: duckdb_logical_type,
        info: duckdb_create_type_info,
    ) -> duckdb_state:
        """
        Registers a custom type within the given connection.
        The type must have an alias.
        """
        return self._duckdb_register_logical_type(con, type_, info)


    # ===--------------------------------------------------------------------===#
    # Data Chunk Interface
    # ===--------------------------------------------------------------------===#

    def duckdb_create_data_chunk[types_origin: ImmOrigin](
        self,
        types: Pointer[duckdb_logical_type, types_origin],
        column_count: idx_t,
    ) -> duckdb_data_chunk:
        """
        Creates an empty data chunk with the specified column types.
        The result must be destroyed with `duckdb_destroy_data_chunk`.
        """
        return self._duckdb_create_data_chunk(types.as_unsafe_any_origin(), column_count)

    def duckdb_destroy_data_chunk[chunk_origin: ImmOrigin](
        self,
        chunk: Pointer[duckdb_data_chunk, chunk_origin],
    ) -> NoneType:
        """
        Destroys the data chunk and de-allocates all memory allocated for that chunk.
        """
        return self._duckdb_destroy_data_chunk(chunk.as_unsafe_any_origin())

    def duckdb_data_chunk_reset(
        self,
        chunk: duckdb_data_chunk,
    ) -> NoneType:
        """
        Resets a data chunk, clearing the validity masks and setting the cardinality of the data chunk to 0.
        After calling this method, you must call `duckdb_vector_get_validity` and `duckdb_vector_get_data` to obtain current
        data and validity pointers.
        """
        return self._duckdb_data_chunk_reset(chunk)

    def duckdb_data_chunk_get_column_count(
        self,
        chunk: duckdb_data_chunk,
    ) -> idx_t:
        """
        Retrieves the number of columns in a data chunk.
        """
        return self._duckdb_data_chunk_get_column_count(chunk)

    def duckdb_data_chunk_get_vector(
        self,
        chunk: duckdb_data_chunk,
        col_idx: idx_t,
    ) -> duckdb_vector:
        """
        Retrieves the vector at the specified column index in the data chunk.

        The pointer to the vector is valid for as long as the chunk is alive.
        It does NOT need to be destroyed.
        """
        return self._duckdb_data_chunk_get_vector(chunk, col_idx)

    def duckdb_data_chunk_get_size(
        self,
        chunk: duckdb_data_chunk,
    ) -> idx_t:
        """
        Retrieves the current number of tuples in a data chunk.
        """
        return self._duckdb_data_chunk_get_size(chunk)

    def duckdb_data_chunk_set_size(
        self,
        chunk: duckdb_data_chunk,
        size: idx_t,
    ) -> NoneType:
        """
        Sets the current number of tuples in a data chunk.
        """
        return self._duckdb_data_chunk_set_size(chunk, size)


    # ===--------------------------------------------------------------------===#
    # Vector Interface
    # ===--------------------------------------------------------------------===#

    def duckdb_create_vector(
        self,
        type_: duckdb_logical_type,
        capacity: idx_t,
    ) -> duckdb_vector:
        """
        Creates a flat vector. Must be destroyed with `duckdb_destroy_vector`.
        """
        return self._duckdb_create_vector(type_, capacity)

    def duckdb_destroy_vector[vector_origin: ImmOrigin](
        self,
        vector: Pointer[duckdb_vector, vector_origin],
    ) -> NoneType:
        """
        Destroys the vector and de-allocates its memory.
        """
        return self._duckdb_destroy_vector(vector.as_unsafe_any_origin())

    def duckdb_vector_get_column_type(
        self,
        vector: duckdb_vector,
    ) -> duckdb_logical_type:
        """
        Retrieves the column type of the specified vector.

        The result must be destroyed with `duckdb_destroy_logical_type`.
        """
        return self._duckdb_vector_get_column_type(vector)

    def duckdb_vector_get_data(
        self,
        vector: duckdb_vector,
    ) -> Pointer[NoneType, MutUntrackedOrigin]:
        """
        Retrieves the data pointer of the vector.

        The data pointer can be used to read or write values from the vector.
        How to read or write values depends on the type of the vector.
        """
        return self._duckdb_vector_get_data(vector)

    def duckdb_vector_get_validity(
        self,
        vector: duckdb_vector,
    ) -> Pointer[UInt64, MutUntrackedOrigin]:
        """
        Retrieves the validity mask pointer of the specified vector.

        If all values are valid, this function MIGHT return NULL!

        The validity mask is a bitset that signifies null-ness within the data chunk.
        It is a series of uint64_t values, where each uint64_t value contains validity for 64 tuples.
        The bit is set to 1 if the value is valid (i.e. not NULL) or 0 if the value is invalid (i.e. NULL).

        Validity of a specific value can be obtained like this:

        idx_t entry_idx = row_idx / 64;
        idx_t idx_in_entry = row_idx % 64;
        bool is_valid = validity_mask[entry_idx] & (1 << idx_in_entry);

        Alternatively, the (slower) duckdb_validity_row_is_valid function can be used.
        """
        return self._duckdb_vector_get_validity(vector)

    def duckdb_vector_ensure_validity_writable(
        self,
        vector: duckdb_vector,
    ) -> NoneType:
        """
        Ensures the validity mask is writable by allocating it.

        After this function is called, `duckdb_vector_get_validity` will ALWAYS return non-NULL.
        This allows NULL values to be written to the vector, regardless of whether a validity mask was present before.
        """
        return self._duckdb_vector_ensure_validity_writable(vector)

    def duckdb_vector_assign_string_element[str_origin: ImmOrigin](
        self,
        vector: duckdb_vector,
        index: idx_t,
        str: Pointer[c_char, str_origin],
    ) -> NoneType:
        """
        Assigns a string element in the vector at the specified location. For VARCHAR vectors, the input is validated as UTF-8; if invalid, a NULL value is assigned at that index.

        Superseded by `duckdb_unsafe_vector_assign_string_element_len`, optionally combined with `duckdb_valid_utf8_check`.
        """
        return self._duckdb_vector_assign_string_element(vector, index, str.as_unsafe_any_origin())

    def duckdb_vector_assign_string_element_len[str_origin: ImmOrigin](
        self,
        vector: duckdb_vector,
        index: idx_t,
        str: Pointer[c_char, str_origin],
        str_len: idx_t,
    ) -> NoneType:
        """
        Assigns a string element in the vector at the specified location. For VARCHAR vectors, the input is validated as UTF-8; if invalid, a NULL value is assigned at that index. For BLOB vectors, no validation is performed.

        Superseded by `duckdb_unsafe_vector_assign_string_element_len`, optionally combined with `duckdb_valid_utf8_check`.
        """
        return self._duckdb_vector_assign_string_element_len(vector, index, str.as_unsafe_any_origin(), str_len)

    def duckdb_unsafe_vector_assign_string_element_len[str_origin: ImmOrigin](
        self,
        vector: duckdb_vector,
        index: idx_t,
        str: Pointer[c_char, str_origin],
        str_len: idx_t,
    ) -> NoneType:
        """
        Assigns a string element in the vector at the specified location without UTF-8 validation. The caller is responsible for ensuring the input is valid UTF-8. Use `duckdb_valid_utf8_check` to validate strings before calling this function if needed. If the input is known to be valid UTF-8, this function can be called directly for better performance, avoiding the overhead of redundant validation.
        """
        return self._duckdb_unsafe_vector_assign_string_element_len(vector, index, str.as_unsafe_any_origin(), str_len)

    def duckdb_list_vector_get_child(
        self,
        vector: duckdb_vector,
    ) -> duckdb_vector:
        """
        Retrieves the child vector of a list vector.

        The resulting vector is valid as long as the parent vector is valid.
        """
        return self._duckdb_list_vector_get_child(vector)

    def duckdb_list_vector_get_size(
        self,
        vector: duckdb_vector,
    ) -> idx_t:
        """
        Returns the size of the child vector of the list.
        """
        return self._duckdb_list_vector_get_size(vector)

    def duckdb_list_vector_set_size(
        self,
        vector: duckdb_vector,
        size: idx_t,
    ) -> duckdb_state:
        """
        Sets the size of the underlying child-vector of a list vector.
        Note that this does NOT reserve the memory in the child buffer,
        and that it is possible to set a size exceeding the capacity.
        To set the capacity, use `duckdb_list_vector_reserve`.
        """
        return self._duckdb_list_vector_set_size(vector, size)

    def duckdb_list_vector_reserve(
        self,
        vector: duckdb_vector,
        required_capacity: idx_t,
    ) -> duckdb_state:
        """
        Sets the capacity of the underlying child-vector of a list vector.
        We increment to the next power of two, based on the required capacity.
        Thus, the capacity might not match the size of the list (capacity >= size),
        which is set via `duckdb_list_vector_set_size`.
        """
        return self._duckdb_list_vector_reserve(vector, required_capacity)

    def duckdb_struct_vector_get_child(
        self,
        vector: duckdb_vector,
        index: idx_t,
    ) -> duckdb_vector:
        """
        Retrieves the child vector of a struct vector.
        The resulting vector is valid as long as the parent vector is valid.
        """
        return self._duckdb_struct_vector_get_child(vector, index)

    def duckdb_array_vector_get_child(
        self,
        vector: duckdb_vector,
    ) -> duckdb_vector:
        """
        Retrieves the child vector of an array vector.
        The resulting vector is valid as long as the parent vector is valid.
        The resulting vector has the size of the parent vector multiplied by the array size.
        """
        return self._duckdb_array_vector_get_child(vector)

    def duckdb_slice_vector(
        self,
        vector: duckdb_vector,
        sel: duckdb_selection_vector,
        len: idx_t,
    ) -> NoneType:
        """
        Slice a vector with a selection vector.
        The length of the selection vector must be less than or equal to the length of the vector.
        Turns the vector into a dictionary vector.
        """
        return self._duckdb_slice_vector(vector, sel, len)

    def duckdb_vector_copy_sel(
        self,
        src: duckdb_vector,
        dst: duckdb_vector,
        sel: duckdb_selection_vector,
        src_count: idx_t,
        src_offset: idx_t,
        dst_offset: idx_t,
    ) -> NoneType:
        """
        Copy the src vector to the dst with a selection vector that identifies which indices to copy.
        """
        return self._duckdb_vector_copy_sel(src, dst, sel, src_count, src_offset, dst_offset)

    def duckdb_vector_reference_value(
        self,
        vector: duckdb_vector,
        value: duckdb_value,
    ) -> NoneType:
        """
        Copies the value from `value` to `vector`.
        """
        return self._duckdb_vector_reference_value(vector, value)

    def duckdb_vector_reference_vector(
        self,
        to_vector: duckdb_vector,
        from_vector: duckdb_vector,
    ) -> NoneType:
        """
        Changes `to_vector` to reference `from_vector. After, the vectors share ownership of the data.
        """
        return self._duckdb_vector_reference_vector(to_vector, from_vector)


    # ===--------------------------------------------------------------------===#
    # Validity Mask Functions
    # ===--------------------------------------------------------------------===#

    def duckdb_validity_row_is_valid(
        self,
        validity: Pointer[UInt64, MutUntrackedOrigin],
        row: idx_t,
    ) -> Bool:
        """
        Returns whether or not a row is valid (i.e. not NULL) in the given validity mask.
        """
        return self._duckdb_validity_row_is_valid(validity, row)

    def duckdb_validity_set_row_validity(
        self,
        validity: Pointer[UInt64, MutUntrackedOrigin],
        row: idx_t,
        valid: Bool,
    ) -> NoneType:
        """
        In a validity mask, sets a specific row to either valid or invalid.

        Note that `duckdb_vector_ensure_validity_writable` should be called before calling `duckdb_vector_get_validity`,
        to ensure that there is a validity mask to write to.
        """
        return self._duckdb_validity_set_row_validity(validity, row, valid)

    def duckdb_validity_set_row_invalid(
        self,
        validity: Pointer[UInt64, MutUntrackedOrigin],
        row: idx_t,
    ) -> NoneType:
        """
        In a validity mask, sets a specific row to invalid.

        Equivalent to `duckdb_validity_set_row_validity` with valid set to false.
        """
        return self._duckdb_validity_set_row_invalid(validity, row)

    def duckdb_validity_set_row_valid(
        self,
        validity: Pointer[UInt64, MutUntrackedOrigin],
        row: idx_t,
    ) -> NoneType:
        """
        In a validity mask, sets a specific row to valid.

        Equivalent to `duckdb_validity_set_row_validity` with valid set to true.
        """
        return self._duckdb_validity_set_row_valid(validity, row)


    # ===--------------------------------------------------------------------===#
    # Scalar Functions
    # ===--------------------------------------------------------------------===#

    def duckdb_create_scalar_function(
        self,
    ) -> duckdb_scalar_function:
        """
        Creates a new empty scalar function.

        The return value must be destroyed with `duckdb_destroy_scalar_function`.
        """
        return self._duckdb_create_scalar_function()

    def duckdb_destroy_scalar_function[scalar_function_origin: ImmOrigin](
        self,
        scalar_function: Pointer[duckdb_scalar_function, scalar_function_origin],
    ) -> NoneType:
        """
        Destroys the given scalar function object.
        """
        return self._duckdb_destroy_scalar_function(scalar_function.as_unsafe_any_origin())

    def duckdb_scalar_function_set_name[name_origin: ImmOrigin](
        self,
        scalar_function: duckdb_scalar_function,
        name: Pointer[c_char, name_origin],
    ) -> NoneType:
        """
        Sets the name of the given scalar function.
        """
        return self._duckdb_scalar_function_set_name(scalar_function, name.as_unsafe_any_origin())

    def duckdb_scalar_function_set_varargs(
        self,
        scalar_function: duckdb_scalar_function,
        type_: duckdb_logical_type,
    ) -> NoneType:
        """
        Sets the parameters of the given scalar function to varargs. Does not require adding parameters with
        duckdb_scalar_function_add_parameter.
        """
        return self._duckdb_scalar_function_set_varargs(scalar_function, type_)

    def duckdb_scalar_function_set_special_handling(
        self,
        scalar_function: duckdb_scalar_function,
    ) -> NoneType:
        """
        Sets the scalar function's null-handling behavior to special.
        """
        return self._duckdb_scalar_function_set_special_handling(scalar_function)

    def duckdb_scalar_function_set_volatile(
        self,
        scalar_function: duckdb_scalar_function,
    ) -> NoneType:
        """
        Sets the Function Stability of the scalar function to VOLATILE, indicating the function should be re-run for every row.
        This limits optimization that can be performed for the function.
        """
        return self._duckdb_scalar_function_set_volatile(scalar_function)

    def duckdb_scalar_function_add_parameter(
        self,
        scalar_function: duckdb_scalar_function,
        type_: duckdb_logical_type,
    ) -> NoneType:
        """
        Adds a parameter to the scalar function.
        """
        return self._duckdb_scalar_function_add_parameter(scalar_function, type_)

    def duckdb_scalar_function_set_return_type(
        self,
        scalar_function: duckdb_scalar_function,
        type_: duckdb_logical_type,
    ) -> NoneType:
        """
        Sets the return type of the scalar function.
        """
        return self._duckdb_scalar_function_set_return_type(scalar_function, type_)

    def duckdb_scalar_function_set_extra_info[extra_info_origin: MutOrigin](
        self,
        scalar_function: duckdb_scalar_function,
        extra_info: Pointer[NoneType, extra_info_origin],
        destroy: def(Pointer[NoneType, MutAnyOrigin]) thin abi("C") -> NoneType,
    ) -> NoneType:
        """
        Assigns extra information to the scalar function that can be fetched during binding, etc.
        """
        return self._duckdb_scalar_function_set_extra_info(scalar_function, extra_info.as_unsafe_any_origin(), destroy)

    def duckdb_scalar_function_set_bind(
        self,
        scalar_function: duckdb_scalar_function,
        bind: def(duckdb_bind_info) thin abi("C") -> NoneType,
    ) -> NoneType:
        """
        Sets the (optional) bind function of the scalar function.
        """
        return self._duckdb_scalar_function_set_bind(scalar_function, bind)

    def duckdb_scalar_function_set_bind_data[bind_data_origin: MutOrigin](
        self,
        info: duckdb_bind_info,
        bind_data: Pointer[NoneType, bind_data_origin],
        destroy: def(Pointer[NoneType, MutAnyOrigin]) thin abi("C") -> NoneType,
    ) -> NoneType:
        """
        Sets the user-provided bind data in the bind object of the scalar function.
        The bind data object can be retrieved again during execution.
        In most case, you also need to set the copy-callback of your bind data via duckdb_scalar_function_set_bind_data_copy.
        """
        return self._duckdb_scalar_function_set_bind_data(info, bind_data.as_unsafe_any_origin(), destroy)

    def duckdb_scalar_function_set_bind_data_copy(
        self,
        info: duckdb_bind_info,
        copy: def(Pointer[NoneType, MutAnyOrigin]) thin abi("C") -> Pointer[NoneType, MutAnyOrigin],
    ) -> NoneType:
        """
        Sets the copy-callback for the user-provided bind data in the bind object of the scalar function.
        """
        return self._duckdb_scalar_function_set_bind_data_copy(info, copy)

    def duckdb_scalar_function_bind_set_error[error_origin: ImmOrigin](
        self,
        info: duckdb_bind_info,
        error: Pointer[c_char, error_origin],
    ) -> NoneType:
        """
        Report that an error has occurred while calling bind on a scalar function.
        """
        return self._duckdb_scalar_function_bind_set_error(info, error.as_unsafe_any_origin())

    def duckdb_scalar_function_set_function(
        self,
        scalar_function: duckdb_scalar_function,
        function_: def(duckdb_function_info, duckdb_data_chunk, duckdb_vector) thin abi("C") -> NoneType,
    ) -> NoneType:
        """
        Sets the main function of the scalar function.
        """
        return self._duckdb_scalar_function_set_function(scalar_function, function_)

    def duckdb_register_scalar_function(
        self,
        con: duckdb_connection,
        scalar_function: duckdb_scalar_function,
    ) -> duckdb_state:
        """
        Register the scalar function object within the given connection.

        The function requires at least a name, a function and a return type.

        If the function is incomplete or a function with this name already exists DuckDBError is returned.
        """
        return self._duckdb_register_scalar_function(con, scalar_function)

    def duckdb_scalar_function_get_extra_info(
        self,
        info: duckdb_function_info,
    ) -> Pointer[NoneType, MutUntrackedOrigin]:
        """
        Retrieves the extra info of the function as set in `duckdb_scalar_function_set_extra_info`.
        """
        return self._duckdb_scalar_function_get_extra_info(info)

    def duckdb_scalar_function_bind_get_extra_info(
        self,
        info: duckdb_bind_info,
    ) -> Pointer[NoneType, MutUntrackedOrigin]:
        """
        Retrieves the extra info of the function as set in the bind info.
        """
        return self._duckdb_scalar_function_bind_get_extra_info(info)

    def duckdb_scalar_function_get_bind_data(
        self,
        info: duckdb_function_info,
    ) -> Pointer[NoneType, MutUntrackedOrigin]:
        """
        Gets the scalar function's bind data set by `duckdb_scalar_function_set_bind_data`.
        Note that the bind data is read-only.
