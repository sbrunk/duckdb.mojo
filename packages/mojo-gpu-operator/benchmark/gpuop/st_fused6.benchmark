# name: benchmark/gpuop/st_fused6.benchmark
# description: GPU stats fused 6-stat (one launch)
# group: [gpuop]

cache gpuop_decimal.duckdb

load
CREATE TABLE gpuop_t AS SELECT
  ((i % 1000000) + 1)::DECIMAL(15,2)    AS price,
  ((i % 50) + 1)::DECIMAL(15,2)         AS qty,
  ((i % 100) * 0.01)::DECIMAL(15,4)     AS disc,
  chr((65 + (i % 4))::INTEGER)          AS grp
FROM range(50000000) tbl(i);

run
SELECT regr_slope(price,qty), corr(price,qty), stddev_pop(price), var_pop(qty), covar_pop(price,qty), regr_r2(price,qty) FROM gpuop_t;
